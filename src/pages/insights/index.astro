---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExtrasArtwork from '../../components/ExtrasArtwork.astro';
import article from '../../data/softwareValueArticle.json';
import { writingFeatured, writing } from '../../data/siteContent';
import '../../styles/services.css';
import '../../styles/editorial-pages.css';
const selected = [writingFeatured, ...writing.filter(item => ['When Capital Becomes Compute','Deploying Fast, Thinking Slow'].includes(item.title))];
---
<BaseLayout title="Insights | Cloud & Capital" description="Clear explanations of money, markets, technology costs, and the decisions behind the numbers. Articles by Diana Molski.">
  <main id="main-content" class="offer-page editorial-page insights-page">
    <section class="offer-shell insights-intro"><p class="offer-eyebrow">Insights · Diana Molski</p><h1>A good question.<br /><em>A clearer answer.</em></h1><p class="editorial-lede">Money, markets, and technology. A closer look at what’s driving the story.</p></section>
    <section class="offer-shell featured-insight" aria-labelledby="software-title"><div class="featured-art"><ExtrasArtwork kind="renewal" /></div><div><p class="offer-eyebrow">Business costs · Featured read</p><h2 id="software-title"><a href="/insights/is-this-software-worth-it">{article.title}</a></h2><p>{article.description}</p><a class="quiet-link" href="/insights/is-this-software-worth-it">Read the article →</a></div></section>
    <section class="offer-shell editorial-section"><div class="editorial-heading"><div><p class="offer-eyebrow">From the archive</p><h2>Follow the money.</h2></div><p>Writing on cloud economics, AI infrastructure, and the decisions that shape the bill.</p></div><div class="reading-grid">{selected.map(item=><a class="reading-card" href={item.href} target="_blank" rel="noopener noreferrer"><img src={item.archiveImage} alt={item.archiveImageAlt} width="800" height="500" loading="lazy"/><div><p class="offer-eyebrow">{item.topic}</p><h3>{item.title}</h3><p>{item.description}</p><span class="quiet-link">Read on Substack ↗</span></div></a>)}</div></section>
    <section class="mimosas-band"><div class="offer-shell mimosas-feature"><img src="/images/writing/markets-mimosas-hero.png" alt="A mimosa overlooking the coast at sunset" width="2048" height="1152" loading="lazy"/><div><p class="offer-eyebrow">Markets &amp; Mimosas</p><h2>Pour a glass.<br /><em>Let’s talk markets.</em></h2><p>From market headlines to the price of AI, I follow the money and ask a few questions.</p><a class="offer-button" href="https://cloudandcapital.substack.com" target="_blank" rel="noopener noreferrer">Read Markets &amp; Mimosas ↗</a></div></div></section>
  </main>
</BaseLayout>
