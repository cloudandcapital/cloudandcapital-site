<div class="decision-desk" data-decision-desk aria-label="Illustrative examples of turning numbers into a useful decision">
  <div class="decision-topline">
    <span><i aria-hidden="true"></i>C&amp;C Decision Desk</span>
    <span class="decision-meta">Examples <button type="button" data-decision-pause aria-pressed="false">Pause</button></span>
  </div>

  <div class="decision-tabs" role="tablist" aria-label="Explore the Cloud and Capital focus areas">
    <button id="decision-tab-invest" class="is-active" type="button" role="tab" aria-selected="true" aria-controls="decision-panel-invest" data-decision-tab="0">Invest</button>
    <button id="decision-tab-spend" type="button" role="tab" aria-selected="false" aria-controls="decision-panel-spend" data-decision-tab="1" tabindex="-1">Spend</button>
    <button id="decision-tab-build" type="button" role="tab" aria-selected="false" aria-controls="decision-panel-build" data-decision-tab="2" tabindex="-1">Build</button>
  </div>

  <div class="decision-stage">
    <section id="decision-panel-invest" class="decision-panel is-active" role="tabpanel" aria-labelledby="decision-tab-invest" data-decision-panel="0">
      <div class="decision-sheet">
        <div class="sheet-heading">
          <span>The numbers</span>
          <span>Illustrative market read</span>
        </div>
        <div class="metric-grid">
          <div class="metric is-driver">
            <span>10 year yield</span>
            <strong>+18 <small>bps</small></strong>
            <em>Rising</em>
          </div>
          <div class="metric">
            <span>Growth stocks</span>
            <strong>−2.4<small>%</small></strong>
            <em>Falling</em>
          </div>
          <div class="metric">
            <span>Credit spreads</span>
            <strong class="metric-word">Steady</strong>
            <em>No stress signal</em>
          </div>
        </div>
        <div class="decision-output">
          <span class="output-label">What it means</span>
          <strong>Rates are driving the move, not broad panic.</strong>
        </div>
      </div>
    </section>

    <section id="decision-panel-spend" class="decision-panel" role="tabpanel" aria-labelledby="decision-tab-spend" data-decision-panel="1" hidden>
      <div class="decision-sheet">
        <div class="sheet-heading">
          <span>The numbers</span>
          <span>Illustrative business review</span>
        </div>
        <div class="metric-grid">
          <div class="metric">
            <span>Software tools</span>
            <strong>27</strong>
            <em>Across the business</em>
          </div>
          <div class="metric is-driver">
            <span>Barely used</span>
            <strong>6</strong>
            <em>Possible waste</em>
          </div>
          <div class="metric">
            <span>Next renewal</span>
            <strong>14 <small>days</small></strong>
            <em>Time to review</em>
          </div>
        </div>
        <div class="decision-output">
          <span class="output-label">What it means</span>
          <strong>Review the licenses before the contract renews.</strong>
        </div>
      </div>
    </section>

    <section id="decision-panel-build" class="decision-panel" role="tabpanel" aria-labelledby="decision-tab-build" data-decision-panel="2" hidden>
      <div class="decision-sheet">
        <div class="sheet-heading">
          <span>The numbers</span>
          <span>AI Cost Lens example</span>
        </div>
        <div class="metric-grid">
          <div class="metric">
            <span>Model usage</span>
            <strong><small>$</small>35k</strong>
            <em>31% of total</em>
          </div>
          <div class="metric">
            <span>Infrastructure</span>
            <strong><small>$</small>25k</strong>
            <em>22% of total</em>
          </div>
          <div class="metric is-driver">
            <span>Human review</span>
            <strong><small>$</small>52.8k</strong>
            <em>47% of total</em>
          </div>
        </div>
        <div class="decision-output decision-output-total">
          <div>
            <span class="output-label">Total cost</span>
            <b>$112.8k</b>
          </div>
          <strong>The cheaper model is not the cheaper result.</strong>
        </div>
      </div>
    </section>
  </div>

  <div class="decision-footer" aria-hidden="true">
    <span>Numbers</span><b>→</b><span>Context</span><b>→</b><span>Strategy</span>
  </div>
</div>

<script>
  document.querySelectorAll('[data-decision-desk]').forEach((desk) => {
    const tabs = Array.from(desk.querySelectorAll('[data-decision-tab]'));
    const panels = Array.from(desk.querySelectorAll('[data-decision-panel]'));
    const pauseButton = desk.querySelector('[data-decision-pause]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = 0;
    let rotation;
    let userPaused = reduceMotion;

    if (userPaused && pauseButton) {
      pauseButton.setAttribute('aria-pressed', 'true');
      pauseButton.textContent = 'Play';
    }

    const activate = (index) => {
      activeIndex = index;
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.setAttribute('tabindex', active ? '0' : '-1');
      });
      panels.forEach((panel, panelIndex) => {
        const active = panelIndex === index;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);
      });
    };

    const stopRotation = () => window.clearInterval(rotation);
    const startRotation = () => {
      stopRotation();
      if (!userPaused) rotation = window.setInterval(() => activate((activeIndex + 1) % panels.length), 6800);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        activate(index);
        startRotation();
      });
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const direction = event.key === 'ArrowRight' ? 1 : -1;
        const nextIndex = (index + direction + tabs.length) % tabs.length;
        activate(nextIndex);
        tabs[nextIndex].focus();
        startRotation();
      });
    });

    desk.addEventListener('mouseenter', stopRotation);
    desk.addEventListener('mouseleave', startRotation);
    desk.addEventListener('focusin', stopRotation);
    desk.addEventListener('focusout', startRotation);
    pauseButton?.addEventListener('click', () => {
      userPaused = !userPaused;
      pauseButton.setAttribute('aria-pressed', String(userPaused));
      pauseButton.textContent = userPaused ? 'Play' : 'Pause';
      userPaused ? stopRotation() : startRotation();
    });
    startRotation();
  });
</script>

