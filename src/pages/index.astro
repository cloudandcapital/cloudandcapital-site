}

/* Featured card: subtle top accent, soft shadow */
.writing-featured {
  box-shadow: 0 8px 30px rgba(0,0,0,0.04) !important;
  border-top: 1px solid rgba(90,126,94,0.35) !important;
}
.writing-featured:hover {
  transform: translateY(-2px) !important;
  box-shadow: 0 8px 24px rgba(25,23,20,.11), 0 2px 6px rgba(25,23,20,.06) !important;
