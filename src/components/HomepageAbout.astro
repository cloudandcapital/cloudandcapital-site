---
import '@fontsource/caveat/latin-400.css';
import { about } from '../data/siteContent';
import ActionLabel from './ActionLabel.astro';
import FlowText from './FlowText.astro';
import ClaudePartnerBadge from './ClaudePartnerBadge.astro';
---
<section class="diana-about" id="about" aria-labelledby="about-title">
  <div class="diana-shell">
    <div class="diana-grid">
      <header class="diana-intro" data-reveal>
        <p class="diana-eyebrow">About</p>
        <h2 id="about-title">{about.heading}</h2>
      </header>

      <div class="diana-visual" data-reveal>
        <div class="diana-photo-cluster">
          <div class="diana-portrait">
            <div class="diana-portrait-window">
              <img src="/images/diana-molski-portrait.png" alt="Diana Molski" width="820" height="806" loading="lazy" decoding="async" />
            </div>
          </div>
          <figure class="diana-polaroid diana-myszka">
            <div class="diana-photo-window">
              <img src="/images/myszka-about.webp" alt="Myszka looking over her shoulder while curled up on a bed" width="901" height="1600" loading="lazy" decoding="async" />
              <img class="diana-natural-fur" src="/images/myszka-about.webp" alt="" aria-hidden="true" width="901" height="1600" loading="lazy" decoding="async" />
            </div>
            <figcaption>Myszka</figcaption>
          </figure>
          <figure class="diana-polaroid diana-beach">
            <div class="diana-photo-window">
              <img src="/images/south-bay-about.webp" alt="Diana’s photo of the South Bay coastline, with sand, blue ocean, and the Palos Verdes headland" width="901" height="1600" loading="lazy" decoding="async" />
            </div>
            <figcaption>South Bay</figcaption>
          </figure>
        </div>
      </div>

      <div class="diana-story" data-reveal>
        <div class="diana-biography">
          {about.biography.map(paragraph => <p><FlowText text={paragraph} /></p>)}
        </div>
        <aside class="diana-community" aria-labelledby="diana-community-title">
          <div class="diana-event-image">
            <img src="/images/event-poster-vol01.png" alt="Using AI to Put the Ops in FinOps, hosted by Diana Molski" width="1200" height="1200" loading="lazy" decoding="async" />
          </div>
          <div class="diana-event-copy">
            <p class="diana-event-date">April 9, 2026 · Hawthorne</p>
            <h3 id="diana-community-title">Hosting FinOps Weekly LA</h3>
            <p><FlowText text="I organized and hosted LA’s first FinOps Weekly meetup with SmartClouds, featuring speakers from Ulta Beauty and Wiv.ai." /></p>
          </div>
        </aside>
      </div>
    </div>

    <div class="diana-credentials" data-reveal>
      <p class="diana-eyebrow">Credentials &amp; contributions</p>
      <ClaudePartnerBadge dark centered />
      <dl aria-label="Professional credentials">
        {about.credentials.map(credential => (
          <div class="diana-credential"><dt>{credential.category}</dt><dd>{credential.detail}</dd></div>
        ))}
        <div class="diana-credential">
          <dt>CONTRIBUTION</dt>
          <dd><a class="diana-contribution" href={about.recognitionUrl} target="_blank" rel="noopener noreferrer"><ActionLabel label={about.recognition} /></a></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .diana-about { padding: clamp(4.5rem, 7vw, 6.25rem) 0; background: #3d6055; color: #faf6ef; scroll-margin-top: 5rem; }
  .diana-shell { width: min(calc(100% - 4rem), 78rem); margin-inline: auto; }
  .diana-grid { display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); grid-template-areas: 'photos intro' 'photos story'; grid-template-rows: auto 1fr; column-gap: clamp(3rem, 6vw, 5.5rem); align-items: start; }
  .diana-intro { grid-area: intro; margin-bottom: 1.5rem; }
  .diana-eyebrow { margin: 0; color: #d1dfd6; font: 400 .61rem/1.5 'DM Mono', monospace; letter-spacing: .14em; text-transform: uppercase; }
  .diana-intro .diana-eyebrow { display: flex; align-items: center; gap: .75rem; }
  .diana-intro .diana-eyebrow::after { content: ''; flex: none; width: 2.7rem; height: 1px; background: currentColor; opacity: .42; }
  .diana-intro h2 { margin: .85rem 0 0; color: #faf6ef; font: 400 clamp(3.3rem, 5vw, 4.5rem)/1 'Cormorant Garamond', Georgia, serif; letter-spacing: -.035em; }
  .diana-visual { grid-area: photos; align-self: center; min-width: 0; }
  .diana-photo-cluster { position: relative; isolation: isolate; width: min(100%, 27rem); aspect-ratio: .59; margin-inline: auto; }
  .diana-portrait { position: absolute; z-index: 1; top: 1.5%; left: 17%; width: 72%; }
  .diana-portrait-window { overflow: hidden; aspect-ratio: 1; border-radius: 50%; box-shadow: 0 1px 2px #152d2759, 3px 9px 18px -7px #152d2773; }
  .diana-portrait-window img { display: block; width: 100%; height: 100%; object-fit: cover; transform: scale(1.012); }
  .diana-polaroid { --photo-tilt: -8deg; position: absolute; z-index: 2; box-sizing: border-box; width: 42%; margin: 0; padding: clamp(.5rem, 1vw, .7rem); border: 1px solid #fffefa; border-radius: 2px; background: #faf6ef; color: #2f2927; box-shadow: 1px 2px 0 #d9d1c4, 0 5px 8px -4px #142d2773, 3px 12px 20px -10px #122a258c; transform: rotate(var(--photo-tilt)); }
  .diana-myszka { --photo-warmth: .42; top: 47%; left: 3%; }
  .diana-beach { --photo-warmth: .42; --photo-tilt: 6deg; z-index: 3; top: 65%; right: 4%; }
  .diana-photo-window { position: relative; isolation: isolate; overflow: hidden; aspect-ratio: 1; background: #e7e4db; }
  .diana-photo-window::after { content: ''; position: absolute; inset: 0; background: #f2dca5; mix-blend-mode: multiply; opacity: .12; pointer-events: none; }
  .diana-beach .diana-photo-window::after { opacity: .08; }
  .diana-photo-window img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .diana-myszka .diana-photo-window img { object-position: 50% 42%; }
  .diana-myszka .diana-photo-window img, .diana-beach .diana-photo-window img { filter: sepia(var(--photo-warmth)) saturate(1.08) contrast(1.02) brightness(1.01); }
  .diana-myszka .diana-photo-window .diana-natural-fur { position: absolute; inset: 0; z-index: 1; filter: none; opacity: 1; mask-image: radial-gradient(ellipse 36% 27% at 45% 34%, #000 80%, transparent 100%), radial-gradient(ellipse 40% 31% at 41% 69%, #000 80%, transparent 100%); pointer-events: none; }
  .diana-beach .diana-photo-window img { object-position: 50% 35%; }
  .diana-polaroid figcaption { padding: .55rem .1rem .2rem; font: 400 clamp(1.4rem, 2.5vw, 1.85rem)/1.05 'Caveat', 'Segoe Print', 'Bradley Hand', cursive; font-synthesis: none; text-align: center; }
  .diana-story { grid-area: story; min-width: 0; }
  .diana-biography p { max-width: 64ch; margin: 1.05rem 0 0; color: #f3f0e9; font-size: .95rem; line-height: 1.75; text-wrap: pretty; }
  .diana-biography p:first-child { margin-top: 0; }
  .diana-community { display: grid; grid-template-columns: clamp(8.1rem, 11.7vw, 9.9rem) minmax(0, 1fr); align-items: start; gap: 1.2rem; margin-top: 1.8rem; padding-top: 1.6rem; border-top: 1px solid #f5eee92e; }
  .diana-event-image { display: block; border: 1px solid #f5eee966; border-radius: 6px; overflow: hidden; box-shadow: 0 8px 16px -8px #162e27b3; }
  .diana-event-image img { display: block; width: 100%; height: auto; }
  .diana-event-date { margin: 0; color: #d1dfd6; font: 400 .55rem/1.6 'DM Mono', monospace; letter-spacing: .035em; }
  .diana-event-copy h3 { margin: .4rem 0; color: #faf6ef; font: italic 400 clamp(1.6rem, 2.75vw, 1.75rem)/1.1 'Cormorant Garamond', Georgia, serif; text-wrap: balance; }
  .diana-event-copy > p:last-of-type { margin: .6rem 0 .35rem; color: #e8eee7; font-size: .82rem; line-height: 1.65; text-wrap: pretty; }
  .diana-credentials { margin-top: clamp(2.75rem, 5vw, 4rem); padding-top: 1.6rem; border-top: 1px solid #f5eee947; }
  .diana-credentials dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 3rem; margin: .8rem 0 0; }
  .diana-credential { display: grid; grid-template-columns: 7.7rem minmax(0, 1fr); align-items: baseline; gap: .75rem; padding: .8rem 0; border-bottom: 1px solid #f5eee926; }
  .diana-credential dt { color: #cbdad0; font: 400 .58rem/1.6 'DM Mono', monospace; letter-spacing: .05em; }
  .diana-credential dd { margin: 0; color: #edf1ea; font-size: .79rem; line-height: 1.6; text-wrap: balance; }
  .diana-contribution { display: inline-flex; max-width: 100%; min-height: 32px; align-items: center; color: #edf1ea; text-decoration: none; }
  .diana-about a:focus-visible { outline: 2px solid #f2c8c9; outline-offset: 5px; }
  @media (max-width: 1020px) and (min-width: 761px) {
    .diana-grid { grid-template-columns: minmax(0, .72fr) minmax(0, 1.28fr); column-gap: 2.5rem; }
    .diana-visual { align-self: start; margin-top: 2rem; }
    .diana-myszka { left: 1%; }
    .diana-beach { right: 1%; }
    .diana-photo-cluster { aspect-ratio: .56; }
    .diana-credential { grid-template-columns: 1fr; gap: .3rem; }
  }
  @media (max-width: 760px) {
    .diana-shell { width: min(calc(100% - 2.5rem), 40rem); }
    .diana-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'intro' 'photos' 'story'; grid-template-rows: auto auto auto; gap: 0; }
    .diana-intro { margin-bottom: 1.75rem; }
    .diana-intro h2 { font-size: clamp(3.15rem, 12vw, 4.25rem); }
    .diana-visual { width: min(100%, 25rem); margin-inline: auto; }
    .diana-photo-cluster { width: 94%; }
    .diana-story { margin-top: 2.25rem; }
    .diana-biography p { font-size: .95rem; }
    .diana-polaroid figcaption { font-size: clamp(1.4rem, 6vw, 1.85rem); }
    .diana-credentials dl { grid-template-columns: minmax(0, 1fr); }
    .diana-credential { grid-template-columns: 7.7rem minmax(0, 1fr); }
  }
  @media (max-width: 560px) {
    .diana-community { grid-template-columns: minmax(0, 1fr); gap: 1.2rem; }
    .diana-event-image { width: 9.9rem; margin-inline: auto; }
  }
  @media (max-width: 380px) {
    .diana-photo-cluster { aspect-ratio: .55; }
    .diana-credential { grid-template-columns: 1fr; gap: .3rem; }
  }
</style>
