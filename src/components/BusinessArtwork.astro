<div class="business-art" data-hero-inspect>
  <div class="hero-illustration" aria-hidden="true">
    <picture class="hero-static-scene">
      <source media="(prefers-reduced-motion: reduce)" srcset="/images/cloud-capital-hero-diamond-v5.webp" />
      <img src="/images/cloud-capital-hero-base.webp" alt="" width="1402" height="1122" fetchpriority="high" decoding="async" />
    </picture>
    <span class="hero-lens-motion">
      <img class="hero-lens-image" src="/images/cloud-capital-hero-magnifier.webp" alt="" width="1402" height="1122" fetchpriority="high" decoding="async" />
    </span>
  </div>
  <button class="art-motion-toggle" type="button" aria-label="Pause illustration animation" title="Pause animation" hidden>
    <svg class="art-motion-pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5 3v10M11 3v10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    <svg class="art-motion-play" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m5 3 8 5-8 5Z" fill="currentColor" /></svg>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero-inspect]').forEach((artwork) => {
    if (artwork.dataset.motionReady) return;
    artwork.dataset.motionReady = 'true';
    const toggle = artwork.querySelector<HTMLButtonElement>('.art-motion-toggle');
    if (!toggle) return;
    const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
    let inView = false;
    let paused = false;
    const update = () => {
      artwork.classList.toggle('is-in-view', inView && !document.hidden);
      artwork.classList.toggle('is-paused', paused);
      toggle.hidden = preference.matches;
      toggle.setAttribute('aria-label', paused ? 'Play illustration animation' : 'Pause illustration animation');
      toggle.title = paused ? 'Play animation' : 'Pause animation';
    };
    toggle.addEventListener('click', () => {
      paused = !paused;
      update();
    });
    preference.addEventListener('change', update);
    document.addEventListener('visibilitychange', update);
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        inView = entries.some((entry) => entry.isIntersecting);
        update();
      }, { threshold: .05 });
      observer.observe(artwork);
    } else {
      inView = true;
    }
    update();
  });
</script>

<style>
  .business-art { position: relative; width: calc(100% + 3.5rem); margin-inline: -1.75rem; }
  .hero-illustration { position: relative; }
  .hero-static-scene { display: block; }
  .business-art img { display: block; width: 100%; height: auto; }
  .hero-lens-motion { position: absolute; inset: 0; display: none; transform-origin: 46% 45%; pointer-events: none; }
  .business-art .hero-lens-image { transform: scale(.8); transform-origin: 46% 45%; }
  .art-motion-toggle { position: absolute; right: .5rem; bottom: .5rem; display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; padding: 0; border: 1px solid #78938266; border-radius: 50%; background: #faf6efdb; color: #35463c; cursor: pointer; }
  .art-motion-toggle[hidden] { display: none; }
  .art-motion-toggle svg { display: block; width: 14px; height: 14px; }
  .art-motion-toggle .art-motion-play { display: none; }
  .is-paused .art-motion-toggle .art-motion-pause { display: none; }
  .is-paused .art-motion-toggle .art-motion-play { display: block; }
  .art-motion-toggle:hover { background: #fffdf8; border-color: #789382; }
  .art-motion-toggle:focus-visible { outline: 2px solid #785752; outline-offset: 3px; }
  @keyframes hero-inspect {
    0%, 100% { transform: translate(0, 0) rotate(0); }
    25% { transform: translate(-2.5%, -1.25%) rotate(-.75deg); }
    50% { transform: translate(-4.5%, 1.25%) rotate(-1.25deg); }
    75% { transform: translate(1%, -1%) rotate(.75deg); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-lens-motion { display: block; animation: hero-inspect 18s cubic-bezier(.45, 0, .55, 1) infinite; animation-play-state: paused; }
    .business-art.is-in-view:not(.is-paused) .hero-lens-motion { animation-play-state: running; }
  }
  @media (min-width: 1021px) { .business-art { transform: scale(1.08); transform-origin: center; } }
  @media (max-width: 1020px) { .business-art { width: 100%; margin-inline: 0; } }
</style>
