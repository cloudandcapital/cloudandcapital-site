---
const widths = ['320', '375', '390', '414', '768', '1024'];
const width = widths.includes(Astro.url.searchParams.get('width') ?? '') ? Astro.url.searchParams.get('width') : '390';
---
<html lang="en"><head><meta charset="utf-8" /><meta name="robots" content="noindex,nofollow" /><title>Responsive review</title></head><body style="margin:0;background:#e8e8e8;font-family:system-ui"><header style="padding:10px;text-align:center">{widths.map(size => <a href={`?width=${size}`} style="margin-inline:8px">{size}px</a>)}</header><iframe src="/" title="Responsive homepage preview" style={`display:block;border:0;width:${width}px;height:840px;margin:0 auto;background:white;`}></iframe></body></html>
