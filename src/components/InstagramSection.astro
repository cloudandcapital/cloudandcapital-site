---
import ActionLabel from './ActionLabel.astro';
import InstagramIcon from './InstagramIcon.astro';
import { instagramPosts, instagramProfile } from '../data/instagram';
---
<section class="instagram-section" id="instagram" aria-labelledby="instagram-title">
  <div class="site-shell">
    <div class="instagram-intro" data-reveal>
      <div><p class="instagram-eyebrow">From Instagram</p><h2 id="instagram-title">A little money talk.<br />A little everyday life.</h2></div>
      <p>Money, markets, useful AI, and the occasional reminder to go outside.</p>
    </div>
    <div class="instagram-strip" data-instagram-strip>
      <div class="instagram-viewport" role="region" aria-label="Instagram posts. Scroll to browse." tabindex="0">
        <div class="instagram-track">
          {[false, true].map(copy => (
            <div class:list={['instagram-run', { 'instagram-run-copy': copy }]} aria-hidden={copy ? 'true' : undefined}>
              {instagramPosts.map(post => (
                <a class="instagram-post" href={post.href} target="_blank" rel="noopener noreferrer" tabindex={copy ? -1 : undefined} aria-label={`${post.alt} — open on Instagram`} data-analytics-event="cta_click" data-analytics-destination="instagram" data-analytics-source="homepage_instagram">
                  <img src={post.image} alt={copy ? '' : post.alt} width={post.width} height={post.height} loading="lazy" decoding="async" />
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="instagram-footer">
        <a class="instagram-follow" href={instagramProfile} target="_blank" rel="noopener noreferrer" data-analytics-event="cta_click" data-analytics-destination="instagram" data-analytics-source="homepage_instagram"><InstagramIcon /><ActionLabel label="Follow @cloud.and.capital" /></a>
        <button class="instagram-toggle" type="button" aria-label="Pause Instagram strip" aria-pressed="false" title="Pause Instagram strip" hidden>
          <svg class="pause-icon" viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M5 4h3v12H5zm7 0h3v12h-3z" /></svg>
          <svg class="play-icon" viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="m7 4 9 6-9 6z" /></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-instagram-strip]').forEach(strip => {
    const button = strip.querySelector<HTMLButtonElement>('.instagram-toggle');
    if (!button) return;

    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce), (hover: none), (pointer: coarse)');
    const syncMotion = () => {
      strip.toggleAttribute('data-motion-ready', !motionPreference.matches);
      button.hidden = motionPreference.matches;
    };
    syncMotion();
    motionPreference.addEventListener('change', syncMotion);

    button.addEventListener('click', () => {
      const paused = strip.toggleAttribute('data-paused');
      const label = `${paused ? 'Play' : 'Pause'} Instagram strip`;
      button.setAttribute('aria-pressed', String(paused));
      button.setAttribute('aria-label', label);
      button.title = label;
    });

    const syncVisibility = () => strip.toggleAttribute('data-document-hidden', document.hidden);
    syncVisibility();
    document.addEventListener('visibilitychange', syncVisibility);
    if ('IntersectionObserver' in window) {
      strip.setAttribute('data-out-of-view', '');
      new IntersectionObserver(entries => {
        strip.toggleAttribute('data-out-of-view', !entries.some(entry => entry.isIntersecting));
      }, { threshold: 0 }).observe(strip);
    }
  });
</script>

<style>
  .instagram-section { padding: clamp(3.5rem, 6vw, 5.5rem) 0; color: var(--theme-ink, #24211e); background: var(--theme-rose-panel, #f3e4de); border-top: 1px solid var(--theme-line, #dec9bf); scroll-margin-top: 5rem; }
  .instagram-intro { display: flex; justify-content: space-between; align-items: end; gap: 2rem; }
  .instagram-eyebrow { display: flex; align-items: center; gap: .75rem; color: var(--theme-rose, #89534f); font: 500 .65rem/1.5 'DM Mono', monospace; letter-spacing: .09em; text-transform: uppercase; }
  .instagram-eyebrow::after { content: ''; width: 2.7rem; height: 1px; background: currentColor; opacity: .7; }
  .instagram-intro h2 { margin-top: .9rem; font: 400 clamp(2.65rem, 4vw, 4.2rem)/1.02 'Cormorant Garamond', Georgia, serif; letter-spacing: -.035em; }
  .instagram-intro > p { max-width: 30ch; color: var(--theme-rose, #65534c); font-size: 1rem; line-height: 1.75; }
  .instagram-strip { --post-height: clamp(14.5rem, 18vw, 17rem); --post-gap: .9rem; margin-top: 2.5rem; }
  .instagram-viewport { overflow-x: auto; padding: 5px 0 12px; scroll-snap-type: x proximity; scrollbar-width: thin; scrollbar-color: #bb9991 transparent; }
  .instagram-track { display: flex; width: max-content; }
  .instagram-run { display: flex; flex: none; align-items: start; gap: var(--post-gap); padding-right: var(--post-gap); }
  .instagram-run-copy { display: none; }
  .instagram-post { flex: none; display: block; width: fit-content; padding: .3rem; border: 1px solid var(--theme-line, #dac2b8); border-radius: 12px; background: var(--cream); box-shadow: 0 6px 16px #7857520d; scroll-snap-align: start; }
  .instagram-post img { display: block; width: auto; max-width: none; height: var(--post-height); border-radius: 8px; }
  .instagram-footer { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 1.2rem; }
  .instagram-follow { display: inline-flex; align-items: center; gap: .8rem; color: var(--theme-rose, #89534f); text-decoration: none; }
  .instagram-follow :global(.action-label) { font-size: .875rem; }
  .instagram-follow :global(.action-arrow) { transition: transform 200ms ease; }
  .instagram-follow:is(:hover, :focus-visible) :global(.action-arrow) { transform: translateX(4px); }
  .instagram-toggle { display: grid; place-items: center; flex: none; width: 44px; height: 44px; padding: 0; border: 1px solid var(--theme-line, #cbaaa0); border-radius: 50%; background: transparent; color: var(--theme-rose, #89534f); cursor: pointer; }
  .instagram-toggle[hidden], .instagram-toggle .play-icon { display: none; }
  .instagram-toggle:hover { background: var(--theme-panel, #faf6f066); }
  .instagram-strip[data-paused] .pause-icon { display: none; }
  .instagram-strip[data-paused] .play-icon { display: block; }
  .instagram-post:focus-visible, .instagram-follow:focus-visible, .instagram-viewport:focus-visible, .instagram-toggle:focus-visible { outline: 2px solid var(--theme-line-strong, #89534f); outline-offset: 3px; }
  .instagram-post:hover { border-color: var(--theme-line-strong, #a5756b); }
  .instagram-strip[data-motion-ready] .instagram-viewport { overflow-x: hidden; }
  .instagram-strip[data-motion-ready] .instagram-run-copy { display: flex; }
  .instagram-strip[data-motion-ready] .instagram-track { animation: instagram-tape 76s linear infinite; }
  .instagram-strip:is(:hover, [data-paused], [data-out-of-view], [data-document-hidden]) .instagram-track { animation-play-state: paused; }
  /* Keyboard navigation returns to the original six links in a scrollable strip. */
  .instagram-strip .instagram-viewport:focus-within { overflow-x: auto; }
  .instagram-viewport:focus-within .instagram-track { animation: none; transform: none; }
  .instagram-viewport:focus-within .instagram-run-copy { display: none; }
  @keyframes instagram-tape { to { transform: translateX(-50%); } }
  @media (max-width: 760px) {
    .instagram-intro h2 { font-size: clamp(2.1rem, 10.75vw, 2.65rem); }
    .instagram-intro { display: block; }
    .instagram-intro > p { margin-top: 1.2rem; max-width: 40ch; }
    .instagram-strip { --post-gap: .7rem; margin-top: 2rem; }
    .instagram-footer { flex-wrap: wrap; }
    .instagram-follow { flex: none; }
    .instagram-follow :global(.action-label) { white-space: nowrap; }
    .instagram-toggle { margin-left: auto; }
  }
  @media (max-width: 360px) {
    .instagram-follow :global(.action-label) { font-size: .75rem; }
  }
  @media (prefers-reduced-motion: reduce), (hover: none), (pointer: coarse) {
    .instagram-strip[data-motion-ready] .instagram-viewport { overflow-x: auto; }
    .instagram-strip[data-motion-ready] .instagram-track { animation: none; }
    .instagram-strip[data-motion-ready] .instagram-run-copy, .instagram-toggle { display: none; }
    .instagram-follow :global(.action-arrow) { transition: none; transform: none; }
  }
</style>
