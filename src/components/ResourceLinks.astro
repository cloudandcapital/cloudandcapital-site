---
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import { resourceLinks, resourceHelpLinks } from '../data/resourceLinks.js';
import '../styles/resource-links.css';
---
<main id="main-content" class="resource-links">
  <a class="resource-wordmark" href="/">Cloud &amp; Capital<span>Turning numbers into strategy.</span></a>
  <header class="resource-links-intro">
    <p class="resource-links-kicker">A good place to start</p>
    <h1>A few <em>useful things.</em></h1>
    <p>Tools, writing, and a little help making sense of it all.</p>
  </header>
  <nav aria-label="Free resources and writing" class="resource-primary-links">
    {resourceLinks.map((link, index) => <a class="resource-link-row" href={link.href} data-analytics-event="cta_click" data-analytics-destination={link.destination} data-analytics-source="resource_links">
      <span class="resource-link-number" aria-hidden="true">0{index + 1}</span>
      <span class="resource-link-copy"><span class="resource-link-title">{link.title}</span><span class="resource-link-description">{link.description}</span></span>
      <span class="resource-link-arrow" aria-hidden="true"><svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M4.5 13.5 13.5 4.5M4.5 4.5h9v9"/></svg></span>
    </a>)}
  </nav>
  <nav aria-label="Lessons and services" class="resource-help-links">
    {resourceHelpLinks.map(link => <a href={link.href} data-analytics-event="cta_click" data-analytics-destination={link.destination} data-analytics-source="resource_links"><span>{link.title} <span aria-hidden="true"><svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M4.5 13.5 13.5 4.5M4.5 4.5h9v9"/></svg></span></span><small>{link.description}</small></a>)}
  </nav>
  <footer class="resource-links-footer"><p>By Diana Molski</p><a href="/">Have a look around <span aria-hidden="true"><svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M3 9h12m-5-5 5 5-5 5"/></svg></span></a></footer>
</main>
