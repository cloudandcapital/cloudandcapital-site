---
import { isAnalyticsHost } from '../lib/analytics.js';
const enabled = isAnalyticsHost(Astro.url.hostname, import.meta.env.PROD);
const measurementId = 'G-GXRMNTEB3B';
---

{enabled && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script>}
<script>
  import { ANALYTICS_SCHEMA, createAnalyticsTracker, isAnalyticsHost } from '../lib/analytics.js';

  if (isAnalyticsHost(window.location.hostname, import.meta.env.PROD)) {
  window.dataLayer = window.dataLayer || [];
  window.gtag = window.gtag || function (...args) { window.dataLayer.push(arguments); };
  window.gtag('js', new Date());
  window.gtag('config', 'G-GXRMNTEB3B', {
    allow_google_signals: false,
    allow_ad_personalization_signals: false,
  });

  window.ccTrack = createAnalyticsTracker((eventName, properties) => {
    window.gtag('event', eventName, properties);
  });

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target.closest('[data-analytics-event]') : null;
    if (!(target instanceof HTMLElement)) return;
    const eventName = target.dataset.analyticsEvent;
    const eventSchema = ANALYTICS_SCHEMA[eventName];
    if (!eventSchema) return;
    const properties = {};
    for (const key of Object.keys(eventSchema)) {
      const datasetKey = `analytics${key.charAt(0).toUpperCase()}${key.slice(1)}`;
      properties[key] = target.dataset[datasetKey];
    }
    window.ccTrack(eventName, properties);
  });
  }
</script>
