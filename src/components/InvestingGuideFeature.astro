---
import ActionLabel from './ActionLabel.astro';

interface Props {
  source: 'learning_guide' | 'writing_archive';
}
const { source } = Astro.props;
const titleId = `${source}-investing-title`;
---
<aside class="investing-guide-feature" aria-labelledby={titleId}>
  <div class="investing-guide-copy">
    <p class="investing-guide-kicker">Free investing guide</p>
    <h2 id={titleId}>Okay, let’s start.</h2>
    <p class="investing-guide-description">A clear route through accounts, funds, and your first purchase, with a $100 example you can try.</p>
    <a href="/resources/investing" data-analytics-event="cta_click" data-analytics-destination="investing_guide" data-analytics-source={source}><ActionLabel label="Open the guide" /></a>
    <p class="investing-guide-note">Free to use. No signup.</p>
  </div>
  <ol class="investing-guide-route" aria-label="Inside the guide">
    <li><span aria-hidden="true">01</span> Before you start</li>
    <li><span aria-hidden="true">02</span> Accounts</li>
    <li><span aria-hidden="true">03</span> Investments</li>
    <li><span aria-hidden="true">04</span> Start &amp; check</li>
  </ol>
</aside>

<style>
  .investing-guide-feature { display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:clamp(2rem,5vw,5rem);align-items:center;margin-bottom:1.5rem;padding:clamp(1.5rem,4vw,3.5rem);border:1px solid var(--theme-line,var(--border-strong,#d5c9c1));background:var(--theme-panel,#fff);color:var(--theme-ink,var(--brand-ink,#24211e)); }
  .investing-guide-feature .investing-guide-kicker { margin:0;color:var(--theme-muted,#6c625b);font:400 .65rem/1.5 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase; }
  .investing-guide-feature h2 { margin:.75rem 0 1rem;font:400 clamp(2.5rem,4.5vw,3.6rem)/1.05 'Cormorant Garamond',Georgia,serif;letter-spacing:-.035em; }
  .investing-guide-feature .investing-guide-description { max-width:38ch;margin:0;font:400 1rem/1.7 'Jost',sans-serif; }
  .investing-guide-copy > a { display:inline-flex;align-items:center;min-height:48px;margin-top:1.1rem;color:var(--theme-green,#3d6055);text-decoration:none; }
  .investing-guide-copy > a:focus-visible { outline:2px solid currentColor;outline-offset:5px; }
  .investing-guide-feature .investing-guide-note { margin:.3rem 0 0;color:var(--theme-muted,#6c625b);font:400 .8rem/1.5 'Jost',sans-serif; }
  .investing-guide-feature .investing-guide-route { list-style:none;margin:0;padding:0; }
  .investing-guide-route li { display:flex;align-items:baseline;gap:1.3rem;padding:.9rem 0;border-top:1px solid var(--border-strong,#d5c9c1);font:400 1.4rem/1.3 'Cormorant Garamond',Georgia,serif; }
  .investing-guide-route li:last-child { border-bottom:1px solid var(--border-strong,#d5c9c1); }
  .investing-guide-route span { color:var(--theme-muted,#6c625b);font:400 .65rem/1.5 'DM Mono',monospace; }
  @media(max-width:650px) { .investing-guide-feature { grid-template-columns:minmax(0,1fr);gap:1.75rem; } .investing-guide-route li { padding:.75rem 0; } }
</style>
