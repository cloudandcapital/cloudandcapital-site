---
import ActionLabel from './ActionLabel.astro';
import FlowText from './FlowText.astro';
import type { DirectoryTool } from '../data/toolDirectory';
interface Props { tool: DirectoryTool; }
const { tool } = Astro.props;
---
<a class="directory-card" data-tone={tool.tone} href={tool.href} target={tool.external ? '_blank' : undefined} rel={tool.external ? 'noopener noreferrer' : undefined} data-analytics-event="cta_click" data-analytics-destination={tool.destination} data-analytics-source={tool.source}>
  <div class="card-preview">
    <div class="preview-window">
      <div class="preview-bar" aria-hidden="true"><i></i><i></i><i></i></div>
      <img src={tool.image} alt={tool.imageAlt} width={tool.imageWidth} height={tool.imageHeight} loading="lazy" decoding="async" />
    </div>
  </div>
  <div class="card-copy">
    <p class="card-kind">{tool.kind}</p>
    <h3>{tool.name.startsWith('Software Renewal') ? <Fragment>Software <span class="name-phrase">{tool.name.replace('Software ', '')}</span></Fragment> : tool.name}</h3>
    <p class="card-description"><FlowText text={tool.description} /></p>
    <dl>
      <div><dt>You bring</dt><dd><FlowText text={tool.bring} /></dd></div>
      <div><dt>You get</dt><dd><FlowText text={tool.result} /></dd></div>
    </dl>
    <span class="card-action"><ActionLabel label={tool.action} /></span>
  </div>
</a>
<style>
  .directory-card { --preview-tint: #e4e9df; --card-accent: #3d6055; display: flex; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid #d8d8ce; border-radius: 16px; background: #fcfbf8; color: var(--brand-ink); text-decoration: none; box-shadow: 0 12px 28px -22px #24211e55; transition: border-color 180ms ease, box-shadow 180ms ease; }
  .directory-card[data-tone="rose"] { --preview-tint: #eddbd6; --card-accent: #785752; border-color: #dfc7c0; }
  .directory-card[data-tone="sand"] { --preview-tint: #eadfce; --card-accent: #6a5e4d; border-color: #dcd0bd; }
  .card-preview { display: flex; align-items: center; justify-content: center; aspect-ratio: 1.85; min-width: 0; padding: 1.25rem; background: var(--preview-tint); }
  .preview-window { width: 100%; max-height: 100%; overflow: hidden; border: 1px solid #e7e4df; border-radius: 8px; background: #fff; box-shadow: 0 17px 23px -12px #26372d59, 0 2px 5px #26372d0a; transition: transform 220ms ease, box-shadow 220ms ease; }
  .preview-bar { display: flex; align-items: center; gap: 4px; min-height: 19px; padding-inline: 8px; border-bottom: 1px solid #24211e12; background: #fff; }
  .preview-bar i { width: 4px; height: 4px; border-radius: 50%; background: #bbb4a8; }
  .preview-window img { display: block; width: 100%; height: auto; max-height: 12rem; object-fit: contain; background: #fff; }
  .card-copy { display: flex; flex-direction: column; flex: 1; min-width: 0; padding: 1.5rem; }
  .card-kind, dt { margin: 0; color: var(--card-accent); font: 500 .61rem/1.5 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
  h3 { margin: .65rem 0 0; font: italic 400 clamp(2.15rem, 2.7vw, 2.75rem)/1.05 'Cormorant Garamond', Georgia, serif; letter-spacing: -.025em; text-wrap: balance; }
  .name-phrase { display: inline-block; max-width: 100%; }
  .card-description { margin: .9rem 0 0; color: #4a4a42; font-size: .9375rem; line-height: 1.7; text-wrap: pretty; }
  dl { display: grid; gap: .9rem; margin: 1.25rem 0 1.15rem; padding-top: 1.1rem; border-top: 1px solid #3d605521; }
  dd { margin: .3rem 0 0; color: #494b43; font-size: .875rem; line-height: 1.65; text-wrap: pretty; }
  .card-action { display: block; margin-top: auto; color: var(--card-accent); }
  .card-action :global(.action-label) { font-size: .7rem; }
  .card-action :global(.action-arrow) { transition: transform 180ms ease; }
  .directory-card:hover { border-color: var(--card-accent); box-shadow: 0 18px 32px -22px #24211e66; }
  .directory-card:hover .preview-window { transform: translateY(-3px); box-shadow: 0 21px 25px -13px #26372d66; }
  .directory-card:is(:hover, :focus-visible) :global(.action-arrow) { transform: translateX(3px); }
  .directory-card:focus-visible { outline: 3px solid #89534f; outline-offset: 4px; }
  @media (max-width: 1020px) {
    .card-copy { padding: 1.25rem; }
    .card-preview { padding: 1rem; }
    h3 { font-size: clamp(2rem, 3.7vw, 2.6rem); }
  }
  @media (max-width: 760px) {
    h3 { font-size: clamp(2rem, 9vw, 2.6rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .directory-card, .preview-window, .card-action :global(.action-arrow) { transition: none; }
    .directory-card:hover .preview-window, .directory-card:is(:hover, :focus-visible) :global(.action-arrow) { transform: none; }
  }
</style>
