---
import ActionLabel from './ActionLabel.astro';
import { tools } from '../data/siteContent';
const lens = tools.find(tool => tool.slug === 'ai-cost-lens');
const guard = tools.find(tool => tool.slug === 'cloud-cost-guard-lumen');
const choices = [
  lens && { goal: 'Understand my AI costs.', name: 'AI Cost Lens', category: 'AI spending', description: 'Estimate an AI task, review a bill, or compare options using the numbers you have.', result: 'A clear cost breakdown, including review and rework time when you add it.', href: lens.href, action: 'Open AI Cost Lens', destination: 'ai_cost_lens', external: true, image: '/images/ai-cost-lens-cost-anatomy-wide.png', imageAlt: 'AI Cost Lens example comparing model, infrastructure, and human review costs for two AI routes', imageWidth: 2190, imageHeight: 964 },
  guard && { goal: 'Find out why the bill grew.', name: 'Cloud Cost Guard', category: 'Technology spending · Demo', description: 'Explore a sample cloud, AI, and software bill, with the records behind each total.', result: 'See what drove the costs and which questions deserve a closer look.', href: guard.href, action: 'Explore the demo', destination: 'cloud_cost_guard', external: true, image: '/images/cloud-cost-guard-spend-reconciliation.jpg', imageAlt: 'Cloud Cost Guard screen showing reconciled cloud, AI, and software spending', imageWidth: 1216, imageHeight: 474 },
  { goal: 'Keep track of renewals.', name: 'Software Renewal Tracker', category: 'Software subscriptions', description: 'Add your software charges, renewal dates, and cancellation deadlines.', result: 'See what is due each month and when to decide whether to keep a subscription.', href: '/tools/software-renewal-tracker', action: 'Open the renewal tracker', destination: 'software_renewal_tracker', external: false, image: '/images/software-renewal-tracker-preview.jpg', imageAlt: 'Software Renewal Tracker showing monthly equivalent costs, upcoming charges, and an illustrative subscription record', imageWidth: 1109, imageHeight: 765 },
].filter(Boolean);
---
<section class="free-tools" id="tools" aria-labelledby="tools-title">
  <div class="tools-shell">
    <div class="tools-intro" data-reveal>
      <p class="tools-eyebrow">Free tools</p>
      <h2 id="tools-title">Find a tool for the task.</h2>
      <p>Understand an AI bill, explore technology costs, or get ahead of software renewals.</p>
    </div>
    <div class="tool-choices">
      {choices.map(choice => choice && (
        <a class="tool-choice" href={choice.href} target={choice.external ? '_blank' : undefined} rel={choice.external ? 'noopener noreferrer' : undefined} data-reveal data-analytics-event="cta_click" data-analytics-destination={choice.destination} data-analytics-source="homepage_featured_tools">
          <div class="tool-copy">
            <p class="tool-category">{choice.category}</p>
            <h3>{choice.name}</h3>
            <p class="tool-question">{choice.goal}</p>
            <p class="tool-description">{choice.description}</p>
            <p class="tool-result"><span>What you get</span>{choice.result}</p>
            <span class="tool-action"><ActionLabel label={choice.action} /></span>
          </div>
          <div class="tool-window">
            <div class="window-heading" aria-hidden="true"><span class="window-dots"><i></i><i></i><i></i></span><span>{choice.name}</span></div>
            <div class="window-canvas"><img src={choice.image} alt={choice.imageAlt} width={choice.imageWidth} height={choice.imageHeight} loading="lazy" decoding="async" /></div>
          </div>
        </a>
      ))}
    </div>
    <div class="tools-more" data-reveal>
      <p>Looking for market research, worksheets, or more ways to explore?</p>
      <a href="/tools" data-analytics-event="cta_click" data-analytics-destination="work" data-analytics-source="homepage_featured_tools"><ActionLabel label="Browse all free tools" /></a>
    </div>
  </div>
</section>
<style>
  .free-tools { padding: clamp(3.5rem, 6vw, 5.5rem) 0; background: #f4f0e9; color: #24211e; }
  .tools-shell { width: min(calc(100% - 4rem), 78rem); margin-inline: auto; }
  .tools-eyebrow, .tool-category { font: 500 .65rem/1.5 'DM Mono', monospace; letter-spacing: .09em; text-transform: uppercase; }
  .tools-eyebrow { display: flex; align-items: center; gap: .75rem; color: #89534f; }
  .tools-eyebrow::after { content: ''; width: 2.7rem; height: 1px; background: currentColor; opacity: .7; }
  .tools-intro h2 { margin-top: .9rem; font: 400 clamp(2.65rem, 4vw, 4.2rem)/1.05 'Cormorant Garamond', Georgia, serif; letter-spacing: -.035em; }
  .tools-intro > p:last-child { margin-top: 1rem; color: #51564e; font-size: 1rem; line-height: 1.7; }
  .tool-choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 2.5rem; }
  .tool-choice { --tool-accent: #3d6055; display: flex; flex-direction: column; gap: 1.8rem; min-width: 0; padding: clamp(1.75rem, 3vw, 2.6rem); border: 1px solid #d0d8ca; border-radius: 16px; background: #eaf0e6; color: inherit; text-decoration: none; box-shadow: 0 8px 22px #2931270e; transition: background-color 200ms ease, border-color 200ms ease; }
  .tool-choice:first-child { --tool-accent: #faf6ef; display: grid; grid-column: 1 / -1; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); align-items: center; gap: clamp(1.8rem, 3vw, 3rem); padding: clamp(2rem, 3.5vw, 3.3rem); background: #5b7465; border-color: #5b7465; color: #faf6ef; }
  .tool-choice:last-child { --tool-accent: #89534f; border-color: #d5b4aa; background: #f3e2dc; box-shadow: inset 0 3px 0 #b47d76, 0 8px 22px #2931270e; }
  .tool-copy { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .tool-category { color: var(--tool-accent); }
  .tool-choice h3 { margin-top: .8rem; font: 400 clamp(2.3rem, 3.2vw, 3.2rem)/1.02 'Cormorant Garamond', Georgia, serif; letter-spacing: -.025em; }
  .tool-choice:first-child h3 { font-size: clamp(3rem, 4.1vw, 4.3rem); }
  .tool-question { margin-top: 1rem; font: italic 400 1.55rem/1.2 'Cormorant Garamond', Georgia, serif; }
  .tool-description { margin: .9rem 0; color: #44483f; font-size: .9rem; line-height: 1.75; }
  .tool-result { margin: 0 0 1.5rem; padding-top: .9rem; border-top: 1px solid #3d605526; font-size: .9rem; line-height: 1.65; }
  .tool-result > span { display: block; margin-bottom: .35rem; font: 500 .61rem/1.5 'DM Mono', monospace; letter-spacing: .07em; text-transform: uppercase; color: var(--tool-accent); }
  .tool-choice:first-child .tool-result { border-color: #faf6ef40; }
  .tool-choice:last-child .tool-result { border-color: #89534f30; }
  .tool-action { margin-top: auto; color: var(--tool-accent); }
  .tool-choice:first-child .tool-description { color: #faf6ef; }
  .tool-window { position: relative; isolation: isolate; min-width: 0; margin: 0 10px 10px 0; border-radius: 12px; background: #faf6ef; color: #625d55; box-shadow: 0 12px 26px -16px #18282073; }
  .tool-window::before { content: ''; position: absolute; inset: 10px -10px -10px 10px; z-index: -1; border-radius: 12px; background: #cad8c8; }
  .tool-choice:first-child .tool-window::before { background: #dfe3d7; }
  .tool-choice:last-child .tool-window::before { background: #d8bdb5; }
  .tool-choice:not(:first-child) .tool-window { order: -1; }
  .window-heading { position: relative; display: flex; align-items: center; justify-content: center; min-height: 2rem; padding: .6rem 2.7rem; border-radius: 12px 12px 0 0; border-bottom: 1px solid #24211e1a; background: #faf6ef; font: 400 .55rem/1.4 'DM Mono', monospace; }
  .window-dots { position: absolute; left: .85rem; display: flex; gap: .3rem; }
  .window-dots i { width: 5px; height: 5px; border-radius: 50%; background: #bbb4a8; }
  .window-canvas { display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 0 0 12px 12px; background: #f4f0e9; }
  .window-canvas img { display: block; width: 100%; height: auto; }
  .tool-choice:not(:first-child) .window-canvas { aspect-ratio: 16 / 10; }
  .tool-choice:not(:first-child) .window-canvas img { width: 100%; height: 100%; object-fit: contain; }
  .tool-choice:hover { background: #f0f3e9; border-color: #a4b59c; }
  .tool-choice:first-child:hover { background: #526d5c; border-color: #526d5c; }
  .tool-choice:last-child:hover { background: #ecd6cf; border-color: #b47d76; }
  .tool-choice:focus-visible, .tools-more a:focus-visible { outline: 3px solid #89534f; outline-offset: 4px; }
  .tools-more { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem 2rem; padding-top: 1.6rem; }
  .tools-more p { color: #51564e; font-size: .9rem; line-height: 1.7; }
  .tools-more a { color: #3d6055; text-decoration: none; }
  @media (max-width: 1020px) { .tool-choice:first-child { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 760px) { .tools-shell { width: calc(100% - 2.5rem); } .tool-choices { grid-template-columns: minmax(0, 1fr); } .tool-choice { padding: 1.75rem; } .tool-choice:first-child { padding: 1.75rem; } }
  @media (prefers-reduced-motion: reduce) { .tool-choice { transition: none; } }
</style>
