---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/interactive-lab.css';
---

<BaseLayout title="AI & Cloud Spend Decision Briefs | Cloud & Capital" description="Use Interactive Lab to turn a question about cloud, AI, SaaS, or technology spend into a structured decision brief.">
  <header class="lab-hero">
    <a class="lab-back" href="/tools">← All free tools</a>
    <div>
      <div class="lab-kicker">Interactive Lab · Free tool</div>
      <h1><span>Bring a decision.</span> <span>Leave with a <em>brief.</em></span></h1>
    </div>
    <div class="lab-hero-note">
      <p>Renew software, commit to cloud capacity, or change your AI setup? Lay out the options, spot the gaps, and get a next step you can use.</p>
      <p class="lab-hero-meta"><span>No sign-up</span><span>Copy or save as PDF</span></p>
      <p class="lab-guide-link"><a href="/insights/using-interactive-lab">Walk through a software <span class="lab-guide-ending">renewal <span aria-hidden="true">→</span></span></a></p>
    </div>
  </header>

  <main class="lab-shell" id="main-content">
    <p class="lab-status" id="labStatus" role="status" aria-live="polite" aria-atomic="true"></p>
    <section class="lab-frame" aria-label="Interactive decision lab">
      <div class="lab-rail" aria-label="Progress">
        <div class="lab-step is-active" id="stepDecision" aria-current="step"><span class="lab-step-number">01</span> Decision</div>
        <div class="lab-step" id="stepEvidence"><span class="lab-step-number">02</span> Details</div>
        <div class="lab-step" id="stepBrief"><span class="lab-step-number">03</span> Brief</div>
      </div>

      <div class="lab-workspace" id="labWorkspace">
        <aside class="lab-input-pane">
          <div id="decisionStage">
            <div class="pane-eyebrow">Start with the decision</div>
            <h2 class="pane-heading">What’s the decision?</h2>
            <p class="pane-intro">Describe what you’re choosing between and why it matters.</p>

            <div class="section-rule"></div>
            <label class="field-label" for="decisionInput">Your decision</label>
            <span class="field-help" id="decisionHelp">A sentence or two is plenty. At least 20 characters.</span>
            <textarea class="lab-textarea" id="decisionInput" maxlength="2000" aria-describedby="decisionHelp decisionCount" placeholder="What is the decision, and what makes it tricky?"></textarea>
            <span class="field-help" id="decisionCount">0 / 2,000 characters</span>
            <div class="form-actions">
              <button type="button" class="lab-button lab-button-primary" id="contextBtn" disabled>Next: add details →</button>
              <button type="button" class="lab-button lab-button-quiet" id="resetBtn">Reset</button>
            </div>

            <div class="section-rule"></div>
            <div class="scenario-label">Try a made-up example</div>
            <p class="scenario-help">Pick one to fill in the question and details.</p>
            <div class="scenario-list" id="scenarioList">
              <button type="button" class="scenario-button" data-type="commitment" data-analytics-scenario="gpu_commitment">
                <span class="scenario-index">i</span><span><span class="scenario-name">GPU commitment</span><span class="scenario-summary">One-year capacity commitment with uncertain demand</span></span>
              </button>
              <button type="button" class="scenario-button" data-type="renewal" data-analytics-scenario="saas_renewal">
                <span class="scenario-index">ii</span><span><span class="scenario-name">Software renewal</span><span class="scenario-summary">A higher quote and seats that sit unused</span></span>
              </button>
              <button type="button" class="scenario-button" data-type="build_buy" data-analytics-scenario="ai_build_or_buy">
                <span class="scenario-index">iii</span><span><span class="scenario-name">AI build or buy</span><span class="scenario-summary">A $40K monthly API bill and three paths</span></span>
              </button>
              <button type="button" class="scenario-button" data-type="cost_review" data-analytics-scenario="cost_review">
                <span class="scenario-index">iv</span><span><span class="scenario-name">Cost review</span><span class="scenario-summary">A large bill with limited recent analysis</span></span>
              </button>
              <button type="button" class="scenario-button" data-type="architecture" data-analytics-scenario="multi_cloud">
                <span class="scenario-index">v</span><span><span class="scenario-name">Multi-cloud</span><span class="scenario-summary">Resilience narrative versus operating complexity</span></span>
              </button>
            </div>
          </div>

          <div id="contextStage" hidden>
            <div class="pane-eyebrow" id="contextEyebrow">Decision context</div>
            <h2 class="pane-heading">A few details make the difference.</h2>
            <p class="pane-intro">Share what you know, including what you haven’t checked yet. Back keeps your answers.</p>
            <div class="type-chip" id="typeChip"></div>
            <p class="context-change-note" id="contextChangeNotice" hidden>You changed the decision. Check that the answers still match, especially prices and deadlines.</p>
            <div class="evidence-meter"><span id="evidenceText">0 of 4 questions answered</span><span class="meter-track" id="evidenceProgress" role="progressbar" aria-labelledby="evidenceText" aria-valuemin="0" aria-valuemax="4" aria-valuenow="0"><span class="meter-fill" id="meterFill"></span></span></div>
            <div class="context-fields" id="contextFields"></div>
            <div class="form-actions">
              <button type="button" class="lab-button lab-button-primary" id="briefBtn" disabled>Generate the brief →</button>
              <button type="button" class="lab-button lab-button-quiet" id="backBtn">Back</button>
            </div>
            <button type="button" class="lab-button lab-button-quiet last-brief-button" id="viewLastBriefBtn" hidden>View last brief</button>
          </div>

          <p class="privacy-note" id="exampleNotice" hidden>Illustrative example. These details are made up. Check or replace every detail before using it for your own decision, or go Back and Reset to start fresh.</p>
          <p class="privacy-note">Leave out confidential terms, customer data, passwords, and sensitive infrastructure details. Your entries are sent to an AI model to generate the brief.</p>
          <div class="lab-error" id="errorMsg" role="alert" hidden></div>
        </aside>

        <section class="lab-output-pane" id="outputPane" aria-busy="false">
          <div class="brief-placeholder" id="placeholderState">
            <div class="brief-placeholder-top"><span class="memo-label">Cloud &amp; Capital · Decision Brief</span><span class="memo-status" id="placeholderStatus">Waiting for context</span></div>
            <div class="brief-placeholder-copy">
              <h2 id="placeholderHeading">Your options, in one place.</h2>
              <p id="placeholderCopy">A suggested next move, a side-by-side comparison, and the details to check before you choose.</p>
              <figure class="brief-sample">
                <a href="/insights/using-interactive-lab" aria-label="Read the software renewal example">
                  <img src="/images/interactive-lab-renewal-brief.jpg" alt="A software renewal example showing a suggested next move and the terms still needing a check" width="1054" height="597" decoding="async" />
                </a>
                <figcaption>A brief from the made-up renewal example. <a href="/insights/using-interactive-lab">See how to use it <span aria-hidden="true">→</span></a></figcaption>
              </figure>
            </div>
            <div class="brief-outline" aria-label="Brief contents"><div class="outline-item">Suggested next move</div><div class="outline-item">Your options</div><div class="outline-item">What to check</div></div>
          </div>

          <div class="thinking-state" id="thinkingState" hidden>
            <div class="thinking-mark" aria-hidden="true"></div>
            <h2>Building the decision brief</h2>
            <p id="thinkingText">Reading your context</p>
            <p>Usually takes less than a minute. Your answers stay here if it cannot finish.</p>
            <button type="button" class="lab-button lab-button-quiet" id="cancelBtn">Cancel</button>
          </div>

          <article class="decision-brief" id="briefState" tabindex="-1" hidden>
            <p class="privacy-note" id="briefExampleNotice" hidden>Illustrative example. Started with made-up details; check or replace every detail before using this for a real decision.</p>
            <details class="context-summary" id="contextSummary">
              <summary><span class="context-summary-label">Context supplied</span><span class="context-summary-decision" id="contextSummaryDecision"></span><span class="context-summary-toggle">View details</span></summary>
              <div class="context-summary-body"><dl class="context-summary-list" id="contextSummaryList"></dl><div class="context-summary-actions"><button type="button" class="lab-button lab-button-quiet" id="summaryEditBtn">Edit context</button></div></div>
            </details>
            <header class="brief-header">
              <img class="brief-print-brand" src="/images/brand/cloud-and-capital-wordmark.png" alt="Cloud & Capital" width="1551" height="174" />
              <div class="brief-header-top"><span class="memo-label">Cloud &amp; Capital · Decision Brief</span><span class="brief-posture" id="briefPosture"></span></div>
              <h2 class="brief-title" id="briefTitle" tabindex="-1"></h2>
              <p class="brief-posture-reason" id="briefPostureReason"></p>
            </header>

            <section class="print-context"><h2>Context supplied</h2><p id="printDecision"></p><dl id="printAnswers"></dl></section>
            <section class="renewal-checklist" id="renewalChecklist" hidden><h3>Before you renew</h3><p>Check whether the plan auto-renews and the deadlines to cancel or change seats. A notice deadline can fall before the renewal date.</p></section>

            <section class="brief-section brief-recommendation"><h3>Recommendation</h3><div class="recommendation"><div class="recommendation-top"><span>The next move</span><span id="confidenceLabel"></span></div><p class="recommendation-move" id="recommendationMove"></p><p class="recommendation-rationale" id="recommendationRationale"></p></div></section>
            <section class="brief-section brief-next-actions"><h3>Next actions</h3><div class="options-wrap"><table class="actions-table"><thead><tr><th>Action</th><th>Suggested owner</th><th>Timing</th></tr></thead><tbody id="actionsBody"></tbody></table></div></section>
            <section class="brief-section" id="calculationsSection" hidden><h3>Calculated from your inputs</h3><ul class="brief-list" id="checkedCalculations"></ul></section>
            <section class="brief-section"><h3>Options to compare</h3><p class="option-note">The AI organizes the options you named and labels ideas it adds as Suggested. Check that the choices are available to you. Owners are suggestions too. Needs checking means an effect or saving has not been established here.</p><div id="optionMatrix"></div></section>
            <section class="brief-section"><h3>What still needs checking</h3><ul class="brief-list" id="missingInformation"></ul></section>
            <p class="brief-disclosure">This is an AI-generated decision aid based only on the context supplied. Validate provider terms, calculations, and financially consequential decisions against primary data before acting.</p>
            <div class="brief-actions"><button type="button" class="lab-button lab-button-primary" id="copyBtn">Copy decision brief</button><button type="button" class="lab-button lab-button-quiet" id="printBtn">Print / Save PDF</button><button type="button" class="lab-button lab-button-quiet" id="editBtn">Edit context</button><button type="button" class="lab-button lab-button-quiet" id="anotherBtn">Try another</button></div>
            <div class="copy-state" id="copyState" aria-live="polite"></div>
          </article>
        </section>
      </div>
    </section>
  </main>

  <script is:inline>
    const state = { decisionType: '', questions: [], answers: {}, brief: null, briefContext: null, calculations: [], optionChecks: [], selectedScenario: null, example: false, contextDecision: '', decisionChanged: false };
    const starterExamples = {
      commitment: {
        decision: 'Should we reserve GPU capacity for one year at $500K, or keep buying capacity as needed?',
        answers: { alternatives: 'Reserve capacity, reserve only the stable baseline, or keep paying as needed.', exposure: 'The full reservation costs $500K for one year. The pay-as-you-go comparison and cancellation terms are not yet known.', demand: 'A core workload runs regularly, but its minimum capacity need has not been measured. Future demand is uncertain.', constraint: 'Keep the core workload available. Finance wants flexibility, and engineering needs to confirm which capacity is essential.' },
      },
      renewal: {
        decision: 'Our design software renews in 30 days. We pay $2,880 a year for 12 seats, and the new quote is 20% higher. Should we renew, reduce seats, or switch?',
        answers: { alternatives: 'Renew all 12 seats, renew only the 10 active seats, negotiate the quote, or switch to another design tool.', exposure: 'Current price is $2,880 per year for 12 seats. The quote increases the price by 20%. The renewal deadline is in 30 days.', demand: 'Ten seats are used every week and two seats are unused. The design lead owns the subscription.', constraint: 'Keep access to existing design files and comments. Migration effort, replacement price, seat-pricing rules, and the next contract term are not yet known.' },
      },
      build_buy: {
        decision: 'Our AI feature costs $40K per month. Over the next one year, should we optimize the API, try a smaller model, or build in-house?',
        answers: { alternatives: 'Optimize the current API, try a smaller hosted model, or build and operate our own model.', exposure: 'The current API costs $40K per month. Replacement pricing, development effort, and ongoing operating costs are unknown.', demand: 'Customers use the feature regularly, but we have not yet measured which requests need the current model.', constraint: 'We have not checked how much engineering time we could spare or what it would take to run a model ourselves. Any change must be tested for answer quality and customer response times.' },
      },
      cost_review: {
        decision: 'Our AWS bill is $180K per month. Where should we start reducing it without hurting reliability?',
        answers: { alternatives: 'Remove unused resources, adjust oversized workloads, or review purchasing commitments after understanding usage.', exposure: 'The current bill is $180K per month. We do not yet have a verified savings estimate or a confirmed reduction target.', demand: 'The bill has not been fully reviewed in 18 months. We need usage history and ownership by service before choosing changes.', constraint: 'Protect customer reliability and security. Each change needs an owner and a way to reverse it if service quality drops.' },
      },
      architecture: {
        decision: 'Our 50-person company runs on AWS. Would adding another cloud improve resilience enough to justify the extra work?',
        answers: { alternatives: 'Improve resilience within AWS, add another cloud for a critical workload, or keep the current setup while testing recovery.', exposure: 'No comparable implementation, licensing, staffing, or ongoing operating costs have been gathered yet.', demand: 'We have not tested recovery for our most important workload. The engineering team already supports the current cloud.', constraint: 'Protect customer availability and avoid an operating setup the team cannot maintain. Recovery targets still need to be agreed.' },
      },
    };
    const $ = (id) => document.getElementById(id);
    const decisionInput = $('decisionInput');
    const contextBtn = $('contextBtn');
    const briefBtn = $('briefBtn');
    const errorMsg = $('errorMsg');
    const outputPane = $('outputPane');
    let thinkingTimer = null;
    let toolSessionStarted = false;
    let toolCompletionTracked = false;
    let busy = false;
    let activeController = null;
    let requestVersion = 0;

    function setBusy(value) {
      busy = value;
      document.querySelectorAll('.scenario-button, #decisionInput, #contextFields textarea, #backBtn, #viewLastBriefBtn').forEach((input) => { input.disabled = value; });
      contextBtn.disabled = value || decisionInput.value.trim().length < 20;
      updateEvidence();
    }

    function updateDecisionCount() {
      $('decisionCount').textContent = `${decisionInput.value.length.toLocaleString()} / 2,000 characters`;
    }

    function setError(message = '', code = '', claims = [], schemaIssue = null) {
      errorMsg.textContent = message;
      errorMsg.hidden = !message;
      errorMsg.dataset.code = code;
      errorMsg.dataset.rejectedClaims = JSON.stringify(claims);
      errorMsg.dataset.schemaIssue = JSON.stringify(schemaIssue);
    }

    function setStep(active) {
      const steps = [$('stepDecision'), $('stepEvidence'), $('stepBrief')];
      steps.forEach((step, index) => {
        step.classList.toggle('is-active', index === active);
        step.classList.toggle('is-complete', index < active);
        if (index === active) step.setAttribute('aria-current', 'step'); else step.removeAttribute('aria-current');
      });
    }

    function showPlaceholder(mode = 'initial') {
      $('placeholderState').hidden = false;
      $('thinkingState').hidden = true;
      $('briefState').hidden = true;
      if (mode === 'context') {
        $('placeholderStatus').textContent = 'Context in progress';
        $('placeholderHeading').textContent = 'A little context. A clearer next step.';
        $('placeholderCopy').textContent = 'Answer the four questions. Anything you haven’t checked becomes a gap to investigate, not a fact to assume.';
      } else {
        $('placeholderStatus').textContent = 'Waiting for context';
        $('placeholderHeading').textContent = 'Your options, in one place.';
        $('placeholderCopy').textContent = 'A suggested next move, a side-by-side comparison, and the details to check before you choose.';
      }
    }

    function showDecisionStage() {
      $('labWorkspace').classList.remove('is-results');
      $('decisionStage').hidden = false;
      $('contextStage').hidden = true;
      setStep(0);
      showPlaceholder('initial');
      setError();
    }

    function showContextStage() {
      $('labWorkspace').classList.remove('is-results');
      $('decisionStage').hidden = true;
      $('contextStage').hidden = false;
      setStep(1);
      showPlaceholder('context');
      setError();
      updateEvidence();
      $('viewLastBriefBtn').hidden = !state.brief;
    }

    function showCompletedBrief(message = 'Brief ready.') {
      $('placeholderState').hidden = true;
      stopThinking();
      $('labWorkspace').classList.add('is-results');
      $('briefState').hidden = false;
      setStep(2);
      $('labStatus').textContent = message;
      $('briefTitle').focus({ preventScroll: true });
      $('briefState').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function makeElement(tag, className, text) {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    document.querySelectorAll('.scenario-button').forEach((button) => {
      button.setAttribute('aria-pressed', 'false');
      button.addEventListener('click', () => {
        window.ccTrack?.('starter_scenario_selected', { scenario: button.dataset.analyticsScenario, tool: 'interactive_lab' });
        document.querySelectorAll('.scenario-button').forEach((item) => { item.classList.remove('is-selected'); item.setAttribute('aria-pressed', 'false'); });
        button.classList.add('is-selected');
        button.setAttribute('aria-pressed', 'true');
        state.selectedScenario = button;
        state.decisionType = button.dataset.type;
        const example = starterExamples[button.dataset.type];
        decisionInput.value = example.decision;
        state.answers = { ...example.answers };
        state.brief = null;
        state.briefContext = null;
        state.contextDecision = '';
        state.decisionChanged = false;
        state.example = true;
        $('exampleNotice').hidden = false;
        updateDecisionCount();
        loadContext();
      });
    });

    decisionInput.addEventListener('input', () => {
      contextBtn.disabled = busy || decisionInput.value.trim().length < 20;
      updateDecisionCount();
      if (state.selectedScenario && decisionInput.value !== starterExamples[state.selectedScenario.dataset.type].decision) {
        state.selectedScenario.classList.remove('is-selected');
        state.selectedScenario.setAttribute('aria-pressed', 'false');
        state.selectedScenario = null;
      }
    });

    async function callLab(payload) {
      activeController?.abort();
      const controller = new AbortController();
      activeController = controller;
      const timer = setTimeout(() => controller.abort(), payload.stage === 'brief' ? 60000 : 15000);
      try {
        const response = await fetch('/api/interactive-lab', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        signal: controller.signal,
      });
      let data = {};
      try { data = await response.json(); } catch { data = {}; }
      if (!response.ok) {
        const error = new Error(data.error || 'The Lab could not complete the request.');
        error.code = data.code || '';
        error.rejectedClaims = data.rejectedClaims || [];
        error.schemaIssue = data.schemaIssue || null;
        throw error;
      }
      return data;
      } catch (error) {
        if (error.name === 'AbortError') throw new Error('That took too long. Your answers are still here. Try again in a moment.');
        throw error;
      } finally {
        clearTimeout(timer);
        if (activeController === controller) activeController = null;
      }
    }

    contextBtn.addEventListener('click', loadContext);
    async function loadContext() {
      const decision = decisionInput.value.trim();
      if (decision.length < 20 || busy) return;
      const operation = ++requestVersion;
      const previousType = state.decisionType;
      const previousDecision = state.contextDecision;
      setBusy(true);
      contextBtn.textContent = 'Reading the decision…';
      setError();
      if (!toolSessionStarted) {
        window.ccTrack?.('tool_start', { tool: 'interactive_lab', entry: state.selectedScenario ? 'starter_scenario' : 'decision_form' });
        toolSessionStarted = true;
      }
      try {
        const data = await callLab({ stage: 'questions', decision, decisionType: state.selectedScenario?.dataset.type, answers: state.answers });
        if (operation !== requestVersion) return;
        state.decisionType = data.decisionType;
        state.questions = data.questions;
        state.answers = previousType && previousType !== data.decisionType ? {} : data.answers || {};
        if (previousType && previousType !== data.decisionType) state.decisionChanged = false;
        else if (previousDecision && previousDecision !== decision && Object.values(state.answers).some(Boolean)) state.decisionChanged = true;
        state.contextDecision = decision;
        $('contextChangeNotice').hidden = !state.decisionChanged;
        renderContextFields(data);
        showContextStage();
        $('contextFields').querySelector('textarea')?.focus({ preventScroll: true });
        $('contextStage').scrollIntoView({ behavior: 'smooth', block: 'start' });
        window.ccTrack?.('lab_stage_result', { stage: 'questions', result: 'success' });
      } catch (error) {
        if (operation !== requestVersion) return;
        window.ccTrack?.('lab_stage_result', { stage: 'questions', result: 'failure' });
        setError(error.message, error.code, error.rejectedClaims, error.schemaIssue);
      } finally {
        if (operation === requestVersion) {
          contextBtn.textContent = 'Next: add details →';
          setBusy(false);
        }
      }
    }

    function renderContextFields(data) {
      $('typeChip').textContent = data.typeLabel;
      $('contextEyebrow').textContent = data.eyebrow || 'Decision context';
      const container = $('contextFields');
      container.replaceChildren();
      data.questions.forEach((question) => {
        const wrap = makeElement('div', 'context-field');
        const label = makeElement('label', 'field-label', question.label);
        label.htmlFor = `context-${question.id}`;
        const help = makeElement('span', 'field-help', question.prompt);
        help.id = `help-${question.id}`;
        const textarea = makeElement('textarea', 'lab-textarea');
        textarea.id = `context-${question.id}`;
        textarea.maxLength = 1200;
        textarea.value = state.answers[question.id] || '';
        textarea.setAttribute('aria-describedby', help.id);
        textarea.addEventListener('input', () => {
          state.answers[question.id] = textarea.value.trim();
          updateEvidence();
        });
        wrap.append(label, help, textarea);
        container.append(wrap);
      });
    }

    function updateEvidence() {
      const complete = state.questions.filter((question) => (state.answers[question.id] || '').trim().length >= 8).length;
      const total = state.questions.length || 4;
      $('evidenceText').textContent = `${complete} of ${total} questions answered`;
      $('meterFill').style.width = `${(complete / total) * 100}%`;
      $('evidenceProgress').setAttribute('aria-valuenow', String(complete));
      briefBtn.disabled = busy || complete !== total;
    }

    $('backBtn').addEventListener('click', showDecisionStage);
    $('cancelBtn').addEventListener('click', () => {
      requestVersion += 1;
      activeController?.abort();
      activeController = null;
      briefBtn.textContent = 'Generate the brief →';
      stopThinking();
      showContextStage();
      setBusy(false);
      $('labStatus').textContent = 'Generation cancelled. Your answers are still here.';
      $('contextStage').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    $('resetBtn').addEventListener('click', resetLab);
    $('anotherBtn').addEventListener('click', resetLab);
    function editContext() {
      if (toolSessionStarted) window.ccTrack?.('tool_output_action', { tool: 'interactive_lab', action: 'edit' });
      showContextStage();
      $('contextFields').querySelector('textarea')?.focus({ preventScroll: true });
      $('contextStage').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    $('editBtn').addEventListener('click', editContext);
    $('summaryEditBtn').addEventListener('click', editContext);
    $('viewLastBriefBtn').addEventListener('click', () => { if (state.brief) showCompletedBrief('Showing your last brief.'); });

    function resetLab() {
      requestVersion += 1;
      activeController?.abort();
      activeController = null;
      stopThinking();
      if (toolSessionStarted) window.ccTrack?.('tool_output_action', { tool: 'interactive_lab', action: 'reset' });
      toolSessionStarted = false;
      toolCompletionTracked = false;
      clearInterval(thinkingTimer);
      state.decisionType = '';
      state.questions = [];
      state.answers = {};
      state.brief = null;
      state.briefContext = null;
      state.calculations = [];
      state.optionChecks = [];
      state.example = false;
      state.selectedScenario = null;
      state.contextDecision = '';
      state.decisionChanged = false;
      decisionInput.value = '';
      $('exampleNotice').hidden = true;
      $('copyState').textContent = '';
      $('contextChangeNotice').hidden = true;
      $('viewLastBriefBtn').hidden = true;
      $('labStatus').textContent = '';
      contextBtn.textContent = 'Next: add details →';
      briefBtn.textContent = 'Generate the brief →';
      updateDecisionCount();
      setBusy(false);
      document.querySelectorAll('.scenario-button').forEach((item) => { item.classList.remove('is-selected'); item.setAttribute('aria-pressed', 'false'); });
      showDecisionStage();
      decisionInput.focus();
      window.scrollTo({ top: document.querySelector('.lab-frame').offsetTop - 80, behavior: 'smooth' });
    }

    function startThinking() {
      $('placeholderState').hidden = true;
      $('briefState').hidden = true;
      $('thinkingState').hidden = false;
      outputPane.setAttribute('aria-busy', 'true');
      $('labStatus').textContent = 'Building your brief.';
      const messages = ['Reading your context', 'Comparing your options', 'Looking at cost, budget, and practical tradeoffs', 'Checking what could change the answer'];
      let index = 0;
      $('thinkingText').textContent = messages[index];
      clearInterval(thinkingTimer);
      thinkingTimer = setInterval(() => { index = (index + 1) % messages.length; $('thinkingText').textContent = messages[index]; }, 1600);
    }

    function stopThinking() {
      clearInterval(thinkingTimer);
      $('thinkingState').hidden = true;
      outputPane.setAttribute('aria-busy', 'false');
    }

    briefBtn.addEventListener('click', async () => {
      updateEvidence();
      if (briefBtn.disabled) return;
      const operation = ++requestVersion;
      setBusy(true);
      setError();
      setStep(2);
      startThinking();
      briefBtn.textContent = 'Building your brief…';
      $('thinkingState').scrollIntoView({ behavior: 'smooth', block: 'center' });
      try {
        const suppliedContext = { decision: decisionInput.value.trim(), questions: state.questions.map((question) => ({ ...question })), answers: { ...state.answers }, example: state.example, decisionType: state.decisionType };
        const data = await callLab({ stage: 'brief', decision: decisionInput.value.trim(), decisionType: state.decisionType, answers: state.answers });
        if (operation !== requestVersion) return;
        if (data.status !== 'ready' || !data.brief) throw new Error('The Lab needs more context before it can generate the brief.');
        state.brief = data.brief;
        state.briefContext = suppliedContext;
        state.calculations = data.calculations || [];
        state.optionChecks = data.optionChecks || [];
        $('copyState').textContent = '';
        renderBrief(data.brief);
        renderContextSummary();
        showCompletedBrief();
        window.ccTrack?.('lab_stage_result', { stage: 'brief', result: 'success' });
        if (!toolCompletionTracked) {
          window.ccTrack?.('tool_complete', { tool: 'interactive_lab', result: 'completed' });
          toolCompletionTracked = true;
        }
      } catch (error) {
        if (operation !== requestVersion) return;
        window.ccTrack?.('lab_stage_result', { stage: 'brief', result: 'failure' });
        stopThinking();
        setStep(1);
        showPlaceholder('context');
        setError(error.message, error.code, error.rejectedClaims, error.schemaIssue);
        errorMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } finally {
        if (operation === requestVersion) {
          briefBtn.textContent = 'Generate the brief →';
          setBusy(false);
        }
      }
    });

    function appendTextList(container, items, formatter) {
      container.replaceChildren();
      items.forEach((item) => {
        const li = makeElement('li');
        if (formatter) formatter(li, item); else li.textContent = item;
        container.append(li);
      });
    }


    function renderBrief(brief) {
      const postureLabels = { Explore: 'Gather more information', Stage: 'Compare before committing', Commit: 'Ready to choose' };
      $('briefPosture').textContent = postureLabels[brief.posture.label];
      $('briefTitle').textContent = brief.decision_summary;
      $('briefPostureReason').textContent = brief.posture.rationale;
      $('calculationsSection').hidden = !state.calculations.length;
      appendTextList($('checkedCalculations'), state.calculations.map((item) => item.explanation));
      $('confidenceLabel').textContent = `${brief.recommendation.confidence} confidence`;
      $('recommendationMove').textContent = brief.recommendation.move;
      $('recommendationRationale').textContent = brief.recommendation.rationale;
      $('renewalChecklist').hidden = state.briefContext.decisionType !== 'renewal';
      renderOptionMatrix(brief.options);
      appendTextList($('missingInformation'), brief.missing_information);
      $('actionsBody').replaceChildren();
      brief.next_actions.forEach((action) => {
        const row = document.createElement('tr');
        [['action', 'Action'], ['owner', 'Suggested owner'], ['timing', 'Timing']].forEach(([key, label]) => {
          const cell = makeElement('td', '', action[key]);
          cell.dataset.label = label;
          row.append(cell);
        });
        $('actionsBody').append(row);
      });
    }

    function renderContextSummary() {
      const context = state.briefContext;
      $('contextSummary').open = false;
      $('contextSummaryDecision').textContent = context.decision;
      $('contextSummary').querySelector('.context-summary-toggle').textContent = 'View details';
      $('briefExampleNotice').hidden = !context.example;
      $('printDecision').textContent = context.decision;
      $('printAnswers').replaceChildren();
      const list = $('contextSummaryList');
      list.replaceChildren();
      context.questions.forEach((question) => {
        const item = makeElement('div', 'context-summary-item');
        item.append(makeElement('dt', '', question.label), makeElement('dd', '', context.answers[question.id] || ''));
        list.append(item);
        $('printAnswers').append(makeElement('dt', '', question.label), makeElement('dd', '', context.answers[question.id] || ''));
      });
    }

    $('contextSummary').addEventListener('toggle', () => {
      $('contextSummary').querySelector('.context-summary-toggle').textContent = $('contextSummary').open ? 'Hide details' : 'View details';
    });

    function optionSourceLabel(option) {
      return option.source === 'supplied' ? 'From your context' : 'Suggested';
    }

    function needsOptionCheck(index, field) {
      return state.optionChecks.some((check) => check.optionIndex === index && check.field === field);
    }

    function optionValue(tag, option, field, index) {
      const cell = makeElement(tag, '', option[field]);
      if (needsOptionCheck(index, field)) cell.append(makeElement('span', 'option-source needs-checking', 'Needs checking'));
      return cell;
    }

    function renderOptionMatrix(options) {
      const criteria = [
        ['cost_effect', 'Cost'],
        ['practical_effect', 'What changes'],
        ['check', 'Check before choosing'],
      ];
      const container = $('optionMatrix');
      container.replaceChildren();

      const table = makeElement('table', 'decision-matrix');
      const head = document.createElement('thead');
      const headRow = document.createElement('tr');
      headRow.append(makeElement('th', '', 'Criterion'));
      options.forEach((option) => {
        const heading = makeElement('th', '', option.name);
        heading.append(makeElement('span', 'option-source', optionSourceLabel(option)));
        headRow.append(heading);
      });
      head.append(headRow);
      const body = document.createElement('tbody');
      criteria.forEach(([key, label]) => {
        const row = document.createElement('tr');
        const rowHeader = makeElement('th', '', label);
        rowHeader.scope = 'row';
        row.append(rowHeader);
        options.forEach((option, index) => row.append(optionValue('td', option, key, index)));
        body.append(row);
      });
      table.append(head, body);

      const mobile = makeElement('div', 'matrix-mobile');
      options.forEach((option, index) => {
        const card = makeElement('section', 'matrix-option');
        const heading = makeElement('h4', '', option.name);
        heading.append(makeElement('span', 'option-source', optionSourceLabel(option)));
        card.append(heading);
        const list = document.createElement('dl');
        criteria.forEach(([key, label]) => {
          const row = makeElement('div', 'matrix-option-row');
          row.append(makeElement('dt', '', label), optionValue('dd', option, key, index));
          list.append(row);
        });
        card.append(list);
        mobile.append(card);
      });
      container.append(table, mobile);
    }

    function briefToText(brief) {
      const context = state.briefContext;
      const lines = [
        'CLOUD & CAPITAL · DECISION BRIEF', '', brief.decision_summary, brief.posture.rationale, '',
        ...(context.example ? ['ILLUSTRATIVE EXAMPLE: Started with made-up details. Check or replace every detail before using it for a real decision.', ''] : []),
        ...(context.decisionType === 'renewal' ? ['BEFORE YOU RENEW', $('renewalChecklist').querySelector('p').textContent, ''] : []),
        'RECOMMENDATION', brief.recommendation.move, `${brief.recommendation.confidence} confidence: ${brief.recommendation.rationale}`, '',
        'NEXT ACTIONS', ...brief.next_actions.map((action) => `- ${action.action} | Suggested owner: ${action.owner} | Timing: ${action.timing}`), '',
        ...(state.calculations.length ? ['CALCULATED FROM YOUR INPUTS', ...state.calculations.map((item) => item.explanation), ''] : []),
        'OPTIONS TO COMPARE',
      ];
      brief.options.forEach((option, index) => lines.push(`${option.name} (${optionSourceLabel(option)})`, `Cost: ${needsOptionCheck(index, 'cost_effect') ? 'Needs checking: ' : ''}${option.cost_effect}`, `What changes: ${needsOptionCheck(index, 'practical_effect') ? 'Needs checking: ' : ''}${option.practical_effect}`, `Check before choosing: ${option.check}`, ''));
      lines.push('WHAT STILL NEEDS CHECKING', ...brief.missing_information.map((item) => `- ${item}`), '', 'CONTEXT SUPPLIED', 'Your decision', context.decision, ...context.questions.flatMap((question) => [question.label, context.answers[question.id] || '', '']), 'AI-generated decision aid. Options and suggested owners need checking. Check terms and calculations against primary data before acting.');
      return lines.join('\n');
    }

    $('copyBtn').addEventListener('click', async () => {
      if (!state.brief) return;
      try {
        await navigator.clipboard.writeText(briefToText(state.brief));
        window.ccTrack?.('tool_output_action', { tool: 'interactive_lab', action: 'copy' });
        $('copyState').textContent = 'Decision brief copied.';
      } catch {
        $('copyState').textContent = 'Copy was blocked by the browser. Use Print / Save PDF instead.';
      }
    });
    $('printBtn').addEventListener('click', () => {
      if (!state.brief) return;
      window.ccTrack?.('tool_output_action', { tool: 'interactive_lab', action: 'print' });
      window.print();
    });
  </script>
</BaseLayout>
