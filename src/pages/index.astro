/* ── Work 4-col bottom cards ── */
.work-bottom-4col {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  border-top: 1px solid rgba(255,255,255,.1);
}
.work-4col-card {
  padding: 2.5rem 2.25rem 2.75rem;
  display: flex;
  flex-direction: column;
  border-right: 1px solid rgba(255,255,255,.08);
  position: relative;
  transition: background .2s;
}
.work-4col-card:last-child { border-right: none; }
.work-4col-card:hover { background: rgba(255,255,255,.03); }
.work-4col-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 2px;
  background: var(--sage);
  transform: scaleY(0);
  transform-origin: bottom;
  transition: transform .3s ease;
}
.work-4col-card:hover::before { transform: scaleY(1); }
.work-4col-tag {
  font-family: 'DM Mono', monospace;
  font-size: .64rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: .9rem;
}
.work-4col-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.45rem;
  font-weight: 400;
  color: var(--cream);
  line-height: 1.2;
  margin-bottom: 1.1rem;
}
.work-4col-desc {
  font-size: .82rem;
  color: rgba(244,239,230,.70);
  line-height: 1.78;
  flex: 1;
  margin-bottom: 1.75rem;
}
.work-4col-desc ul {
  list-style: none;
  padding: 0;
  margin-top: .65rem;
}
.work-4col-desc ul li {
  padding: .15rem 0 .15rem .85rem;
  position: relative;
}
.work-4col-desc ul li::before {
  content: '·';
  position: absolute;
  left: 0;
  color: var(--sage-light);
}
.work-4col-link {
  font-family: 'DM Mono', monospace;
  font-size: .65rem;
  letter-spacing: .15em;
  text-transform: uppercase;
  color: var(--sage-light);
  text-decoration: none;
  margin-top: auto;
  transition: color .2s;
}
.work-4col-link:hover { color: var(--sage); }
.work-decision-bridge {
  grid-column: span 2;
  display: grid;
  grid-template-columns: minmax(0,1.28fr) minmax(12rem,.72fr);
  gap: clamp(2rem,4vw,4rem);
  padding: 2.25rem 2rem 2.4rem;
}
.work-decision-intro h3 {
  max-width: 13ch;
  margin: 0 0 1.4rem;
  font-family: 'Cormorant Garamond',serif;
  font-size: 1.65rem;
  font-weight: 400;
  line-height: 1.12;
  color: var(--cream);
}
.work-decision-intro {
  display: flex;
  flex-direction: column;
  padding-left: clamp(1.5rem,3vw,2.75rem);
  border-left: 1px solid rgba(255,255,255,.12);
}
.work-decision-all,
.work-decision-tool a {
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  font-family: 'DM Mono',monospace;
  font-size: .65rem;
  letter-spacing: .15em;
  text-transform: uppercase;
  color: var(--sage-light);
  text-decoration: none;
}
.work-decision-all:hover,
.work-decision-tool a:hover { color: var(--sage); }
.work-decision-all {
  align-self: flex-start;
  margin-top: auto;
  padding: .7rem 1rem;
  background: var(--sage-light);
  color: var(--ink);
}
.work-decision-all:hover { background: var(--sage); color: var(--ink); }
.work-decision-tools { border-top: 1px solid rgba(255,255,255,.12); }
.work-decision-tool {
  display: grid;
  grid-template-columns: minmax(0,1fr) auto;
  gap: 1.5rem;
  align-items: center;
  padding: 1.15rem 0;
  border-bottom: 1px solid rgba(255,255,255,.12);
}
.work-decision-tool h4 {
  margin: 0 0 .35rem;
  font-family: 'Cormorant Garamond',serif;
  font-size: 1.3rem;
  font-weight: 400;
  line-height: 1.15;
  color: var(--cream);
}
.work-decision-tool p {
  max-width: 43ch;
  margin: 0;
  font-size: .82rem;
  line-height: 1.7;
  color: rgba(244,239,230,.74);
}
@media (max-width: 1024px) {
  .work-bottom-4col { grid-template-columns: 1fr 1fr; }
  .work-decision-bridge { grid-column: 1 / -1; }
}
@media (max-width: 600px) {
  .work-bottom-4col { grid-template-columns: 1fr; }
  .work-4col-card { border-right: none; border-bottom: 1px solid rgba(255,255,255,.08); }
  .work-decision-bridge { grid-template-columns: 1fr; gap: 1.5rem; padding: 2rem 1.5rem 2.2rem; }
  .work-decision-intro { padding-left: 0; border-left: none; }
