---
import '@fontsource/cormorant-garamond/latin-600-italic.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import BusinessArtwork from '../components/BusinessArtwork.astro';
import ServiceWatermark from '../components/ServiceWatermark.astro';
import HomepageTools from '../components/HomepageTools.astro';
import HomepageAbout from '../components/HomepageAbout.astro';
import HomepageWriting from '../components/HomepageWriting.astro';
import InstagramSection from '../components/InstagramSection.astro';
import {
  contactLink,
} from '../data/siteContent';
---

<BaseLayout
  title="Technology Costs, Tools & Automation | Cloud & Capital"
  description="Diana Molski analyses cloud, AI and software costs, reviews workflows, and builds tools and automations for business owners and teams. Explore free tools and guides."
>
  <main class="home" id="main-content">
    <section class="hero" aria-labelledby="home-title">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Technology costs · Tools &amp; automation</p>
          <h1 id="home-title"><span class="hero-heading-phrase">Understand the bill.</span> <em>Simplify the work.</em></h1>
          <p class="hero-lede">I’m Diana. I analyse cloud, AI and software costs, and build tools and automations that help businesses understand their spending and simplify their work.</p>
          <p class="hero-context">For business owners and growing teams. Try a free tool, read a guide, or bring me a cost or workflow problem.</p>
          <p class="hero-byline">Diana Molski · Finance analyst &amp; tool builder</p>
          <div class="hero-actions">
            <a class="button button-primary" href="/services" data-analytics-event="cta_click" data-analytics-destination="services" data-analytics-source="homepage_hero">Explore the services</a>
            <div class="hero-tools-cta">
              <a class="button hero-secondary" href="/tools" data-analytics-event="cta_click" data-analytics-destination="work" data-analytics-source="homepage_hero">Try the tools</a>
              <img class="hero-free-note" src="/images/free-tools-note.svg" alt="They’re free!" width="164" height="82" decoding="async" />
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <BusinessArtwork />
        </div>
      </div>
    </section>

    <section class="paths" id="services" aria-labelledby="paths-title">
      <div class="shell">
        <div class="section-heading paths-heading" data-reveal>
          <div><p class="eyebrow">A few places to start</p><h2 id="paths-title">What could we make easier?</h2></div>
        </div>
        <div class="path-grid">
          <a class="path-card" href="/services#technology-cost-review" data-reveal data-analytics-event="cta_click" data-analytics-destination="services" data-analytics-source="homepage_path_business">
            <div class="path-card-header">
              <h3 class="card-label">Technology costs</h3>
              <ServiceWatermark kind="cost" />
            </div>
            <p class="path-question">Why does the bill <span class="question-emphasis">keep growing?</span></p>
            <p>Understand what drives your cloud, AI or software bill and which changes deserve a closer look.</p>
            <span class="path-action"><span>Explore a cost review</span><span class="link-arrow" aria-hidden="true">→</span></span>
          </a>
          <a class="path-card path-card-tint" href="/services#workflow-review" data-reveal data-analytics-event="cta_click" data-analytics-destination="services" data-analytics-source="homepage_path_workflow">
            <div class="path-card-header">
              <h3 class="card-label">Workflows</h3>
              <ServiceWatermark kind="workflow" />
            </div>
            <p class="path-question">Still doing this <span class="question-emphasis">by hand?</span></p>
            <p>Work through repeated reporting, follow-ups or copying between apps, and identify a better way to handle it.</p>
            <span class="path-action"><span>Explore a workflow review</span><span class="link-arrow" aria-hidden="true">→</span></span>
          </a>
          <a class="path-card" href="/services#custom-tools" data-reveal data-analytics-event="cta_click" data-analytics-destination="services" data-analytics-source="homepage_path_setup">
            <div class="path-card-header">
              <h3 class="card-label">Custom tools</h3>
              <ServiceWatermark kind="setup" />
            </div>
            <p class="path-question">Can you help me <span class="question-emphasis">build it?</span></p>
            <p>From calculators and indicators to AI agents and dashboards, I build around what you need the tool to do.</p>
            <span class="path-action"><span>Explore custom builds</span><span class="link-arrow" aria-hidden="true">→</span></span>
          </a>
        </div>
        <p class="service-scope-note">One question or project to start. We agree the scope, quote and next steps before work begins.</p>
      </div>
    </section>

    <HomepageTools />

    <HomepageAbout />

    <HomepageWriting />

    <InstagramSection />

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="site-shell contact-inner" data-reveal>
        <p class="eyebrow eyebrow-gold">Get in touch</p>
        <h2 id="contact-title"><span>What would you like</span> <span>to make easier?</span></h2>
        <div class="contact-copy">
          <p>Tell me about the bill, workflow or tool you have in mind. A few lines are enough.</p>
          <a class="contact-email-card" href={contactLink.href} data-analytics-event="cta_click" data-analytics-destination="contact" data-analytics-source="homepage_contact">
            <span class="contact-email-label">Email Diana</span>
            <span class="contact-email-address">diana@<wbr />cloudandcapital.com</span>
            <span class="contact-email-circle" aria-hidden="true"><span class="contact-email-arrow">→</span></span>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.documentElement.classList.add('reveal-ready');
  const revealItems = document.querySelectorAll('[data-reveal]');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12 });
    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  }
</script>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { background: #f5eee9; color: #191714; }
  .home { overflow: hidden; font-family: 'Jost', system-ui, sans-serif; }
  #tools, #writing, #about, #contact { scroll-margin-top: 5rem; }
  .shell { width: min(calc(100% - 4rem), 78rem); margin-inline: auto; }
  h1, h2, h3, p { margin: 0; }
  h1, h2, h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400; text-wrap: balance; }
  p { text-wrap: pretty; }
  a { color: inherit; }
  :global(.reveal-ready) [data-reveal] { opacity: 0; transform: translateY(1.1rem); transition: opacity .7s ease, transform .7s ease; }
  :global(.reveal-ready) [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
  .eyebrow,
  .card-label {
    font-family: 'DM Mono', monospace;
    font-size: .61rem;
    font-weight: 400;
    letter-spacing: .16em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .eyebrow { display: flex; align-items: center; gap: .75rem; color: #4f7567; }
  .eyebrow::after { content: ''; width: 2.7rem; height: 1px; background: currentColor; opacity: .42; }
  .eyebrow-light { color: #b4c8bf; }
  .eyebrow-gold { color: #ddb977; }
  .button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: .82rem 1.2rem;
    border: 1px solid transparent;
    font-family: 'DM Mono', monospace;
    font-size: .62rem;
    letter-spacing: .12em;
    line-height: 1.4;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform .18s ease, background .18s ease, color .18s ease, border-color .18s ease;
  }
  .button:hover { transform: translateY(-2px); }
  .button:focus-visible,
  .text-action:focus-visible,
  .path-card a:focus-visible,
  .tool-card a:focus-visible,
  .small-tool:focus-visible { outline: 2px solid currentColor; outline-offset: .3rem; }
  .button-primary { background: #4f7167; color: #f5eee9; }
  .button-primary:hover { background: #45675e; }
  .button-white { background: #f5eee9; color: #2b2622; }
  .button-white:hover { background: #fff; }
  .text-action {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    padding: .35rem 0 .42rem;
    font-family: 'DM Mono', monospace;
    font-size: .61rem;
    letter-spacing: .11em;
    line-height: 1.5;
    text-transform: uppercase;
    text-decoration: none;
  }
  .text-action > span:first-child { position: relative; }
  .text-action > span:first-child::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(.28);
    transform-origin: left;
    transition: transform .22s ease;
  }
  .text-action:hover > span:first-child::after, .text-action:focus-visible > span:first-child::after { transform: scaleX(1); }
  .text-action > span:last-child { transition: transform .22s ease; }
  .text-action:hover > span:last-child { transform: translateX(.16rem); }
  .text-action-dark { color: #2e4e44; }
  .text-action-light { color: #b9cec5; }

  .hero { padding: clamp(7.6rem, 10vw, 9rem) 0 clamp(4.25rem, 7vw, 6rem); background: #f5eee9; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(3rem, 7vw, 6.5rem); align-items: center; }
  .hero-copy h1 { max-width: 15ch; margin-top: 0; font-size: clamp(3.7rem, 5.55vw, 5.75rem); line-height: .93; letter-spacing: -.042em; }
  .hero-heading-phrase, .hero-copy h1 em, .service-name-phrase { display: inline-block; max-width: 100%; }
  .scribbled-word { position: relative; display: inline-block; font-style: italic; color: #3d6055; white-space: nowrap; }
  .scribbled-word svg { position: absolute; left: -.08em; right: -.08em; bottom: -.16em; width: calc(100% + .16em); height: .28em; overflow: visible; }
  .scribbled-word path { fill: none; stroke: #c29260; stroke-width: 2.2; stroke-linecap: round; opacity: .75; stroke-dasharray: 260; stroke-dashoffset: 260; animation: scribble-in 1.1s ease forwards 1s; }
  .scribbled-word path:last-child { opacity: .42; animation-delay: 1.22s; }
  .hero-lede { max-width: 58ch; margin-top: 1.6rem; color: #4a4a4a; font-size: 1rem; line-height: 1.78; }
  .hero-byline { margin-top: 1.15rem; color: #6c665f; font-family: 'DM Mono', monospace; font-size: .6rem; letter-spacing: .11em; line-height: 1.5; text-transform: uppercase; }
  .hero-actions,
  .contact-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.4rem; margin-top: 1.8rem; }
  .hero-visual { min-width: 0; padding: .75rem .5rem 1.25rem; }
  @media (min-width: 1280px) {
    .hero-visual { width: min(calc(100% + 75px), 660px); justify-self: end; align-self: end; margin-block: -24px -20px; position: relative; top: 0; }
  }
  .hero-actions .button { min-height: 48px; border-radius: 8px; padding: .9rem 1.25rem; color: #f5eee9; }
  .hero-actions { align-items: flex-end; }
  .hero-actions .button:focus-visible { outline-color: #3d6055; }
  .hero-actions .hero-secondary:focus-visible { outline-color: #8f6265; }
  .hero-actions .hero-secondary { background: var(--dusty-rose); color: #24211e; border-color: transparent; }
  .hero-actions .hero-secondary:hover { background: var(--dusty-rose-hover); }
  .hero-tools-cta { position: relative; display: inline-flex; align-items: center; flex: 0 0 auto; min-width: 0; }
  .hero-free-note { position: absolute; left: calc(100% - .6rem); top: -2.3rem; display: block; width: 8.25rem; height: auto; pointer-events: none; }
  @media (max-width: 760px) {
    .hero-copy .hero-actions { row-gap: 1.25rem; }
    .hero-tools-cta { width: 100%; padding-right: 10rem; box-sizing: border-box; }
    .hero-tools-cta .button { width: 100%; padding-inline: .625rem; }
    .hero-tools-cta .hero-free-note { left: auto; right: 1rem; top: -.5rem; }
  }
  @media (max-width: 360px) {
    .hero-tools-cta { padding-right: 8.25rem; }
    .hero-tools-cta .hero-free-note { width: 7rem; right: .5rem; }
  }

  .paths { padding: clamp(4.5rem, 7vw, 6.25rem) 0; background: #fbfaf7; }
  .section-heading { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(20rem, .9fr); gap: clamp(2.5rem, 7vw, 6.5rem); align-items: end; }
  .section-heading h2 { max-width: 18ch; margin-top: .9rem; font-size: clamp(2.65rem, 4vw, 4.2rem); line-height: .99; letter-spacing: -.035em; }
  .section-heading > p { max-width: 39ch; padding-left: 1.4rem; border-left: 2px solid rgba(107, 142, 127, .4); color: #4a4a4a; font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.08rem, 1.55vw, 1.35rem); line-height: 1.52; text-wrap: balance; }
  .path-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.15rem; margin-top: 2.25rem; }
  .path-card { position: relative; min-width: 0; min-height: 20.5rem; padding: 2rem; display: flex; flex-direction: column; border: 1px solid var(--path-rule); border-radius: 12px; box-shadow: inset 0 1px 0 rgba(255, 255, 255, .7), 0 12px 24px -16px rgba(41, 49, 39, .24); }
  .path-card-tint { background: #e8ece2; }
  .path-number { position: absolute; top: 1.875rem; right: 1.875rem; color: rgba(61, 96, 85, .22); font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(5.75rem, 7vw, 7rem); font-weight: 400; line-height: .8; letter-spacing: -.065em; pointer-events: none; }
  .card-label { color: #4f7167; }
  .path-card-header { display: grid; grid-template-columns: minmax(0, 1fr) 5.5rem; align-items: center; gap: .65rem; min-height: 5.5rem; }
  .path-card .path-question { max-width: none; margin-top: 1rem; font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.35rem, 1.7vw, 1.5rem); line-height: 1.25; letter-spacing: -.025em; text-wrap: wrap; }
  .path-card > p:not(.path-question) { max-width: 46ch; margin-top: 1rem; color: #3b3b38; font-size: .88rem; line-height: 1.7; text-wrap: balance; }
  .path-card a,
  .tool-card a { align-self: flex-start; margin-top: auto; padding-top: 1.5rem; color: #3d6055; font-family: 'DM Mono', monospace; font-size: .6rem; letter-spacing: .1em; line-height: 1.5; text-transform: uppercase; text-decoration: none; }
  .path-card a:hover,
  .tool-card a:hover { text-decoration: underline; text-underline-offset: .32rem; }
  .education-note { margin-top: 1rem; color: #79726b; font-size: .7rem; line-height: 1.55; }

  .contact-section { padding: 3.5rem 0 2rem; background: var(--dusty-rose); color: #2f2927; }
  .contact-inner { text-align: center; }
  .contact-section .eyebrow { justify-content: center; gap: .8rem; color: #2f2927; }
  .contact-section .eyebrow::before, .contact-section .eyebrow::after { content: ''; width: 2.4rem; height: 1px; background: currentColor; opacity: .3; }
  .contact-section h2 { max-width: 60rem; margin: 1.1rem auto 0; font-size: clamp(2.45rem, 3.2vw, 3.2rem); line-height: 1.06; text-wrap: balance; }
  .contact-section h2 span { display: block; }
  .contact-copy { margin-top: 1.0625rem; }
  .contact-copy > p { color: rgba(47, 41, 39, .95); font-size: .98rem; line-height: 1.8; }
  .contact-email-card { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .35rem 1.5rem; width: fit-content; max-width: 100%; min-height: 5.625rem; margin: 1.75rem auto 0; padding: 1rem 1.5rem; border-radius: 12px; background: #f5eee9; color: #2f2927; text-align: left; text-decoration: none; transition: background-color .2s ease; }
  .contact-email-card:hover { background: #f1e9e2; }
  .contact-email-card:focus-visible { outline: 2px solid #2f2927; outline-offset: 3px; }
  .contact-email-label { display: inline-flex; align-items: center; gap: .35rem; grid-column: 1; font: 500 .68rem/1.5 'DM Mono', monospace; letter-spacing: .1em; text-transform: uppercase; }
  .contact-email-address { grid-column: 1; min-width: 0; overflow-wrap: anywhere; font-size: 1.125rem; line-height: 1.4; }
  .contact-email-circle { grid-column: 2; grid-row: 1 / span 2; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #2f2927; color: #f5eee9; }
  .contact-email-arrow { font-size: 1.25rem; line-height: 1; transition: transform .2s ease; }
  .contact-email-card:hover .contact-email-arrow, .contact-email-card:focus-visible .contact-email-arrow { transform: translateX(3px); }
  .contact-section .contact-email-card, .contact-section .contact-email-card:hover, .contact-section .contact-email-card:focus-visible,
  .contact-section .contact-email-card span, .contact-section .contact-email-card:hover span, .contact-section .contact-email-card:focus-visible span { text-decoration: none; border-bottom: 0; }
  .contact-copy > p { max-width: 58ch; margin-inline: auto; text-wrap: balance; }

  @keyframes scribble-in { to { stroke-dashoffset: 0; } }
  @keyframes signal-ping { 0% { box-shadow: 0 0 0 0 rgba(201, 143, 127, .5); } 70%, 100% { box-shadow: 0 0 0 .55rem rgba(201, 143, 127, 0); } }
  @keyframes bar-breathe { 0%, 100% { transform: scaleY(.86); opacity: .72; } 50% { transform: scaleY(1); opacity: 1; } }
  @keyframes signal-draw { 0% { stroke-dashoffset: 1; } 100% { stroke-dashoffset: 0; } }

  @media (max-width: 1020px) {
    .contact-section { padding-block: 3.5rem; }
    .shell { width: min(calc(100% - 3rem), 78rem); }
    .hero-grid { grid-template-columns: 1fr; gap: 3rem; }
    .hero-copy { max-width: 48rem; }
    .hero-copy h1 { max-width: 18ch; }
    .hero-visual { width: min(100%, 39rem); }
    .section-heading { grid-template-columns: 1fr; gap: 1.8rem; }
    .section-heading > p { max-width: 58ch; }

    .tools-heading h2 { white-space: normal; }
  }

  @media (max-width: 760px) {
    .contact-section { padding-block: 2.875rem; }
    .contact-section h2 span { display: inline; }
    .shell { width: min(calc(100% - 2.5rem), 78rem); }
    .hero { padding-top: 7rem; }
    .hero-copy h1 { max-width: 15ch; font-size: clamp(2.8rem, 11vw, 4.45rem); }
    .scribbled-word { white-space: normal; }

    .path-grid,
  .tool-grid,
  .smaller-tools { grid-template-columns: 1fr; }
    .path-card { min-height: auto; padding: 2rem 0; border-right: 0; border-bottom: 1px solid rgba(25, 23, 20, .13); }
    .path-card { margin-inline: -1.25rem; padding-inline: 1.25rem; }
    .path-card a { margin-top: 1.5rem; }
    .flagship-tool { grid-template-columns: 1fr; }
    .flagship-copy { padding: 2.3rem 0; border-right: 0; }
    .flagship-window { margin: 0 0 1.25rem; }
    .tool-card { min-height: auto; padding: 2rem; border-right: 1px solid rgba(245, 238, 233, .13); border-bottom: 1px solid rgba(245, 238, 233, .13); }
    .tool-card a { margin-top: 1.5rem; }
    .smaller-tools-intro { padding: 1.6rem 0; }
    .small-tool { min-height: auto; padding: 1.55rem 0; border-top: 1px solid rgba(245, 238, 233, .13); border-left: 0; }
    .small-tool strong { top: 1.55rem; right: 0; }
  }

  @media (max-width: 480px) {
    .hero-actions { display: grid; grid-template-columns: 1fr; }
    .contact-actions { flex-direction: column; align-items: flex-start; }
    .button { width: 100%; text-align: center; }
    .contact-email-card { padding: 1rem 1.25rem; }
    .contact-email-address { font-size: 1.0625rem; }

    .section-heading h2 { font-size: clamp(2.5rem, 12vw, 3.45rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    .scribbled-word path,
    .mini-viz-top i,
    .mini-bars span,
    .market-line { animation: none; stroke-dashoffset: 0; }
    .button,
    .text-action > span:first-child::after,
    .text-action span,
    .flagship-window,
    .flagship-window img,
    .small-tool strong { transition: none; }
  }

  .paths .paths-heading { display: block; }
  .paths .paths-heading h2 { max-width: none; width: fit-content; padding-right: 1.5rem; text-wrap: balance; }


  .hero, .paths {
    --dark-rose: #82585b;
    --pale-rose: #f4ecea;
  }
  .path-card { --path-accent: #3e5946; --path-rule: #cbd6c5; --path-underline: #789382; --path-hover: #e0e7d9; --path-rule-hover: #9aaf93; transition: background-color 200ms ease, border-color 200ms ease, box-shadow 200ms ease; }
  .path-card:first-child { --path-accent: #785752; --path-rule: #dfc7c0; --path-underline: #b78384; background: #f6e7e2; --path-hover: #f0ded8; --path-rule-hover: #b48c82; }
  .path-card:last-child { --path-accent: #5c594b; --path-rule: #ded3c4; --path-underline: #a18b70; background: #f5efe5; --path-hover: #efe6d8; --path-rule-hover: #b9a68c; }
  .path-card .card-label, .path-card a { color: var(--path-accent); }
  .path-card .path-number { color: var(--path-rule); opacity: .14; }
  @media (max-width: 767px) { .path-card .path-number { font-size: 4.5rem; } }
  .path-card a:focus-visible { outline-color: var(--path-accent); }
  :global(.reveal-ready) .path-card[data-reveal] { transition: opacity .7s ease, transform .7s ease, background-color 200ms ease, border-color 200ms ease, box-shadow 200ms ease; }
  .path-card a span { display: inline-block; transition: transform 200ms ease; }
  .path-card:focus-within { background: var(--path-hover); border-color: var(--path-rule-hover); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .7), 0 16px 30px -18px rgba(41, 49, 39, .28); }
  .path-card:focus-within a span { transform: translateX(4px); }
  @media (hover: hover) {
    .path-card:hover { background: var(--path-hover); border-color: var(--path-rule-hover); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .7), 0 16px 30px -18px rgba(41, 49, 39, .28); }
    .path-card:hover a span { transform: translateX(4px); }
