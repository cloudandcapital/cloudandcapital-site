---
import '@fontsource/cormorant-garamond/latin-600.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import ServiceWatermark from '../components/ServiceWatermark.astro';
import ActionLabel from '../components/ActionLabel.astro';
import FlowText from '../components/FlowText.astro';
import FeaturedCredentials from '../components/FeaturedCredentials.astro';
import '../styles/services-page.css';

const projects = [
  {
    id: 'technology-cost-review', kind: 'cost', nameLead: 'Technology', nameEnd: 'Cost Review',
    description: 'For a cloud, AI or software bill you need to understand, or a spending decision you need to make.',
    examples: 'A breakdown tied to your records, the main cost drivers, and recommended next steps with the evidence behind them.',
    scope: [
      'We agree the accounts, workloads or vendors and the question before quoting. A review usually starts with three recent billing months, plus available usage and ownership records.',
      'I examine usage, pricing, plan changes, commitments and growth assumptions where the evidence supports them. For AI, that includes subscriptions, extra usage and the cost of getting a usable result.',
      'You receive an analysis and action plan. Account changes, migrations, complex allocation and ongoing monitoring need a separately agreed scope.',
    ],
    href: '/services/examples#cost', action: 'See a cost example', external: false,
  },
  {
    id: 'workflow-review', legacyId: 'workflow-projects', kind: 'workflow', nameLead: 'Workflow', nameEnd: 'Review',
    description: 'For reporting, follow-ups or information you keep moving between apps by hand.',
    examples: 'A map of the work, recommended improvements, and a way to check whether they help.',
    scope: [
      'Start with one recurring workflow, the apps involved and a few redacted examples. We compare a simpler process, features you already have, automation and AI.',
      'The review includes costs, checking, maintenance, a success measure and an owner. You can use the plan yourself or ask me to quote the setup.',
      'Building or changing a system is scoped separately. Time freed up is reported separately from any demonstrated cash saving.',
    ],
    href: '/services/examples#workflow', action: 'See a workflow example', external: false,
  },
  {
    id: 'custom-tools', legacyId: 'money-tools', kind: 'setup', nameLead: 'Tools &', nameEnd: 'Automation',
    description: 'For a task that needs a tool of its own, such as a tracker, calculator, AI helper or reporting automation.',
    examples: 'A working tool or automation, tested against the agreed requirements, with instructions and a walkthrough.',
    scope: [
      'We define the inputs, the result you need, and the tools or records involved. That can mean configuring an existing feature, connecting compatible apps or building a small tool.',
      'We agree what happens when information is missing, what needs human approval, and how the result will be checked.',
      'Software, hosting, AI usage, maintenance and support are discussed before building. Future changes and ongoing support are separately agreed.',
    ],
    href: '/tools/software-renewal-tracker', action: 'Try a tool I built', external: false,
  },
] as const;
const catalogServices = projects.map(project => ({ id: project.id, name: `${project.nameLead} ${project.nameEnd}`, serviceType: `${project.nameLead} ${project.nameEnd}`, description: project.description }));
const serviceCatalog = {
  '@type': 'OfferCatalog',
  '@id': 'https://cloudandcapital.com/services#catalog',
  name: 'Cloud & Capital business services',
  itemListElement: catalogServices.map(({ name, serviceType, id, description }) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service', name, serviceType, description,
      '@id': `https://cloudandcapital.com/services#${id}`,
      url: `https://cloudandcapital.com/services#${id}`,
      provider: { '@id': 'https://cloudandcapital.com/#organization' },
    },
  })),
};
const questions = [
  { question: 'Is this for a business like mine?', answer: 'The fit depends on the problem, the records available and the value of solving it. I work with business owners and teams. Tell me what you need to understand or change, and we can establish a suitable scope.' },
  { question: 'What will it cost?', answer: 'You receive an agreed scope, quote and timeline before work begins. Any software, hosting, AI usage and support costs are discussed too.' },
  { question: 'Do I need new software or AI?', answer: 'We look at your existing tools and simpler processes first. A custom build or AI feature needs to earn its place in the solution.' },
];
---
<BaseLayout title="Technology Cost Reviews, Tools & Automation | Cloud & Capital" description="Cloud, AI and software cost analysis, workflow reviews, and custom tools and automations from Diana Molski. Clear scope and a quote before work begins." structuredData={[serviceCatalog]}>
  <main id="main-content" class="business-services">
    <div class="services-opening">
    <section class="services-shell services-hero" aria-labelledby="services-title">
      <p class="service-kicker">Work with Diana</p>
      <h1 id="services-title"><span>Understand the costs.</span> <em>Make work easier.</em></h1>
      <p class="services-lede">I review cloud, AI and software costs, simplify recurring work, and build tools and automations for business owners and teams.</p>
      <a class="service-text-link" href="#offers"><ActionLabel label="Find your starting point" /></a>
    </section>
    </div>

    <section id="practical-setup" class="services-shell offers-section" aria-labelledby="offers-title">
      <h2 class="service-kicker" id="offers-title">3 ways to work together</h2>

      <div id="offers" class="service-cards">
        {projects.map(project => (
          <article id={project.id} class:list={['service-card', `${project.kind}-card`]} aria-labelledby={`${project.id}-title`}>
            {'legacyId' in project && <span id={project.legacyId} />}
            <div class="service-card-heading"><h3 id={`${project.id}-title`}>{project.nameLead} <span>{project.nameEnd}</span></h3><ServiceWatermark kind={project.kind} /></div>
            <p class="service-description">{project.description}</p>
            <p class="service-takeaway"><span>You get</span>{project.examples}</p>
            <details class="service-scope"><summary>Scope &amp; what to bring</summary><div class="scope-copy">{project.scope.map(paragraph => <p>{paragraph}</p>)}</div></details>
            <a class="service-text-link service-card-action" href={project.href} target={project.external ? '_blank' : undefined} rel={project.external ? 'noopener noreferrer' : undefined}><ActionLabel label={project.action} /></a>
          </article>
        ))}
      </div>
      <p class="project-delivery">Start with one question or project. We agree the scope, quote and next steps before work begins.</p>
    </section>

    <section class="services-shell services-about" aria-labelledby="reviewer-title">
      <img src="/images/diana-molski-portrait.png" alt="Diana Molski, founder of Cloud & Capital" width="820" height="806" loading="lazy" decoding="async" />
      <div>
        <h2 id="reviewer-title">You’ll work directly with me.</h2>
        <p>I’m Diana, a finance analyst and tool builder. My background includes a finance degree from Cal State Dominguez Hills, wealth management at Morgan Stanley, and FinOps, AWS and Azure credentials.</p>
        <a class="service-text-link" href="/#about"><ActionLabel label="More about me" /></a>
        <FeaturedCredentials />
      </div>
    </section>

    <section class="services-shell services-faq" aria-labelledby="faq-title">
      <div><p class="service-kicker">A few good questions</p><h2 id="faq-title">Before <em>we begin.</em></h2></div>
      <div class="faq-list">{questions.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
    </section>

    <section id="inquiry" class="services-contact" aria-labelledby="inquiry-title">
      <div class="services-shell contact-inner">
        <p class="service-kicker">Get in touch</p>
        <h2 id="inquiry-title">What would you like <em>to work through?</em></h2>
        <p class="contact-intro"><FlowText text="Tell me about the bill, workflow or tool you have in mind. Include the apps involved and what you want to understand or improve." /></p>
        <p class="contact-quote"><FlowText text="We’ll agree on the scope, quote and timeline before work begins." /></p>
        <a class="service-button contact-email" href="mailto:diana@cloudandcapital.com?subject=Business%20inquiry"><ActionLabel label="Email Diana" /></a>
        <details class="inquiry-draft">
          <summary>Help me draft the email</summary>
          <div class="inquiry-box"><p class="contact-privacy">Leave out financial records, passwords, and sensitive client information.</p><InquiryForm kind="business" appearance="services" /></div>
        </details>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  function revealLinkedReview() {
    const target = document.getElementById(window.location.hash.slice(1));
    const details = target?.closest('.service-card')?.querySelector('details');
    if (details) details.open = true;
  }
  revealLinkedReview();
  window.addEventListener('hashchange', revealLinkedReview);
</script>
