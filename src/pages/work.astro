---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contactLink, openSourceTools, tools } from '../data/siteContent';

const flagship = tools.find((tool) => tool.slug === 'cloud-cost-guard-lumen');
const signalAudit = tools.find((tool) => tool.slug === 'signal-audit');
const interactiveLab = tools.find((tool) => tool.slug === 'interactive-lab');
const marketTape = tools.find((tool) => tool.slug === 'market-tape');
---

<BaseLayout
  title="Work | Cloud & Capital"
  description="Tools for the decisions behind the bill. Explore Cloud & Capital systems for cloud, AI, and SaaS spend."
>
  <main id="main-content">
    <section class="work-opening" aria-labelledby="work-title">
      <div class="work-opening-grid">
        <div class="work-opening-text">
          <p class="section-label">Work</p>
          <h1 id="work-title">Tools for the decisions behind the bill.</h1>
          <p class="work-opening-copy">I build FinOps tools and decision systems for cloud, SaaS, and AI infrastructure spend. The work starts before the invoice, where architecture, commitments, and operating choices shape the bill.</p>
        </div>
        <div class="decision-diagram" aria-label="Cloud and Capital decision chain: Architecture, Commitments, and Utilization shape cost before the Invoice reports it.">
          <p class="diagram-group-label">Cost is shaped here</p>
          <div class="diagram-layers">
            <span class="diagram-connector-line" aria-hidden="true"></span>
            <span class="diagram-connector-dot" aria-hidden="true"></span>
            <span class="diagram-connector-dot" aria-hidden="true"></span>
            <span class="diagram-connector-dot" aria-hidden="true"></span>
            <div class="diagram-layer"><span>01</span><div><strong>Architecture</strong><small>compute · storage · data</small></div></div>
            <div class="diagram-layer"><span>02</span><div><strong>Commitments</strong><small>term · coverage · flexibility</small></div></div>
            <div class="diagram-layer"><span>03</span><div><strong>Utilization</strong><small>demand · idle · variance</small></div></div>
          </div>
          <div class="diagram-invoice">
            <span>04</span><div><strong>Invoice</strong><small>reported cost</small></div>
          </div>
        </div>
      </div>
    </section>

    {flagship && (
      <section class="flagship" aria-labelledby="flagship-title">
        <div class="flagship-intro">
          <p class="section-label section-label-dark">Flagship system</p>
        </div>
        <div class="flagship-grid">
          <div class="flagship-copy">
            <p class="tool-meta">{flagship.label}</p>
            <h2 id="flagship-title">Cloud Cost Guard <span>+ Lumen</span></h2>
            <p>{flagship.description}</p>
            <div class="flagship-actions">
              <a href={flagship.href} target="_blank" rel="noopener noreferrer">View live dashboard <span aria-hidden="true">→</span></a>
              <span>Cloud · AI · SaaS</span>
            </div>
          </div>
          <div class="flagship-visual" aria-label="Illustrative Cloud Cost Guard and Lumen analysis">
            <div class="lumen-panel">
              <p class="visual-kicker">Lumen analysis</p>
              <div class="lumen-exchange">
                <p class="question">What’s bleeding money right now?</p>
                <div class="analysis">
                  <strong>EC2 jumped 154% in one day, from $482 to $1,226.</strong>
                  <span>It is now the largest cost driver at 40.5% of cloud spend.<br /><br />I also found 19 unused SaaS licenses costing $242 per month. AI spend rose 12.4%, which is worth checking against token volume and model mix before it becomes the next material driver.<br /><br />Start with EC2, then validate the AI increase. Was this a planned launch or uncontrolled autoscaling?</span>
                </div>
              </div>
            </div>
            <div class="cost-shape-panel">
              <p class="visual-kicker">Current cost shape</p>
              <div class="donut" aria-hidden="true"></div>
              <p class="cost-shape-title">Tech spend by scope</p>
              <ul>
                <li><span class="dot cloud"></span><span>Cloud infrastructure</span><strong>88.1%</strong></li>
                <li><span class="dot saas"></span><span>SaaS tools</span><strong>7.6%</strong></li>
                <li><span class="dot ai"></span><span>AI / LLM</span><strong>4.3%</strong></li>
              </ul>
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="interactive-tools" aria-labelledby="interactive-title">
      <div class="section-heading">
        <p class="section-label">Decision tools</p>
        <h2 id="interactive-title">Start with the system.<br />Then work the decision.</h2>
        <p>Use the tools separately or in sequence: diagnose where cost accountability breaks down, then turn a live technology-spend question into a decision-ready brief.</p>
      </div>
      <div class="decision-suite">
        {signalAudit && (
          <article class="decision-tool">
            <div class="decision-tool-copy">
              <p class="tool-meta">01 · Assess the system</p>
              <h3>{signalAudit.title}</h3>
              <p>{signalAudit.description}</p>
              <p class="tool-outcome">Leave with the weakest link, the operating pattern behind it, and practical next moves.</p>
              <a href={signalAudit.href}>Take the Signal Audit <span aria-hidden="true">→</span></a>
            </div>
            <div class="tool-preview audit-preview" aria-label="Representative Signal Audit results showing a decision-chain score, weakest link, and next moves">
              <div class="preview-header"><span>Decision-chain diagnostic</span><strong>68</strong></div>
              <div class="audit-chain" aria-hidden="true">
                <span style="--score: 78%">Architecture</span>
                <span class="is-weak" style="--score: 42%">Commitments</span>
                <span style="--score: 71%">Utilization</span>
                <span style="--score: 66%">Ownership</span>
              </div>
              <div class="preview-result">
                <span>Weakest link</span>
                <strong>Commitments</strong>
                <small>Operating pattern · decisions made without a shared demand view</small>
              </div>
              <div class="preview-next"><span>Next moves</span><i></i><i></i></div>
            </div>
          </article>
        )}
        {interactiveLab && (
          <article class="decision-tool">
            <div class="decision-tool-copy">
              <p class="tool-meta">02 · Work the decision</p>
              <h3>{interactiveLab.title}</h3>
              <p>{interactiveLab.description}</p>
              <p class="tool-outcome">Separate facts from assumptions, compare the real options, expose the economics, and leave with a recommendation and next actions.</p>
              <a href={interactiveLab.href}>Build a Decision Brief <span aria-hidden="true">→</span></a>
            </div>
            <div class="tool-preview lab-preview" aria-label="Representative Interactive Lab brief with known facts, working assumptions, options, and recommendation">
              <div class="preview-header"><span>Cloud & Capital · Decision Brief</span><strong>03</strong></div>
              <div class="brief-columns">
                <div><span>Known facts</span><i></i><i></i><i></i></div>
                <div><span>Working assumptions</span><i></i><i></i><i></i></div>
              </div>
              <div class="option-row"><span>Option A</span><span>Option B</span><span>Option C</span></div>
              <div class="recommendation-panel"><span>Recommendation</span><strong>Stage the commitment against verified demand.</strong></div>
            </div>
          </article>
        )}
      </div>
      <p class="suite-cue">Assess the system <span aria-hidden="true">→</span> frame the decision</p>
      {marketTape && (
        <article class="market-context">
          <div>
            <p class="tool-meta">Market context</p>
            <h3>{marketTape.title}</h3>
          </div>
          <p>A live view of the rates, sectors, commodities, and risk signals shaping technology capital and infrastructure decisions.</p>
          <a href={marketTape.href} target="_blank" rel="noopener noreferrer">Open Market Tape <span aria-hidden="true">→</span></a>
        </article>
      )}
    </section>

    <section class="pipeline" aria-labelledby="pipeline-title">
      <div class="pipeline-heading">
        <p class="section-label">Open source pipeline</p>
        <h2 id="pipeline-title">The Six Tool Pipeline</h2>
        <p>Six open source FinOps tools spanning allocation, anomaly detection, resilience economics, AI spend, SaaS, and executive reporting.</p>
        <a href="https://github.com/cloudandcapital" target="_blank" rel="noopener noreferrer">View the pipeline on GitHub <span aria-hidden="true">→</span></a>
      </div>
      <ol class="pipeline-list">
        {openSourceTools.map((tool, index) => (
          <li>
            <span class="pipeline-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{tool.title}</h3>
              <p>{tool.description}</p>
            </div>
            <a href={tool.href} target="_blank" rel="noopener noreferrer" aria-label={`View ${tool.title} on GitHub`}>GitHub <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ol>
    </section>

    <section class="work-cta" aria-labelledby="work-cta-title">
      <div>
        <p class="section-label section-label-gold">Start a conversation</p>
        <h2 id="work-cta-title">Working on cloud economics, FinOps, or AI infrastructure?</h2>
      </div>
      <a href={contactLink.href}>{contactLink.label} <span aria-hidden="true">→</span></a>
    </section>
  </main>
</BaseLayout>

<style>
  main { overflow: hidden; background: #f5eee9; }
  .work-opening, .interactive-tools, .pipeline { padding: clamp(4.75rem, 9vw, 8rem) clamp(1.5rem, 5vw, 4.5rem); }
  .work-opening { padding-top: clamp(6rem, 8vw, 7rem); padding-bottom: clamp(3.75rem, 5vw, 4.75rem); }
  .work-opening-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(21rem, .95fr); gap: clamp(3rem, 8vw, 9rem); align-items: start; max-width: 88rem; }
  .section-label, .tool-meta { margin: 0 0 1.25rem; font-family: 'DM Mono', monospace; font-size: .62rem; letter-spacing: .18em; line-height: 1.5; text-transform: uppercase; color: #6b8e7f; }
  .section-label::after { content: ''; display: inline-block; width: 3rem; height: 1px; margin: 0 0 .25rem .75rem; background: currentColor; opacity: .55; }
  .work-opening h1, h2, h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 300; color: #000; }
  .work-opening h1 { max-width: 14ch; margin: 0; font-size: clamp(3.1rem, 4.4vw, 4.75rem); line-height: .98; letter-spacing: -.035em; }
  .work-opening-copy { max-width: 58ch; margin: 2rem 0 0; font-family: 'DM Sans', sans-serif; font-size: clamp(.95rem, 1.4vw, 1.08rem); line-height: 1.82; color: #4a4a4a; }
  .decision-diagram { --diagram-pad: clamp(1.35rem, 3vw, 2.6rem); --diagram-connector: .65rem; --diagram-number: clamp(3.2rem, 5vw, 4.35rem); --diagram-gap: .85rem; min-height: 29rem; margin-top: 2.55rem; padding: clamp(1.5rem, 3vw, 2.5rem) 0 0; display: flex; flex-direction: column; background: #211f1b; color: #f5eee9; border-top: 1px solid #6b8e7f; }
  .diagram-group-label { margin: 0; padding: 0 var(--diagram-pad); font-family: 'DM Mono', monospace; font-size: clamp(.62rem, 1vw, .7rem); letter-spacing: .14em; line-height: 1.5; text-transform: uppercase; color: #a8c0b5; }
  .diagram-layers { display: grid; flex: 1; grid-template-columns: var(--diagram-connector) minmax(0, 1fr); grid-template-rows: repeat(3, minmax(5.5rem, auto)); column-gap: var(--diagram-gap); margin: 1.5rem 0 1.85rem; padding: 0 var(--diagram-pad); }
  .diagram-connector-line { grid-column: 1; grid-row: 1 / 4; justify-self: center; width: 1px; margin: 1.25rem 0; background: #6b8e7f; }
  .diagram-connector-dot { grid-column: 1; align-self: center; justify-self: center; width: 4px; height: 4px; border-radius: 50%; background: #86a89a; }
  .diagram-connector-dot:nth-of-type(2) { grid-row: 1; }.diagram-connector-dot:nth-of-type(3) { grid-row: 2; }.diagram-connector-dot:nth-of-type(4) { grid-row: 3; }
  .diagram-layer { display: grid; grid-column: 2; grid-template-columns: var(--diagram-number) minmax(0, 1fr); gap: var(--diagram-gap); align-items: center; min-height: 5.5rem; padding: 1.05rem 0; border-top: 1px solid rgba(245,238,233,.16); }
  .diagram-layer:nth-of-type(1) { grid-row: 1; }.diagram-layer:nth-of-type(2) { grid-row: 2; }.diagram-layer:nth-of-type(3) { grid-row: 3; }
  .diagram-layer:last-child { border-bottom: 1px solid rgba(245,238,233,.16); }
  .diagram-layer > span, .diagram-invoice > span { font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.4rem, 4vw, 3.7rem); font-weight: 300; line-height: .8; color: #86a89a; }
  .diagram-layer strong, .diagram-invoice strong { display: block; font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.45rem, 2.2vw, 2rem); font-weight: 400; line-height: 1; color: #f5eee9; }
  .diagram-layer small, .diagram-invoice small { display: block; margin-top: .45rem; font-family: 'DM Mono', monospace; font-size: .55rem; letter-spacing: .08em; line-height: 1.55; color: rgba(245,238,233,.6); }
  .diagram-invoice { display: grid; grid-template-columns: var(--diagram-connector) var(--diagram-number) minmax(0, 1fr); column-gap: var(--diagram-gap); align-items: center; padding: 1.5rem var(--diagram-pad); background: #ede5dc; border-top: 1px solid #6b8e7f; }
  .diagram-invoice > span { grid-column: 2; }.diagram-invoice > div { grid-column: 3; }
  .diagram-invoice > span { color: #6b8e7f; }.diagram-invoice strong { color: #000; }.diagram-invoice small { color: #4a4a4a; }
  .flagship { background: #000; color: #f5eee9; padding: clamp(3rem, 5vw, 4.75rem) clamp(1.5rem, 5vw, 4.5rem) clamp(4rem, 6vw, 5.5rem); border-top: 1px solid rgba(107,142,127,.5); }
  .flagship-intro { margin-bottom: 1.4rem; }
  .section-label-dark { color: rgba(245,238,233,.68); white-space: nowrap; }
  .flagship-grid { display: grid; grid-template-columns: minmax(0, .94fr) minmax(0, 1.06fr); border-top: 2px solid #6b8e7f; border-bottom: 1px solid rgba(245,238,233,.13); }
  .flagship-copy { min-height: 31rem; padding: clamp(2.25rem, 5vw, 4.4rem) clamp(1.5rem, 4vw, 3.75rem); display: flex; flex-direction: column; justify-content: center; border-right: 1px solid rgba(245,238,233,.13); }
  .flagship-copy .tool-meta { color: #c9a961; }
  .flagship-copy h2 { margin: 0 0 1.25rem; font-size: clamp(2.55rem, 4.5vw, 4.75rem); line-height: .98; color: #f5eee9; }
  .flagship-copy h2 span { display: block; }
  .flagship-copy > p:not(.tool-meta) { max-width: 39ch; margin: 0; font-family: 'DM Sans', sans-serif; font-size: .94rem; line-height: 1.85; color: rgba(245,238,233,.74); }
  .flagship-actions { display: flex; flex-wrap: wrap; gap: 1.25rem 1.5rem; align-items: center; margin-top: 2.25rem; }
  .flagship-actions a, .decision-tool-copy > a, .market-context > a, .pipeline-heading > a, .pipeline-list a { font-family: 'DM Mono', monospace; font-size: .62rem; letter-spacing: .12em; line-height: 1.5; text-transform: uppercase; text-decoration: none; color: #6b8e7f; }
  .flagship-actions a { color: #86a89a; }
  .flagship-actions a:hover, .decision-tool-copy > a:hover, .market-context > a:hover, .pipeline-heading > a:hover, .pipeline-list a:hover { text-decoration: underline; text-underline-offset: .3em; }
  .interactive-tools a:focus-visible { outline: 2px solid #3d6055; outline-offset: .35rem; }
  .flagship-actions span { font-family: 'DM Mono', monospace; font-size: .57rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(245,238,233,.57); }
  .flagship-visual { display: grid; grid-template-columns: 1.1fr .9fr; overflow: hidden; border: 1px solid rgba(117, 96, 73, .3); border-radius: 20px; background: #f5eee9; transform: translateY(30px); }
  .lumen-panel, .cost-shape-panel { min-width: 0; padding: clamp(1.35rem, 2.4vw, 2rem); background: #f5eee9; color: #000; }
  .lumen-panel { display: flex; flex-direction: column; justify-content: center; }
  .visual-kicker { margin: 0 0 1.5rem; font-family: 'DM Mono', monospace; font-size: .56rem; letter-spacing: .14em; text-transform: uppercase; color: #6b8e7f; }
  .question { margin: 0 0 .85rem; padding: .95rem 1.1rem; border-radius: 13px; font-family: 'DM Sans', sans-serif; font-size: .82rem; line-height: 1.65; background: #e5ddd4; }
  .analysis { padding: 1.15rem 1.1rem; border: 1px solid rgba(107,142,127,.16); border-radius: 12px; font-family: 'DM Sans', sans-serif; font-size: .8rem; line-height: 1.72; color: #4a4a4a; background: #edf1ed; }
  .analysis strong { display: block; margin-bottom: .5rem; color: #000; font-weight: 500; }
  .cost-shape-panel { display: flex; flex-direction: column; border-left: 1px solid rgba(117, 96, 73, .18); }
  .donut { width: min(11rem, 100%); aspect-ratio: 1; margin: .25rem auto 1rem; border-radius: 50%; background: conic-gradient(#6b8e7f 0 88.1%, #a7b6d8 88.1% 95.7%, #c9a961 95.7% 100%); position: relative; }
  .donut::after { content: ''; position: absolute; inset: 23%; border-radius: 50%; background: #f5eee9; }
  .cost-shape-title { margin: .25rem 0 1rem; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.25rem; line-height: 1.1; }
  .cost-shape-panel ul { list-style: none; margin: auto 0 0; padding: 0; }
  .cost-shape-panel li { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: .45rem; align-items: center; padding: .52rem 0; border-top: 1px solid rgba(0,0,0,.08); font-family: 'DM Mono', monospace; font-size: .54rem; letter-spacing: .04em; line-height: 1.35; color: #4a4a4a; }
  .cost-shape-panel strong { color: #000; font-weight: 400; }
  .dot { width: .42rem; height: .42rem; border-radius: 50%; }
  .dot.cloud { background: #6b8e7f; }.dot.saas { background: #a7b6d8; }.dot.ai { background: #c9a961; }
  .interactive-tools { padding-top: clamp(3.5rem, 6.75vw, 6rem); padding-bottom: clamp(3.5rem, 6.75vw, 6rem); border-bottom: 1px solid rgba(0,0,0,.11); }
  .section-heading { max-width: 49rem; margin-bottom: clamp(2.75rem, 5vw, 4.5rem); }
  .section-heading h2, .pipeline-heading h2, .work-cta h2 { margin: 0; font-size: clamp(2.25rem, 4vw, 4rem); line-height: 1.03; letter-spacing: -.025em; }
  .section-heading > p:last-child { max-width: 62ch; margin: 1.5rem 0 0; font-family: 'DM Sans', sans-serif; font-size: .95rem; line-height: 1.8; color: #4a4a4a; }
  .decision-suite { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 2px solid #6b8e7f; border-bottom: 1px solid rgba(0,0,0,.16); }
  .decision-tool { min-width: 0; display: grid; grid-template-rows: minmax(25rem, auto) auto; }
  .decision-tool + .decision-tool { border-left: 1px solid rgba(0,0,0,.16); }
  .decision-tool-copy { padding: clamp(2rem, 4vw, 3.5rem); display: flex; flex-direction: column; }
  .decision-tool-copy .tool-meta { color: #4f7567; }
  .decision-tool-copy h3, .market-context h3 { margin: 0; font-size: clamp(2.3rem, 3.5vw, 3.75rem); line-height: .98; letter-spacing: -.025em; }
  .decision-tool-copy > p:not(.tool-meta) { max-width: 48ch; margin: 1.25rem 0 0; font-family: 'DM Sans', sans-serif; font-size: .9rem; line-height: 1.75; color: #4a4a4a; }
  .decision-tool-copy .tool-outcome { padding-top: 1.15rem; border-top: 1px solid rgba(0,0,0,.1); }
  .decision-tool-copy > a { margin-top: auto; padding-top: 2rem; }
  .tool-preview { min-height: 19rem; margin: 0 clamp(1.25rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem); padding: 1.35rem; overflow: hidden; background: #fbfaf7; border: 1px solid rgba(0,0,0,.14); font-family: 'DM Mono', monospace; color: #211f1b; }
  .preview-header { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; padding-bottom: 1rem; border-bottom: 1px solid rgba(0,0,0,.13); font-size: .54rem; letter-spacing: .12em; text-transform: uppercase; color: #6b8e7f; }
  .preview-header strong { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2rem; font-weight: 400; line-height: .7; color: #4f7567; }
  .audit-chain { display: grid; gap: .68rem; margin: 1.25rem 0; }
  .audit-chain span { position: relative; display: grid; grid-template-columns: 7.5rem 1fr; gap: .75rem; align-items: center; font-size: .52rem; letter-spacing: .07em; text-transform: uppercase; }
  .audit-chain span::after { content: ''; height: 3px; background: linear-gradient(to right, #6b8e7f var(--score), #e2ddd6 var(--score)); }
  .audit-chain .is-weak { color: #8a6536; }.audit-chain .is-weak::after { background: linear-gradient(to right, #c9a961 var(--score), #e2ddd6 var(--score)); }
  .preview-result { padding: 1rem; background: #edf1ed; border-left: 2px solid #6b8e7f; }
  .preview-result span, .preview-next span, .brief-columns span, .recommendation-panel span { display: block; font-size: .5rem; letter-spacing: .12em; text-transform: uppercase; color: #6b8e7f; }
  .preview-result strong { display: block; margin-top: .35rem; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.5rem; font-weight: 400; }
  .preview-result small { display: block; margin-top: .35rem; font-family: 'DM Sans', sans-serif; font-size: .68rem; line-height: 1.45; color: #555; }
  .preview-next { display: grid; grid-template-columns: 5rem 1fr 1fr; gap: .65rem; align-items: center; margin-top: 1rem; }.preview-next i, .brief-columns i { display: block; height: 1px; background: rgba(0,0,0,.18); }
  .brief-columns { display: grid; grid-template-columns: repeat(2, 1fr); margin: 1.25rem 0; border: 1px solid rgba(0,0,0,.12); }
  .brief-columns > div { min-height: 6.5rem; padding: .9rem; }.brief-columns > div + div { border-left: 1px solid rgba(0,0,0,.12); }
  .brief-columns i { margin-top: .7rem; }.brief-columns i:last-child { width: 72%; }
  .option-row { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(0,0,0,.13); border-bottom: 1px solid rgba(0,0,0,.13); }
  .option-row span { padding: .75rem .5rem; font-size: .5rem; letter-spacing: .1em; text-transform: uppercase; text-align: center; }.option-row span + span { border-left: 1px solid rgba(0,0,0,.13); }
  .recommendation-panel { margin-top: 1.2rem; padding: 1rem; background: #3d6055; color: #fff; }
  .recommendation-panel span { color: rgba(255,255,255,.62); }.recommendation-panel strong { display: block; margin-top: .5rem; font-family: 'DM Sans', sans-serif; font-size: .75rem; font-weight: 400; line-height: 1.45; }
  .suite-cue { margin: 1.4rem 0 2.75rem; font-family: 'DM Mono', monospace; font-size: .58rem; letter-spacing: .12em; text-transform: uppercase; color: #6b8e7f; text-align: center; }
  .suite-cue span { padding: 0 .55rem; color: #c9a961; }
