---
interface Props { label: string; }
const { label } = Astro.props;
---
<span class="action-label"><span>{label}</span><span class="action-arrow" aria-hidden="true">→</span></span>
<style>
  .action-label { display: inline-flex; align-items: center; gap: .45rem; min-height: 50px; font: 500 .75rem/1.4 'DM Mono', monospace; letter-spacing: .015em; text-transform: uppercase; }
  .action-label > span:first-child { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .28rem; }
  .action-arrow { display: inline-block; flex: 0 0 1.25rem; width: 1.25rem; font: 500 1.25rem/1 'DM Mono', monospace; text-align: center; text-decoration: none; }
</style>
