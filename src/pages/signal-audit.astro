---
import BaseLayout from "../layouts/BaseLayout.astro";
import SignalAuditResults from "../components/SignalAuditResults.astro";
---

<BaseLayout
  title="Technology Cost Signal Audit | Cloud & Capital"
  description="Set a scope, answer 12 questions, and receive a practical profile of how technology cost moves from data to decision."
>
  <main class="audit-main">
    <header class="hero rail">
      <p class="eyebrow">Cloud &amp; Capital · Diagnostic</p>
      <h1>The Technology Cost <em>Signal Audit</em></h1>
      <p class="dek">
        Set a scope, answer 12 questions, and receive a practical profile of how
        technology cost moves from data to decision.
      </p>
      <div class="meta">
        <span>12 questions</span><span>5 minutes</span><span>No sign-up</span
        ><span>Immediate results</span>
      </div>
    </header>

    <section id="auditStage" class="stage" aria-labelledby="stageTitle">
      <div id="liveStatus" class="sr-only" aria-live="polite"></div>
      <form id="auditForm" novalidate>
        <div id="setupPanel" class="panel setup-panel">
          <p class="step-label">Set the boundary</p>
          <h2 id="stageTitle">What are you assessing?</h2>
          <p class="intro">
            Choose a useful boundary. Your choices personalize examples and
            guidance; they do not affect the score.
          </p>
          <fieldset>
            <legend>Assessment scope</legend><div
              id="targetScopes"
              class="choices"
            >
            </div>
          </fieldset>
          <fieldset>
            <legend
              >Which technology spend is in scope? <span
                >Select one or more</span
              ></legend
            ><div id="technologyScopes" class="choices compact"></div>
          </fieldset>
          <p id="setupError" class="error" role="alert"></p>
          <div class="controls end">
            <button
              class="button primary"
              type="button"
              id="beginButton"
              disabled
              >Begin the audit <span aria-hidden="true">→</span></button>
          </div>
        </div>

        <div id="questionPanel" class="panel question-panel" hidden>
          <div class="progress-head">
            <div>
              <p id="dimensionName" class="step-label"></p><p
                id="progressText"
                class="progress-text"
              >
              </p>
            </div><span id="questionNumber" class="question-number"></span>
          </div>
          <div id="segments" class="segments" aria-hidden="true"></div>
          <fieldset id="questionFieldset">
            <legend id="questionPrompt"></legend><p
              id="questionExample"
              class="question-example"
            >
            </p><div id="answerChoices" class="choices answers"></div>
          </fieldset>
          <p id="answerError" class="error" role="alert"></p>
          <div class="controls">
            <button class="button secondary" type="button" id="previousButton"
              >← Previous</button
            ><button
              class="button primary"
              type="button"
              id="nextButton"
              disabled>Next →</button>
          </div>
        </div>
      </form>
    </section>

    <SignalAuditResults />
  </main>

  <script>
    import {
      DIMENSIONS,
      QUESTIONS,
      TARGET_SCOPES,
      TECHNOLOGY_SCOPES,
      fallbackInterpretation,
      scoreAudit,
    } from "../lib/signal-audit.js";
    const $ = (id) => document.getElementById(id);
    const state = {
      targetScope: "",
      technologyScopes: [],
      answers: {},
      index: 0,
      result: null,
    };
    const createChoice = (item, type, name) =>
      `<label class="choice"><input type="${type}" name="${name}" value="${item.id}"><span>${item.label}</span></label>`;
    $("targetScopes").innerHTML = TARGET_SCOPES.map((item) =>
      createChoice(item, "radio", "target-scope"),
    ).join("");
    $("technologyScopes").innerHTML = TECHNOLOGY_SCOPES.map((item) =>
      createChoice(item, "checkbox", "technology-scope"),
    ).join("");
    $("segments").innerHTML = DIMENSIONS.map(
      (item) => `<span title="${item.name}"></span>`,
    ).join("");
    const announce = (text) => {
      $("liveStatus").textContent = text;
    };
    const labelFor = (items, id) =>
      items.find((item) => item.id === id)?.label || id;

    function renderQuestion() {
      const question = QUESTIONS[state.index];
      const dimensionIndex = DIMENSIONS.findIndex(
        (item) => item.id === question.dimension,
      );
      const dimension = DIMENSIONS[dimensionIndex];
      $("dimensionName").textContent = dimension.name;
      $("progressText").textContent =
        `Question ${state.index + 1} of ${QUESTIONS.length}`;
      $("questionNumber").textContent = String(state.index + 1).padStart(
        2,
        "0",
      );
      $("questionPrompt").textContent = question.prompt;
      $("questionExample").textContent = question.example;
      $("questionExample").hidden = !question.example;
      const displayOptions = [
        ...question.options.filter((option) => option.score !== null).reverse(),
        ...question.options.filter((option) => option.score === null),
      ];
      $("answerChoices").innerHTML = displayOptions
        .map(
          (option) =>
            `<label class="choice answer${option.score === null ? " unscored" : ""}"><input type="radio" name="answer" value="${option.id}" ${state.answers[question.id] === option.id ? "checked" : ""}><span>${option.label}</span></label>`,
        )
        .join("");
      [...$("segments").children].forEach((segment, index) => {
        segment.className =
          index < dimensionIndex
            ? "done"
            : index === dimensionIndex
              ? "active"
              : "";
      });
      $("previousButton").textContent =
        state.index === 0 ? "← Back to scope" : "← Previous";
      $("nextButton").textContent =
        state.index === QUESTIONS.length - 1 ? "See my signal map →" : "Next →";
      $("nextButton").disabled = !state.answers[question.id];
      $("answerError").textContent = "";
      $("questionFieldset").focus({ preventScroll: true });
      announce(`${dimension.name}. Question ${state.index + 1} of 12.`);
    }
    function updateSetupButton() {
      $("beginButton").disabled =
        !document.querySelector('input[name="target-scope"]:checked') ||
        !document.querySelector('input[name="technology-scope"]:checked');
    }
    $("auditForm").addEventListener("change", (event) => {
      const changedInput = event.target;
      if (!(changedInput instanceof HTMLInputElement)) return;
      if (
        changedInput.matches(
          'input[name="target-scope"], input[name="technology-scope"]',
        )
      )
        updateSetupButton();
      if (changedInput.matches('input[name="answer"]'))
        $("nextButton").disabled = false;
    });
    $("beginButton").addEventListener("click", () => {
      const target = document.querySelector(
        'input[name="target-scope"]:checked',
      );
      const tech = [
        ...document.querySelectorAll('input[name="technology-scope"]:checked'),
      ];
      if (!target || !tech.length) {
        $("setupError").textContent =
          "Choose one assessment scope and at least one technology category.";
        updateSetupButton();
        return;
      }
      state.targetScope = target.value;
      state.technologyScopes = tech.map((input) => input.value);
      $("setupPanel").hidden = true;
      $("questionPanel").hidden = false;
      renderQuestion();
      $("auditStage").scrollIntoView({ behavior: "smooth", block: "start" });
    });
    $("nextButton").addEventListener("click", () => {
      const selected = document.querySelector('input[name="answer"]:checked');
      if (!selected) {
        $("answerError").textContent =
          "Choose an answer, including outside my visibility if appropriate.";
        return;
      }
      state.answers[QUESTIONS[state.index].id] = selected.value;
      if (state.index < QUESTIONS.length - 1) {
        state.index++;
        renderQuestion();
      } else showResults();
    });
    $("previousButton").addEventListener("click", () => {
      const selected = document.querySelector('input[name="answer"]:checked');
      if (selected) state.answers[QUESTIONS[state.index].id] = selected.value;
      if (state.index === 0) {
        $("questionPanel").hidden = true;
        $("setupPanel").hidden = false;
        $("stageTitle").focus?.();
      } else {
        state.index--;
        renderQuestion();
      }
    });

    const discussionFor = (id) =>
      ({
        "signal-clarity": [
          "Which material spend still lacks a useful owner or driver?",
          "How quickly can we explain the last meaningful variance?",
          "What evidence would make the next forecast more decision-ready?",
        ],
        "economic-context": [
          "Which unit best connects our largest cost to value?",
          "What material category or dependency is missing from our full-cost view?",
          "Which decision would change if this unit measure were visible?",
        ],
        "decision-timing": [
          "What is the next material choice we can influence before commitment?",
          "Which assumptions and alternatives should be visible at that point?",
          "Who needs decision-relevant economics—not more detail—to choose well?",
        ],
        "operating-response": [
          "Who can act when the next material signal appears?",
          "What response time and decision rights are appropriate?",
          "Where will we record the choice, owner, and outcome?",
        ],
      })[id];
    function participantSafeCopy(value) {
      return value
        .replace(/zero[- ]score axis/gi, "lowest-confidence area")
        .replace(/zero[- ]score/gi, "lowest-confidence");
    }
    function renderInterpretation(value) {
      $("patternRead").textContent = participantSafeCopy(value.pattern_read);
      $("decisionImplication").textContent = participantSafeCopy(
        value.decision_implication,
      );
      $("scopeWatchpoint").textContent = participantSafeCopy(
        value.scope_watchpoint,
      );
    }
    async function showResults() {
      state.result = scoreAudit(state.answers);
      const result = state.result;
      const fallback = fallbackInterpretation(result, {
        targetScope: labelFor(TARGET_SCOPES, state.targetScope),
        technologyScopes: state.technologyScopes.map((id) =>
          labelFor(TECHNOLOGY_SCOPES, id),
        ),
      });
      renderInterpretation(fallback);
      $("auditStage").hidden = true;
      $("results").hidden = false;
      $("resultTitle").textContent = result.archetype.name;
      $("resultMeaning").textContent = result.archetype.meaning;
      $("scopeLabel").textContent = labelFor(TARGET_SCOPES, state.targetScope);
      $("technologyLabel").textContent = state.technologyScopes
        .map((id) => labelFor(TECHNOLOGY_SCOPES, id))
        .join(" · ");
      $("confidenceLabel").textContent =
        `${result.answeredCount}/12 scored answers · ${result.confidence}% evidence coverage`;
      $("axisSignalScore").textContent =
        result.axes.signalReadiness === null
          ? "—"
          : `${result.axes.signalReadiness}%`;
      $("axisDecisionScore").textContent =
        result.axes.decisionIntegration === null
          ? "—"
          : `${result.axes.decisionIntegration}%`;
      $("evidenceScore").textContent = `${result.confidence}%`;
      if (result.valid) {
        $("mapPoint").style.left = `${result.axes.signalReadiness}%`;
        $("mapPoint").style.bottom = `${result.axes.decisionIntegration}%`;
        $("mapDescription").textContent =
          `Signal Readiness ${result.axes.signalReadiness}%. Decision Integration ${result.axes.decisionIntegration}%. Pattern: ${result.archetype.name}.`;
      } else {
        $("mapPoint").hidden = true;
        $("mapDescription").textContent =
          "Limited Visibility: both axes require valid scores in their component dimensions and at least eight scored answers overall.";
      }
      $("dimensionCards").innerHTML = DIMENSIONS.map((dimension) => {
        const item = result.dimensions[dimension.id];
        const score = item.score ?? 0;
        return `<article class="profile-row${dimension.id === result.weakest ? " priority" : ""}"><div class="profile-row-head"><h5>${dimension.name}</h5><strong class="profile-row-score">${item.score === null ? "—" : `${item.score}%`}</strong></div><p class="profile-row-description">${dimension.description}</p><div class="profile-track" aria-hidden="true"><span style="width:${score}%"></span></div><div class="profile-row-meta"><span>${item.label}</span><span>${item.answered} of 3 answered</span></div></article>`;
      }).join("");
      const strongest =
        DIMENSIONS.find((item) => item.id === result.strongest)?.name ||
        "Needs more evidence";
      const weakest = DIMENSIONS.find(
        (item) => item.id === result.weakest,
      )?.name;
      $("strongestFinding").textContent = strongest;
      $("priorityFinding").textContent = weakest;
      $("moveTitle").textContent = result.priority.title;
      $("moveText").textContent = result.priority.move;
      $("ownerText").textContent = result.priority.owners;
      $("measureText").textContent = result.priority.measures.join(" · ");
      $("discussionQuestions").innerHTML = discussionFor(result.weakest)
        .map((text) => `<li>${text}</li>`)
        .join("");
      $("results").scrollIntoView({ behavior: "smooth", block: "start" });
      $("resultTitle").focus?.();
      try {
        const response = await fetch("/api/signal-audit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            targetScope: state.targetScope,
            technologyScopes: state.technologyScopes,
            answers: state.answers,
          }),
        });
        const data = await response.json();
        if (data.interpretation) renderInterpretation(data.interpretation);
        $("aiStatus").textContent =
          data.source === "ai"
            ? "AI context added"
            : "Deterministic interpretation";
      } catch {
        $("aiStatus").textContent = "Deterministic interpretation";
      }
    }
    $("printButton").addEventListener("click", () => window.print());
    async function copyResultSummary(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const temporary = document.createElement("textarea");
        temporary.value = text;
        temporary.setAttribute("readonly", "");
        temporary.style.position = "fixed";
        temporary.style.opacity = "0";
        document.body.appendChild(temporary);
        temporary.select();
        const copied = document.execCommand("copy");
        temporary.remove();
        return copied;
      }
    }
    $("copyButton").addEventListener("click", async () => {
      const text = `${$("resultTitle").textContent}\n${$("mapDescription").textContent}\n30-day move: ${$("moveText").textContent}\nKPI: ${$("measureText").textContent}`;
      if (await copyResultSummary(text)) {
        $("copyButton").textContent = "Copied";
        setTimeout(() => ($("copyButton").textContent = "Copy Summary"), 1800);
      }
    });
    $("retakeButton").addEventListener("click", () => {
      state.answers = {};
      state.index = 0;
      state.result = null;
      $("results").hidden = true;
      $("auditStage").hidden = false;
      $("setupPanel").hidden = false;
      $("questionPanel").hidden = true;
      $("mapPoint").hidden = false;
      updateSetupButton();
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  </script>

  <style is:global>
    :global(body) {
      background: #f3ede5;
      color: #1d1a17;
      font-family: "DM Sans", sans-serif;
    }
    .audit-main {
      padding: 7rem 1.5rem 6rem;
    }
    .rail,
    .stage {
      width: min(100%, 1080px);
      margin-inline: auto;
    }
    .hero {
      padding: 3.5rem 1rem 2.5rem;
    }
    .eyebrow,
    .step-label,
    .meta,
    .progress-text,
    .question-number {
      font-family: "DM Mono", monospace;
      text-transform: uppercase;
      letter-spacing: 0.13em;
      font-size: 0.66rem;
    }
    .eyebrow {
      color: #516b5c;
    }
    .hero h1,
    .panel h2,
    fieldset > legend {
      font-family: "Cormorant Garamond", serif;
      font-weight: 400;
    }
    .hero h1 {
      font-size: clamp(3rem, 7vw, 5.4rem);
      line-height: 0.93;
      max-width: 800px;
      margin: 0.8rem 0 1.25rem;
    }
    .hero em {
      color: #516b5c;
    }
    .dek {
      max-width: 670px;
      font-size: 1.12rem;
      line-height: 1.65;
      color: #4d4842;
    }
    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.75rem;
      margin-top: 1.8rem;
      color: #6b6258;
    }
    .stage {
      max-width: 940px;
    }
    .panel {
      background: #fbf8f3;
      border: 1px solid #d8cec1;
      padding: clamp(1.5rem, 5vw, 4rem);
      box-shadow: 0 12px 35px rgba(52, 39, 26, 0.05);
    }
    .panel h2 {
      font-size: clamp(2.3rem, 5vw, 3.8rem);
      margin: 0.3rem 0;
    }
    .intro {
      color: #645d55;
      margin: 0 0 2rem;
      max-width: 650px;
    }
    fieldset {
      border: 0;
      padding: 0;
      margin: 2rem 0;
      min-width: 0;
    }
    fieldset > legend {
      font-size: 1.55rem;
      margin-bottom: 1rem;
    }
    legend span {
      font: 400 0.62rem "DM Mono";
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #716b64;
      margin-left: 0.5rem;
    }
    .choices {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.65rem;
    }
    .choice {
      display: block;
      position: relative;
      cursor: pointer;
    }
    .choice input {
      position: absolute;
      opacity: 0;
      inset: 0;
    }
    .choice span {
      display: flex;
      align-items: center;
      min-height: 58px;
      padding: 0.85rem 1rem 0.85rem 2.8rem;
      border: 1px solid #d8cec1;
      background: #fff;
      line-height: 1.4;
    }
    .choice span:before {
      content: "";
      position: absolute;
      left: 1rem;
      width: 16px;
      height: 16px;
      border: 1px solid #8c8175;
      border-radius: 50%;
    }
    .choice input[type="checkbox"] + span:before {
      border-radius: 2px;
    }
    .choice input:checked + span {
      border-color: #607969;
      background: #edf1eb;
      box-shadow: inset 3px 0 #607969;
    }
    .choice input:checked + span:after {
      content: "";
      position: absolute;
      left: 1.32rem;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #405b4b;
    }
    .choice input[type="checkbox"]:checked + span:after {
      border-radius: 0;
    }
    .choice input:focus-visible + span {
      outline: 3px solid #c78655;
      outline-offset: 2px;
    }
    .controls {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 2rem;
    }
    .controls.end {
      justify-content: flex-end;
    }
    .button {
      border: 1px solid #3b4f43;
      padding: 0.9rem 1.25rem;
      font: 500 0.7rem "DM Mono";
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      color: #26372d;
    }
    .button.primary {
      background: #3b4f43;
      color: white;
    }
    .button:hover {
      transform: translateY(-1px);
    }
    .error {
      color: #8c3e2c;
      min-height: 1.5em;
    }
    .progress-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }
    .question-number {
      font-size: 2rem;
      color: #998d80;
    }
    .segments {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.5rem;
      margin: 1rem 0 3rem;
    }
    .segments span {
      height: 4px;
      background: #ddd4c9;
    }
    .segments .done {
      background: #97aa9d;
    }
    .segments .active {
      background: #405b4b;
    }
    .question-panel fieldset > legend {
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      line-height: 1.15;
      max-width: 760px;
    }
    .question-example {
      color: #6b6258;
      font-size: 0.88rem;
      max-width: 680px;
    }
    .answers {
      grid-template-columns: 1fr;
    }
    .answer span {
      padding-left: 3.5rem;
      min-height: 70px;
    }
    .answer b {
      position: absolute;
      left: 1rem;
      font: 400 0.68rem "DM Mono";
      color: #6b6258;
    }
    .answer span:before {
      left: 2.25rem;
    }
    .answer input:checked + span:after {
      left: 2.57rem;
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    [hidden] {
      display: none !important;
    }
    @media (max-width: 760px) {
      .audit-main {
        padding: 5rem 0.75rem 3rem;
      }
      .hero {
        padding: 2.5rem 0.5rem 1.5rem;
      }
      .choices {
        grid-template-columns: 1fr;
      }
      .panel {
        padding: 1.25rem;
      }
      .meta {
        gap: 0.6rem 1rem;
      }
      .controls {
        align-items: stretch;
      }
      .button {
        padding: 0.85rem 0.75rem;
      }
      .answers .choice span {
        font-size: 0.9rem;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      * {
        scroll-behavior: auto !important;
        transition: none !important;
        animation: none !important;
      }
      .button:hover {
        transform: none;
      }
    }
    @media print {
      :global(.site-nav),
      :global(footer),
      .hero,
      #auditStage,
      .audit-main {
        padding: 0;
        background: #fff;
      }
      .results-rail {
        width: 100%;
      }
    }
  </style>
  <style is:global>
    /* Shared audit grid: hero copy and every panel use one outer rail and inset. */
    .audit-main {
      --audit-rail: 1080px;
      --audit-inset: 52px;
      padding: 5.25rem 1.5rem 6rem;
    }
    .audit-main .rail,
    .audit-main .stage,
    .audit-main .results-rail {
      width: min(100%, var(--audit-rail));
      max-width: var(--audit-rail);
      margin-inline: auto;
    }
    .audit-main .stage,
    .audit-main .results-rail {
      scroll-margin-top: 5.25rem;
    }
    .audit-main .hero {
      padding: 2.25rem var(--audit-inset) 2rem;
    }
    .audit-main .hero h1 {
      width: min(100%, 790px);
      max-width: 790px;
      margin: 0.65rem 0 1rem;
      font-size: clamp(4.5rem, 5.45vw, 4.95rem);
      line-height: 0.92;
      letter-spacing: -0.025em;
    }
    .audit-main .hero .dek {
      max-width: 680px;
      margin: 0;
      color: #3f3a35;
      font-family: "DM Sans", sans-serif;
      font-size: 1.05rem;
      line-height: 1.55;
    }
    .audit-main .meta {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      margin-top: 1.5rem;
      padding-block: 0.85rem;
      border-top: 1px solid #cfc5b9;
      border-bottom: 1px solid #cfc5b9;
      color: #504a44;
      font-size: 0.67rem;
    }
    .audit-main .meta span {
      padding-inline: 1rem;
      text-align: center;
      border-left: 1px solid #d8cec2;
    }
    .audit-main .meta span:first-child {
      padding-left: 0;
      text-align: left;
      border-left: 0;
    }
    .audit-main .meta span:last-child {
      padding-right: 0;
      text-align: right;
    }
    .audit-main .panel {
      min-height: 0;
      padding: 48px var(--audit-inset) 52px;
      border: 1px solid #d3c8bb;
      border-top: 3px solid #607969;
      box-shadow: none;
    }
    .audit-main .setup-panel h2 {
      margin: 0.25rem 0 0.6rem;
      font-size: clamp(3rem, 3.75vw, 3.5rem);
