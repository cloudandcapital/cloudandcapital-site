---
const { labelled = false } = Astro.props;
const credentials = [
  {
    image: '/images/claude-partner-badge-claude-code.png',
    alt: 'Claude Partner Badge, Claude Code, issued by Anthropic',
    width: 650,
    height: 650,
    label: 'Claude Partner Badge',
    name: 'Claude Code',
  },
  {
    image: '/images/finops-certified-practitioner.png',
    alt: 'FinOps Certified Practitioner badge, issued by The Linux Foundation',
    width: 600,
    height: 600,
    label: 'FinOps Certified',
    name: 'Practitioner',
  },
];
---
<div class:list={['featured-credentials', { 'featured-credentials-labelled': labelled }]} aria-label="Featured professional credentials">
  {credentials.map(credential => (
    labelled ? <div class="featured-credential-item">
      <img class="featured-credential" src={credential.image} alt={credential.alt} width={credential.width} height={credential.height} loading="lazy" decoding="async" />
      <div class="featured-credential-copy"><p class="featured-credential-label">{credential.label}</p><p class="featured-credential-name">{credential.name}</p></div>
    </div> : <img class="featured-credential" src={credential.image} alt={credential.alt} width={credential.width} height={credential.height} loading="lazy" decoding="async" />
  ))}
</div>
<style>
  .featured-credentials { display: flex; align-items: center; justify-content: center; gap: clamp(1.5rem, 3vw, 2.25rem); margin: 1.25rem auto 1.5rem; }
  .featured-credential { display: block; flex: none; width: 6rem; height: 6rem; object-fit: contain; }
  .featured-credentials-labelled { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem; margin: 1.25rem 0 1.5rem; }
  .featured-credential-item { display: flex; align-items: center; gap: 1.5rem; min-width: 0; padding: 1rem 0; }
  .featured-credential-copy { min-width: 0; }
  .featured-credential-label { margin: 0; color: #cbdad0; font: 400 .61rem/1.6 'DM Mono', monospace; letter-spacing: .07em; text-transform: uppercase; }
  .featured-credential-name { margin: .35rem 0 0; color: #faf6ef; font: 400 1.75rem/1.15 'Cormorant Garamond', Georgia, serif; }
  @media (max-width: 760px) {
    .featured-credentials-labelled { grid-template-columns: minmax(0, 1fr); gap: .5rem; }
    .featured-credential-item { gap: 1.25rem; }
  }
  @media (max-width: 560px) {
    .featured-credentials { margin-block: 1.25rem 1.5rem; }
    .featured-credential { width: 5.25rem; height: 5.25rem; }
  }
</style>
