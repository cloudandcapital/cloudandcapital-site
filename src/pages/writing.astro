---
import BaseLayout from '../layouts/BaseLayout.astro';
import { newsletter, writing, writingFeatured } from '../data/siteContent';

const archive = writing.slice(1);
---

<BaseLayout
  title="Writing | Cloud & Capital"
  description="Research and field notes on cloud economics, AI infrastructure, technology spend, and capital allocation."
>
  <main id="main-content">
    <section class="writing-hero" aria-labelledby="writing-title">
      <div class="writing-hero-grid">
        <div class="writing-hero-copy">
          <p class="section-label">Writing</p>
          <h1 id="writing-title">Cloud economics, AI infrastructure, and the decisions behind the bill.</h1>
          <p>Research and field notes on technology spend, capital allocation, and the operating choices shaping the bill.</p>
        </div>
        <div class="manuscript-visual" aria-label="Cloud and Capital annotated research manuscript">
          <div class="manuscript-paper">
            <p class="manuscript-label">Research note</p>
            <p class="manuscript-subject">Cloud economics / AI infrastructure</p>
            <div class="manuscript-lines" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <p class="manuscript-fragment">capital follows capacity</p>
            <p class="manuscript-fragment manuscript-fragment-offset">cost reveals the decision later</p>
          </div>
          <aside class="manuscript-annotation">
            <p>Margin annotation</p>
            <em>capital allocation<br />utilization risk</em>
          </aside>
          <p class="manuscript-meta">C&amp;C research desk · issue file</p>
        </div>
      </div>
    </section>

    <section class="newsletter-feature" aria-labelledby="newsletter-title">
      <div class="newsletter-feature-inner">
        <div>
          <p class="section-label section-label-light">{newsletter.label}</p>
          <h2 id="newsletter-title">{newsletter.title}</h2>
        </div>
        <div class="newsletter-feature-detail">
          <p>{newsletter.description}</p>
          <div class="newsletter-actions">
            <a href={newsletter.subscribeHref} target="_blank" rel="noopener noreferrer">Subscribe on Substack <span aria-hidden="true">→</span></a>
            <a href={newsletter.latestIssueHref} target="_blank" rel="noopener noreferrer">Latest issue <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="featured-article" aria-labelledby="featured-title">
      <div class="featured-article-heading">
        <p class="section-label">Featured</p>
      </div>
      <a class="featured-article-link" href={writingFeatured.href} target="_blank" rel="noopener noreferrer">
        <div class="featured-article-copy">
          <p class="article-meta">{writingFeatured.date} <span>{writingFeatured.topic}</span></p>
          <h2 id="featured-title">{writingFeatured.title}</h2>
          <p>{writingFeatured.description}</p>
          <span>READ ARTICLE <span aria-hidden="true">→</span></span>
        </div>
        <div class="featured-article-image">
          <img src={writingFeatured.image} alt={writingFeatured.imageAlt} />
        </div>
      </a>
    </section>

    <section class="writing-archive" aria-labelledby="archive-title">
      <div class="archive-heading">
        <p class="section-label">Archive</p>
        <h2 id="archive-title">Recent writing.</h2>
      </div>
      <div class="archive-grid">
        {archive.map((article) => (
          <a href={article.href} target="_blank" rel="noopener noreferrer" class="archive-entry">
            <div class="archive-image">
              <img src={article.archiveImage} alt={article.archiveImageAlt} loading="lazy" />
            </div>
            <div class="archive-copy">
              <p class="article-meta">{article.date} <span>{article.topic}</span></p>
              <h3>{article.title}</h3>
            </div>
            <div class="archive-summary">
              <p>{article.description}</p>
              <span class="archive-link">READ ARTICLE <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="writing-cta" aria-labelledby="writing-cta-title">
      <div>
        <p class="section-label section-label-gold">Follow the signal</p>
        <h2 id="writing-cta-title">Cloud economics, AI infrastructure, and the decisions worth watching.</h2>
      </div>
      <a href={newsletter.subscribeHref} target="_blank" rel="noopener noreferrer">Subscribe on Substack <span aria-hidden="true">→</span></a>
    </section>
  </main>
</BaseLayout>

<style>
  main { overflow: hidden; background: #f5eee9; }
  .writing-hero, .featured-article, .writing-archive { padding: clamp(4.5rem, 8vw, 7.5rem) clamp(1.5rem, 5vw, 4.5rem); }
  .writing-hero { padding: clamp(4.75rem, 9vw, 8rem) clamp(1.5rem, 5vw, 4.5rem); padding-top: clamp(6rem, 8vw, 7rem); padding-bottom: clamp(3.75rem, 5vw, 4.75rem); }
  .writing-hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(21rem, .95fr); gap: clamp(3rem, 8vw, 9rem); align-items: start; max-width: 88rem; }
  .section-label { margin: 0 0 1.25rem; font-family: 'DM Mono', monospace; font-size: .62rem; letter-spacing: .18em; line-height: 1.5; text-transform: uppercase; color: #6b8e7f; }
  .section-label::after { content: ''; display: inline-block; width: 3rem; height: 1px; margin: 0 0 .25rem .75rem; background: currentColor; opacity: .55; }
  .writing-hero h1, h2, h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 300; color: #000; }
  .writing-hero h1 { max-width: 14ch; margin: 0; font-size: clamp(3.1rem, 4.4vw, 4.75rem); line-height: .98; letter-spacing: -.035em; }
  .writing-hero-copy > p:last-child { max-width: 58ch; margin: 2rem 0 0; font-family: 'DM Sans', sans-serif; font-size: clamp(.95rem, 1.4vw, 1.08rem); line-height: 1.82; color: #4a4a4a; }
  .manuscript-visual { position: relative; min-height: 29rem; padding: clamp(1.35rem, 2.5vw, 2.25rem); overflow: hidden; background: #71685e; border-top: 1px solid #6b8e7f; }
  .manuscript-paper { position: relative; width: min(82%, 24rem); min-height: 22rem; padding: clamp(1.4rem, 2.8vw, 2.25rem); background: #fbfaf7; border: 1px solid rgba(33,31,27,.14); }
  .manuscript-label, .manuscript-subject, .manuscript-meta, .manuscript-annotation > p { margin: 0; font-family: 'DM Mono', monospace; font-size: .57rem; letter-spacing: .13em; line-height: 1.5; text-transform: uppercase; }
  .manuscript-label { color: #55796c; }
  .manuscript-subject { margin-top: .55rem; color: #514c45; }
  .manuscript-lines { position: absolute; top: 5.15rem; right: clamp(1.4rem, 2.8vw, 2.25rem); left: clamp(1.4rem, 2.8vw, 2.25rem); display: grid; grid-template-rows: repeat(6, 1fr); height: 12.2rem; }
  .manuscript-lines span { border-top: 1px solid rgba(33,31,27,.1); }
  .manuscript-fragment { width: max-content; max-width: 100%; margin: 5.1rem 0 0; padding: .13rem .3rem; background: rgba(221,185,119,.55); font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.3rem, 2vw, 1.75rem); line-height: 1.1; color: #211f1b; }
  .manuscript-fragment-offset { margin-top: 2.55rem; margin-left: clamp(.6rem, 4vw, 2.5rem); background: rgba(168,192,181,.48); }
  .manuscript-annotation { position: absolute; right: clamp(1.25rem, 2.6vw, 2.25rem); bottom: clamp(3.5rem, 7vw, 5.75rem); max-width: 14ch; margin: 0; color: #302c27; }
  .manuscript-annotation > p { margin-bottom: .35rem; color: #55796c; }
  .manuscript-annotation em { font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1rem, 1.6vw, 1.3rem); line-height: 1.08; }
  .manuscript-meta { position: absolute; left: clamp(1.35rem, 2.5vw, 2.25rem); bottom: 1.55rem; color: #3d6055; }
  .newsletter-feature { padding: clamp(4rem, 7vw, 6.5rem) clamp(1.5rem, 5vw, 4.5rem); background: #000; color: #f5eee9; }
  .newsletter-feature-inner { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(17rem, .9fr); gap: clamp(3rem, 8vw, 9rem); max-width: 88rem; }
  .section-label-light { color: #ddb977; }.section-label-light::after { opacity: .4; }
  .newsletter-feature h2 { max-width: 18ch; margin: 0; font-size: clamp(2.4rem, 4.275vw, 4.5rem); line-height: .99; color: #f5eee9; }
  .newsletter-feature-detail { display: flex; flex-direction: column; justify-content: end; }
  .newsletter-feature-detail > p { max-width: 44ch; margin: 0; font-family: 'DM Sans', sans-serif; font-size: .94rem; line-height: 1.85; color: rgba(245,238,233,.68); }
  .newsletter-actions { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2rem; }
  .newsletter-actions a, .featured-article-copy > span, .archive-link { font-family: 'DM Mono', monospace; font-size: .62rem; letter-spacing: .12em; line-height: 1.5; text-transform: uppercase; text-decoration: none; }
  .newsletter-actions a:first-child { padding: .9rem 1.2rem; background: #6b8e7f; color: #fff; }
  .newsletter-actions a:last-child { padding: .9rem 1.2rem; border: 1px solid rgba(245,238,233,.32); color: #f5eee9; }
  .newsletter-actions a:hover { background: #86a89a; border-color: #86a89a; }
  .featured-article { padding-top: clamp(3.25rem, 4.5vw, 4.25rem); padding-bottom: clamp(3rem, 5vw, 4.5rem); background: #fbfaf7; }
  .featured-article-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; margin-bottom: 1.75rem; }
  .featured-article-heading > p:last-child { margin: 0; font-family: 'DM Mono', monospace; font-size: .58rem; letter-spacing: .14em; text-transform: uppercase; color: #8b8b8b; }
  .featured-article-link { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); gap: clamp(2.25rem, 5vw, 4.5rem); padding: clamp(2.15rem, 3vw, 2.75rem) 0 clamp(2rem, 3.25vw, 2.75rem); border-top: 2px solid #6b8e7f; border-bottom: 1px solid rgba(0,0,0,.13); color: inherit; text-decoration: none; }
  .featured-article-copy { padding: clamp(1.5rem, 3vw, 2.75rem) clamp(1.5rem, 5vw, 4.5rem) clamp(1.75rem, 3vw, 2.75rem) 0; display: flex; flex-direction: column; justify-content: flex-start; }
  .article-meta { margin: 0 0 .9rem; font-family: 'DM Mono', monospace; font-size: .58rem; letter-spacing: .13em; line-height: 1.5; text-transform: uppercase; color: #6b8e7f; }
  .article-meta span::before { content: '·'; margin: 0 .5rem; color: #b88c45; }
  .featured-article-copy h2 { max-width: 15ch; margin: 0 0 1.25rem; font-size: clamp(2.5rem, 4.2vw, 4.45rem); line-height: .99; }
  .featured-article-copy > p { max-width: 38ch; margin: 0; font-family: 'DM Sans', sans-serif; font-size: .93rem; line-height: 1.83; color: #4a4a4a; }
  .featured-article-copy > span { margin-top: 2.25rem; color: #3d6055; }
  .featured-article-image { height: clamp(26.25rem, 30vw, 28.125rem); overflow: hidden; background: #ebe3db; }
  .featured-article-image img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
  .featured-article-link:hover .featured-article-image img { transform: scale(1.025); }
  .featured-article-link:hover .featured-article-copy > span { text-decoration: underline; text-underline-offset: .3em; }
  .writing-archive { background: #f5eee9; border-top: 1px solid rgba(0,0,0,.1); }
  .archive-heading { max-width: 46rem; margin-bottom: 3.25rem; }
  .archive-heading h2, .writing-cta h2 { margin: 0; font-size: clamp(2.25rem, 4vw, 4rem); line-height: 1.03; letter-spacing: -.025em; }
  .archive-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2.75rem, 4vw, 4rem) clamp(2rem, 4vw, 4.5rem); border-top: 1px solid rgba(0,0,0,.16); padding-top: clamp(2rem, 3vw, 2.75rem); }
  .archive-entry { display: grid; grid-template-columns: clamp(11.25rem, 15vw, 13.75rem) minmax(0, 1fr); column-gap: clamp(1rem, 2vw, 1.5rem); align-items: start; min-width: 0; color: inherit; text-decoration: none; }
  .archive-image { aspect-ratio: 4 / 3; overflow: hidden; background: #e6ddd4; }
  .archive-image img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
  .archive-entry:hover .archive-image img { transform: scale(1.025); }
  .archive-copy { min-width: 0; }
  .archive-entry h3 { margin: 0; font-size: clamp(1.5rem, 2.2vw, 2rem); line-height: 1.04; }
  .archive-summary { grid-column: 2; padding-top: .9rem; }
  .archive-summary > p { max-width: 40ch; margin: 0; font-family: 'DM Sans', sans-serif; font-size: .86rem; line-height: 1.7; color: #4a4a4a; }
  .archive-link { display: inline-block; padding-top: 1.15rem; color: #3d6055; white-space: nowrap; }
  .archive-entry:hover .archive-link { text-decoration: underline; text-underline-offset: .3em; }
  .writing-cta { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: end; padding: clamp(3.75rem, 7vw, 6rem) clamp(1.5rem, 5vw, 4.5rem); background: #3d6055; }
  .section-label-gold { color: #ddb977; }.section-label-gold::after { opacity: .4; }
  .writing-cta h2 { max-width: 24ch; color: #fff; }
  .writing-cta > a { padding: .95rem 1.3rem; background: #fff; color: #3d6055; font-family: 'DM Mono', monospace; font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; text-decoration: none; white-space: nowrap; }
  .writing-cta > a:hover { background: #f5eee9; }
  @media (max-width: 900px) {
    .writing-hero-grid, .newsletter-feature-inner, .featured-article-link { grid-template-columns: 1fr; }
    .writing-hero-grid { gap: 0; }.manuscript-visual { width: min(100%, 42rem); margin-top: 3rem; }
    .newsletter-feature-detail { justify-content: start; }.featured-article-copy { padding: 2.5rem 0; }.featured-article-image { height: 25rem; order: -1; }
  }
  @media (max-width: 720px) {
    .writing-hero h1 { max-width: 12ch; }.writing-hero, .featured-article, .writing-archive { padding-left: 1.25rem; padding-right: 1.25rem; }
    .newsletter-feature { padding-left: 1.25rem; padding-right: 1.25rem; }.featured-article-heading { display: block; }.featured-article-heading > p:last-child { margin-top: .75rem; }
    .archive-grid { grid-template-columns: 1fr; gap: 2.5rem; }.archive-entry { grid-template-columns: clamp(7.5rem, 32vw, 8.75rem) minmax(0, 1fr); column-gap: 1rem; }.archive-summary { grid-column: 1 / -1; padding-top: 1rem; }.archive-link { padding-top: 1rem; }
    .writing-cta { grid-template-columns: 1fr; align-items: start; padding-left: 1.25rem; padding-right: 1.25rem; }.writing-cta > a { justify-self: start; }
  }
  @media (max-width: 480px) {
    .writing-hero { padding-top: 6.75rem; }.writing-hero h1 { font-size: clamp(2.85rem, 14vw, 4rem); }.newsletter-actions { flex-direction: column; }.newsletter-actions a { text-align: center; }
    .manuscript-visual { min-height: 25rem; margin-top: 2.5rem; }.manuscript-paper { min-height: 18rem; }.manuscript-annotation { right: 1rem; bottom: 3.35rem; }
    .featured-article-image { height: 18rem; }.featured-article-copy { padding-top: 2rem; padding-bottom: 2.5rem; }
  }
</style>
