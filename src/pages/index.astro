}

/* Visual: no fade — clean sharp boundary between chart and content */
.wf-visual-fade { display: none !important; }
.wf-visual {
  border-bottom: 1px solid rgba(255,255,255,.08) !important;
}

/* Featured card: block so inner grid can stretch to full row height */
.writing-featured {
  display: block !important;
}
/* Two-column inner layout: text left, image right */
.wf-inner {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: stretch;
  height: 100%;
  min-height: 280px;
}
/* Image: subtle inset so it feels intentionally placed, not slammed against grid */
.wf-img-wrap {
