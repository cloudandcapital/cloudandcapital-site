<script>
  document.querySelectorAll<HTMLElement>('[data-hero-artwork]').forEach((artwork) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        artwork.classList.add('has-entered');
        observer.disconnect();
      }
    }, { threshold: .2 });
    observer.observe(artwork);
  });
</script>

<style>
  .artwork-stack { position: relative; isolation: isolate; min-width: 0; }
  .artwork-stack::before { content: ''; position: absolute; inset: 12px -5px -12px 12px; z-index: -1; border-radius: 22px; border: 1px solid rgba(105, 130, 107, .18); background: #dfe5da; transform: rotate(2deg); }
  .artwork-paper { position: relative; border: 1px solid rgba(105, 130, 107, .22); border-radius: 21px; background: linear-gradient(135deg, #fffdf8, #f4f0e7); box-shadow: 0 28px 65px -22px rgba(38, 54, 44, .3), 0 5px 15px rgba(38, 54, 44, .04); }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  text { font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-weight: 400; }
  .word { font-size: 38px; fill: #3d6055; }
  .costs { fill: #836b51; }
  .ai { font-size: 43px; fill: #46584c; }
  .entry { font-size: 30px; fill: #a77c59; }
  .bar { transform-box: fill-box; transform-origin: center bottom; }
  .has-entered .bar { animation: rise .5s ease both; animation-delay: var(--delay); }
  .has-entered .pivot { animation: draw .5s ease both; }
  .has-entered .candle { animation: appear .3s ease both; animation-delay: var(--delay); }
  .has-entered .connection { animation: draw .6s ease .25s both; }
  .has-entered .node { animation: appear .3s ease .8s both; }
  .has-entered .entry { animation: appear .3s ease 1.1s both; }
  @keyframes appear { from { opacity: 0; } to { opacity: 1; } }
  .has-entered .annotation { animation: draw .35s ease 1s both; }
  .has-entered .arrow { animation-delay: 1.12s; }
  @keyframes draw { from { stroke-dasharray: 1; stroke-dashoffset: 1; } to { stroke-dasharray: 1; stroke-dashoffset: 0; } }
  @keyframes rise { from { transform: scaleY(.05); opacity: 0; } to { transform: scaleY(1); opacity: 1; } }
  @media (max-width: 480px) { .word { font-size: 42px; } .ai { font-size: 46px; } .entry { font-size: 32px; } }
  @media (prefers-reduced-motion: reduce) { .artwork-stack * { animation: none !important; transition: none !important; } }
</style>
