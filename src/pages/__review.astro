---
const width = ['390', '768', '1024'].includes(Astro.url.searchParams.get('width') ?? '') ? Astro.url.searchParams.get('width') : '390';
---
<html lang="en"><head><meta charset="utf-8" /><meta name="robots" content="noindex,nofollow" /><title>Responsive review</title></head><body style="margin:0;background:#e8e8e8;font-family:system-ui"><header style="padding:10px;text-align:center"><a href="?width=390">390px</a> · <a href="?width=768">768px</a> · <a href="?width=1024">1024px</a></header><iframe src="/" title="Responsive homepage preview" style={`display:block;border:0;width:${width}px;height:840px;margin:0 auto;background:white;`}></iframe></body></html>
