---
import ActionLabel from './ActionLabel.astro';
import FlowText from './FlowText.astro';
import type { DirectoryTool } from '../data/toolDirectory';
interface Props { tool: DirectoryTool; }
const { tool } = Astro.props;
---
<article class="directory-card" data-tone={tool.tone} aria-labelledby={`${tool.slug}-name`}>
  <div class="card-preview">
    <div class="preview-window">
      <div class="preview-bar" aria-hidden="true"><i></i><i></i><i></i>{tool.imageLabel && <span>{tool.imageLabel}</span>}</div>
      <img src={tool.image} alt={tool.imageAlt} width={tool.imageWidth} height={tool.imageHeight} loading="lazy" decoding="async" />
    </div>
  </div>
  <div class="card-copy">
    <p class="card-kind">{tool.kind}</p>
    <h3 id={`${tool.slug}-name`}>{tool.name.startsWith('Software Renewal') ? <Fragment>Software <span class="name-phrase">{tool.name.replace('Software ', '')}</span></Fragment> : tool.name}</h3>
    <p class="card-description"><FlowText text={tool.description} /></p>
    <dl>
      <div><dt>You bring</dt><dd><FlowText text={tool.bring} /></dd></div>
      <div><dt>You get</dt><dd><FlowText text={tool.result} /></dd></div>
    </dl>
    {tool.companion && <a class="card-resource" href={tool.companion.href} data-analytics-event="cta_click" data-analytics-destination="work" data-analytics-source="work_decision_tools">{tool.companion.label}</a>}
    {tool.availability === 'review' ? <p class="review-status">Update in progress</p> : <a class="card-action" href={tool.href} target={tool.external ? '_blank' : undefined} rel={tool.external ? 'noopener noreferrer' : undefined} data-analytics-event="cta_click" data-analytics-destination={tool.destination} data-analytics-source={tool.source}><ActionLabel label={tool.action} /></a>}
  </div>
</article>
<style>
  .directory-card { --preview-tint: var(--theme-panel, #e4e9df); --card-accent: var(--theme-green, #3d6055); --card-surface: var(--cream); position: relative; isolation: isolate; display: flex; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid var(--theme-line, #d8d8ce); border-radius: 16px; background: var(--card-surface); color: var(--brand-ink); text-decoration: none; box-shadow: 0 12px 28px -22px #24211e55; transition: border-color 180ms ease, box-shadow 180ms ease; }
  .directory-card[data-tone="rose"] { --preview-tint: var(--theme-rose-panel, #eddbd6); --card-accent: var(--theme-rose, #785752); border-color: var(--theme-line, #dfc7c0); }
  .directory-card[data-tone="sand"] { --preview-tint: var(--cream); --card-accent: var(--theme-sand, #6a5e4d); border-color: var(--theme-line, #dcd0bd); }
  .directory-card[data-filter-tone="sage"] { --preview-tint: var(--theme-panel, #e4e9df); --card-accent: var(--theme-green, #3d6055); --card-surface: var(--theme-panel, #f0f3ec); border-color: var(--theme-line, #c2cdbb); }
  .directory-card[data-filter-tone="sand"] { --preview-tint: var(--cream); --card-accent: var(--theme-sand, #675844); --card-surface: var(--cream); border-color: var(--theme-line, #d3c6b1); }
  .directory-card[data-filter-tone="rose"] { --preview-tint: var(--theme-rose-panel, #eddbd6); --card-accent: var(--theme-rose, #785752); --card-surface: var(--theme-panel, #f6eae7); border-color: var(--theme-line, #d6b8b2); }
  .card-preview { display: grid; place-items: center; flex: none; aspect-ratio: 1.4; min-width: 0; overflow: hidden; padding: 1.25rem; background: var(--preview-tint); }
  .preview-window { display: grid; grid-template-rows: 19px minmax(0, 1fr); width: 100%; height: 100%; min-height: 0; overflow: hidden; border: 1px solid var(--theme-line, #e7e4df); border-radius: 8px; background: var(--theme-panel, #fff); box-shadow: 0 17px 23px -12px #26372d59, 0 2px 5px #26372d0a; transition: transform 220ms ease, box-shadow 220ms ease; }
  .preview-bar { display: flex; align-items: center; gap: 4px; min-height: 19px; padding-inline: 8px; border-bottom: 1px solid var(--theme-line, #24211e12); background: var(--theme-panel, #fff); }
  .preview-bar i { width: 4px; height: 4px; border-radius: 50%; background: var(--theme-sand-panel, #bbb4a8); }
  .preview-bar span { margin-left: auto; color: var(--theme-muted, #625d55); font: 400 .5rem/1.3 'DM Mono', monospace; }
  .preview-window img { display: block; width: 100%; height: 100%; min-height: 0; object-fit: contain; background: var(--theme-panel, #fff); }
  .card-copy { display: flex; flex-direction: column; flex: 1; min-width: 0; padding: 1.5rem; }
  .card-kind, dt { margin: 0; color: var(--card-accent); font: 500 .61rem/1.5 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
  h3 { margin: .65rem 0 0; font: italic 400 clamp(2.15rem, 2.7vw, 2.75rem)/1.05 'Cormorant Garamond', Georgia, serif; letter-spacing: -.025em; text-wrap: balance; }
  .name-phrase { display: inline-block; max-width: 100%; }
  .card-description { margin: .9rem 0 0; color: var(--theme-muted, #4a4a42); font-size: .9375rem; line-height: 1.7; text-wrap: pretty; }
  dl { display: grid; gap: .9rem; margin: 1.25rem 0 1.15rem; padding-top: 1.1rem; border-top: 1px solid var(--theme-line, #3d605521); }
  dd { margin: .3rem 0 0; color: var(--theme-muted, #494b43); font-size: .875rem; line-height: 1.65; text-wrap: pretty; }
  .review-status { align-self: center; margin-top: auto; padding-block: .8rem; color: var(--card-accent); font-size: .875rem; }
  .card-action { display: inline-flex; align-self: center; justify-content: center; margin-top: auto; color: var(--card-accent); text-align: center; text-decoration: none; }
  .card-action::after { content: ''; position: absolute; inset: 0; z-index: 1; border-radius: 16px; }
  .card-action:focus-visible { outline: none; }
  .card-action:focus-visible::after { outline: 3px solid var(--theme-line-strong, #89534f); outline-offset: -4px; }
  .card-resource { position: relative; z-index: 2; display: inline-flex; align-items: center; justify-content: center; align-self: center; min-height: 44px; margin: -.5rem 0 .5rem; color: var(--card-accent); font-size: .8rem; line-height: 1.5; text-align: center; text-underline-offset: 3px; }
  .card-resource:focus-visible { outline: 3px solid var(--theme-line-strong, #89534f); outline-offset: 3px; }
  .card-action :global(.action-label) { font-size: .7rem; }
  .card-action :global(.action-arrow) { transition: transform 180ms ease; }
  .directory-card:hover { border-color: var(--card-accent); box-shadow: 0 18px 32px -22px #24211e66; }
  .directory-card:hover .preview-window { transform: translateY(-3px); box-shadow: 0 21px 25px -13px #26372d66; }
  .directory-card:is(:hover, :focus-within) :global(.action-arrow) { transform: translateX(3px); }
  @media (max-width: 1020px) {
    .card-copy { padding: 1.25rem; }
    .card-preview { padding: 1rem; }
    h3 { font-size: clamp(2rem, 3.7vw, 2.6rem); }
  }
  @media (max-width: 760px) {
    h3 { font-size: clamp(2rem, 9vw, 2.6rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .directory-card, .preview-window, .card-action :global(.action-arrow) { transition: none; }
    .directory-card:hover .preview-window, .directory-card:is(:hover, :focus-within) :global(.action-arrow) { transform: none; }
  }
</style>
