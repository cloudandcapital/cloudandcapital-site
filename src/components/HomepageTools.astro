---
import ActionLabel from './ActionLabel.astro';
import { tools } from '../data/siteContent';
const lens = tools.find(tool => tool.slug === 'ai-cost-lens');
const guard = tools.find(tool => tool.slug === 'cloud-cost-guard-lumen');
const choices = [
  lens && { goal: 'Understand my AI costs.', name: 'AI Cost Lens', category: 'AI spending', description: 'Estimate an AI task, review a bill, or compare options using the numbers you have.', result: 'A clear cost breakdown, including review and rework time when you add it.', href: lens.href, action: 'Open AI Cost Lens', destination: 'ai_cost_lens', external: true, image: '/images/ai-cost-lens-anatomy-preview.jpg', imageAlt: 'AI Cost Lens example comparing model, infrastructure, and human review costs for two AI routes', imageWidth: 1315, imageHeight: 492 },
  guard && { goal: 'Find out why the bill grew.', name: 'Cloud Cost Guard', category: 'Technology spending · Demo', description: 'Explore a sample cloud, AI, and software bill, with the records behind each total.', result: 'See what drove the costs and which questions deserve a closer look.', href: guard.href, action: 'Explore the demo', destination: 'cloud_cost_guard', external: true, image: '/images/cloud-cost-guard-summary-preview.jpg', imageAlt: 'Cloud Cost Guard screen showing reconciled cloud, AI, and software spending', imageWidth: 1216, imageHeight: 474 },
  { goal: 'Keep track of renewals.', name: 'Software Renewal Tracker', category: 'Software subscriptions', description: 'Add your software charges, renewal dates, and cancellation deadlines.', result: 'See what is due each month and when to decide whether to keep a subscription.', href: '/tools/software-renewal-tracker', action: 'Open the renewal tracker', destination: 'software_renewal_tracker', external: false, image: '/images/software-renewal-project-desk.jpg', imageAlt: 'Software Renewal Tracker showing the Project desk subscription, charge, renewal date, and decision owner', imageWidth: 1168, imageHeight: 455 },
].filter(Boolean);
---
<section class="free-tools" id="tools" aria-labelledby="tools-title">
  <div class="tools-shell">
    <div class="tools-intro" data-reveal>
      <p class="tools-eyebrow">Free tools</p>
      <h2 id="tools-title">Find a tool for the task.</h2>
    </div>
    <div class="tool-choices">
      {choices.map(choice => choice && (
        <a class="tool-choice" href={choice.href} target={choice.external ? '_blank' : undefined} rel={choice.external ? 'noopener noreferrer' : undefined} data-reveal data-analytics-event="cta_click" data-analytics-destination={choice.destination} data-analytics-source="homepage_featured_tools">
          <div class="tool-copy">
            <p class="tool-category">{choice.category}</p>
            <h3>{choice.name}</h3>
            <p class="tool-question">{choice.goal}</p>
            <p class="tool-description">{choice.description}</p>
            <p class="tool-result"><span>What you get</span>{choice.result}</p>
            <span class="tool-action"><ActionLabel label={choice.action} /></span>
          </div>
          <div class="tool-window">
            <div class="window-heading" aria-hidden="true"><span class="window-dots"><i></i><i></i><i></i></span><span>{choice.name}</span></div>
            <div class="window-canvas"><img src={choice.image} alt={choice.imageAlt} width={choice.imageWidth} height={choice.imageHeight} loading="lazy" decoding="async" /></div>
          </div>
        </a>
      ))}
    </div>
    <div class="tools-more" data-reveal>
      <p>Looking for market research, worksheets, or more ways to explore?</p>
      <a href="/tools" data-analytics-event="cta_click" data-analytics-destination="work" data-analytics-source="homepage_featured_tools"><ActionLabel label="Browse all free tools" /></a>
      <img class="tools-folder" src="/images/tools-folder-3d.webp" alt="" aria-hidden="true" width="512" height="512" loading="lazy" decoding="async" />
    </div>
  </div>
</section>
<style>
  .free-tools { padding: clamp(4.5rem, 7vw, 6.25rem) 0; background: var(--cream); color: var(--brand-ink); }
  .tools-shell { width: min(calc(100% - 4rem), 78rem); margin-inline: auto; }
  .tools-eyebrow, .tool-category { font: 500 .65rem/1.5 'DM Mono', monospace; letter-spacing: .09em; text-transform: uppercase; }
  .tools-eyebrow { display: flex; align-items: center; gap: .75rem; color: #4f7567; font-size: .61rem; font-weight: 400; letter-spacing: .16em; }
  .tools-eyebrow::after { content: ''; width: 2.7rem; height: 1px; background: currentColor; opacity: .42; }
  .tools-intro h2 { margin-top: .9rem; font: 400 clamp(2.65rem, 4vw, 4.2rem)/.99 'Cormorant Garamond', Georgia, serif; letter-spacing: -.035em; }
  .tool-choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 2.5rem; }
  .tool-choice { --tool-accent: #3e5946; display: flex; flex-direction: column; gap: 1.8rem; min-width: 0; padding: clamp(1.75rem, 3vw, 2.6rem); border: 1px solid #cbd6c5; border-radius: 12px; background: #fcfbf8; color: inherit; text-decoration: none; box-shadow: inset 0 1px 0 rgba(255, 255, 255, .7), 0 12px 24px -16px rgba(41, 49, 39, .24); transition: background-color 200ms ease, border-color 200ms ease; }
  .tool-choice:first-child { --tool-accent: #faf6ef; --feature-padding: clamp(2rem, 3.5vw, 3.3rem); --feature-overhang: clamp(1rem, calc(50vw - 40rem), 3rem); display: grid; grid-column: 1 / -1; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); align-items: center; gap: clamp(1.8rem, 3vw, 3rem); padding: var(--feature-padding); background-color: #4f7167; background-image: radial-gradient(ellipse at 80% 40%, #edf4df1f, transparent 58%); border-color: #4f7167; color: #faf6ef; }
  .tool-choice:last-child { --tool-accent: #785752; border-color: #dfc7c0; }
  .tool-copy { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .tool-category { color: var(--tool-accent); }
  .tool-choice h3 { margin-top: .8rem; font: 400 clamp(2.3rem, 3.2vw, 3.2rem)/1.02 'Cormorant Garamond', Georgia, serif; letter-spacing: -.025em; }
  .tool-choice:first-child h3 { font-size: clamp(3rem, 4.1vw, 4.3rem); }
  .tool-question { margin-top: 1rem; font: italic 400 1.55rem/1.2 'Cormorant Garamond', Georgia, serif; }
  .tool-description { margin: .9rem 0; color: #44483f; font-size: .9rem; line-height: 1.75; }
  .tool-result { margin: 0 0 1.5rem; padding-top: .9rem; border-top: 1px solid #3d605526; font-size: .9rem; line-height: 1.65; }
  .tool-result > span { display: block; margin-bottom: .35rem; font: 500 .61rem/1.5 'DM Mono', monospace; letter-spacing: .07em; text-transform: uppercase; color: var(--tool-accent); }
  .tool-choice:first-child .tool-result { border-color: #faf6ef40; }
  .tool-choice:last-child .tool-result { border-color: #89534f30; }
  .tool-action { margin-top: auto; color: var(--tool-accent); }
  .tool-choice:first-child .tool-description { color: #faf6ef; }
  .tool-window { position: relative; isolation: isolate; min-width: 0; margin: 0 0 .5rem; border: 1px solid #e8e3dc; border-radius: 12px; background: #fff; color: #625d55; box-shadow: 0 18px 28px -18px #18282066, 0 2px 6px #1828200d; }
  /* Scale the overhang with the page gutters so the preview stays in the viewport. */
  .tool-choice:first-child .tool-window { width: calc(100% + var(--feature-padding) + var(--feature-overhang)); margin: 0; border-color: #ffffffb3; box-shadow: 0 32px 56px -12px #14271d75, 0 12px 24px -8px #0d221e5c, 0 2px 4px #12282026; transform: translateY(-.75rem); transition: transform 240ms ease, box-shadow 240ms ease; }
  .tool-choice:not(:first-child) .tool-window { order: -1; }
  .window-heading { position: relative; display: flex; align-items: center; justify-content: center; min-height: 2rem; padding: .6rem 2.7rem; border-radius: 12px 12px 0 0; border-bottom: 1px solid #24211e1a; background: #fff; font: 400 .55rem/1.4 'DM Mono', monospace; }
  .window-dots { position: absolute; left: .85rem; display: flex; gap: .3rem; }
  .window-dots i { width: 5px; height: 5px; border-radius: 50%; background: #bbb4a8; }
  .window-canvas { display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 0 0 12px 12px; background: #fff; }
  .window-canvas img { display: block; width: 100%; height: auto; }
  .tool-choice:hover { background-color: #f8faf5; border-color: #9aaf93; }
  .tool-choice:first-child:hover { background-color: #45675e; border-color: #45675e; }
  .tool-choice:last-child:hover { background-color: #fdf7f4; border-color: #b48c82; }
  .tool-choice:focus-visible, .tools-more a:focus-visible { outline: 3px solid #89534f; outline-offset: 4px; }
  .tools-more { display: flex; flex-direction: column; align-items: center; gap: 1rem; margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid #3d605526; text-align: center; }
  .tools-more p { max-width: 58ch; color: #51564e; font-size: .95rem; line-height: 1.65; }
  .tools-folder { display: block; flex: none; width: clamp(7.5rem, 11vw, 9rem); height: auto; margin-top: -.3rem; margin-bottom: -2.5rem; pointer-events: none; user-select: none; }
  .tools-more a { display: inline-flex; align-items: center; justify-content: center; width: min(100%, 22rem); min-height: 56px; padding: .35rem 1.65rem; border: 1px solid #9b6d6e; border-radius: 8px; background: var(--rose); color: var(--brand-ink); text-decoration: none; box-shadow: 0 8px 16px -10px #78575255; transition: background-color 200ms ease, box-shadow 200ms ease; }
  .tools-more a:hover { background: var(--rose-hover); box-shadow: 0 10px 18px -10px #78575266; }
  .tools-more a :global(.action-label) { min-height: 44px; font-size: .78rem; letter-spacing: .065em; }
  .tools-more a :global(.action-label > span:first-child) { text-decoration: none; }
  @media (min-width: 1021px) and (prefers-reduced-motion: no-preference) { .tool-choice:first-child:hover .tool-window, .tool-choice:first-child:focus-visible .tool-window { transform: translateY(-1rem); box-shadow: 0 38px 62px -12px #14271d80, 0 14px 26px -8px #0d221e5c, 0 2px 4px #12282026; } }
  @media (max-width: 1020px) { .tools-shell { width: min(calc(100% - 3rem), 78rem); } .tool-choice:first-child { grid-template-columns: minmax(0, 1fr); } .tool-choice:first-child .tool-window { width: 100%; max-width: 100%; transform: none; box-shadow: 0 20px 30px -16px #172a1e80, 0 6px 12px -6px #172a1e66; } }
  @media (max-width: 760px) { .tools-shell { width: calc(100% - 2.5rem); } .tool-choices { grid-template-columns: minmax(0, 1fr); } .tool-choice { padding: 1.75rem; } .tool-choice:first-child { padding: 1.75rem; } }
  @media (prefers-reduced-motion: reduce) { .tool-choice, .tool-window, .tools-more a { transition: none; } }
</style>
