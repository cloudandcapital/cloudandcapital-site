---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  image?: string;
}

const {
  title,
  description = '',
  noindex = false,
  image = '/images/og-image.png',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://cloudandcapital.com');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/icon.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="shortcut icon" href="/icon.png" />
<link rel="apple-touch-icon" href="/icon.png" />
<link rel="canonical" href={canonicalUrl} />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="theme-color" content="#F5EEE9" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Cloud & Capital" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description || 'Turning numbers into strategy'} />
<meta property="og:image" content={imageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description || 'Turning numbers into strategy'} />
<meta name="twitter:image" content={imageUrl} />
