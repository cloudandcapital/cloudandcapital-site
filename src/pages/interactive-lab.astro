---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Interactive Lab | Cloud & Capital" description="Turn a cloud, AI, SaaS, or technology-spend decision into a structured decision brief.">
  <style is:global>
    body { min-height: 100vh; font-family: var(--font-ui); font-weight: 400; color: var(--text); }
    button, textarea { font: inherit; }
    button:focus-visible, textarea:focus-visible { outline: 3px solid rgba(107, 142, 127, .28); outline-offset: 2px; }
    [hidden] { display: none !important; }

    .lab-hero { max-width: 1280px; margin: 0 auto; padding: 7.25rem 3.5rem 3rem; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(300px, .8fr); gap: 5rem; align-items: end; }
    .lab-kicker { display: flex; align-items: center; gap: .8rem; margin-bottom: 1.35rem; font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; color: var(--text-muted); }
    .lab-kicker::before { content: ''; width: 2.4rem; height: 1px; background: var(--text-muted); }
    .lab-hero h1 { max-width: 760px; font-family: var(--font-display); font-size: clamp(3rem, 5.5vw, 5.25rem); font-weight: 400; line-height: .99; letter-spacing: -.035em; }
    .lab-hero h1 em { color: var(--forest); font-weight: 400; }
    .lab-hero-note { padding: 0 0 .5rem 1.75rem; border-left: 1px solid var(--border-strong); }
    .lab-hero-note p { max-width: 430px; font-family: var(--font-body); font-size: 1.23rem; line-height: 1.55; color: var(--text-muted); }
    .lab-hero-meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.5rem; }
    .lab-hero-meta span { display: block; font-size: .62rem; letter-spacing: .13em; text-transform: uppercase; color: var(--text-light); }
    .lab-hero-meta strong { display: block; margin-top: .25rem; font-size: .78rem; letter-spacing: 0; text-transform: none; color: var(--text-muted); font-weight: 500; }

    .lab-shell { max-width: 1280px; margin: 0 auto; padding: 0 3.5rem 7rem; }
    .lab-frame { background: #fbf9f6; border: 1px solid var(--border); box-shadow: 0 20px 70px rgba(26, 26, 26, .09); }
    .lab-rail { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--border); background: #f2ece6; }
    .lab-step { position: relative; padding: 1.05rem 1.25rem; display: flex; gap: .7rem; align-items: center; font-size: .64rem; letter-spacing: .13em; text-transform: uppercase; color: var(--text-light); }
    .lab-step + .lab-step { border-left: 1px solid var(--border); }
    .lab-step-number { font-family: var(--font-body); font-size: 1rem; letter-spacing: 0; font-style: italic; }
    .lab-step.is-active { background: #fbf9f6; color: var(--forest-deep); }
    .lab-step.is-active::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; background: var(--forest); }
    .lab-step.is-complete { color: var(--text); }

    .lab-workspace { display: grid; grid-template-columns: minmax(360px, 42%) minmax(0, 58%); min-height: 650px; }
    .lab-input-pane { padding: 2.5rem 2.6rem 2.75rem; border-right: 1px solid var(--border); background: #fff; }
    .lab-output-pane { position: relative; min-width: 0; padding: 2.5rem 2.8rem 3rem; background: #fbf9f6; }
    .lab-workspace.is-results { display: block; min-height: 0; }
    .lab-workspace.is-results .lab-input-pane { display: none; }
    .lab-workspace.is-results .lab-output-pane { width: 100%; padding: 3rem 3.5rem 3.5rem; }
    .pane-eyebrow { margin-bottom: .7rem; font-size: .66rem; letter-spacing: .16em; text-transform: uppercase; color: var(--forest-deep); font-weight: 500; }
    .pane-heading { font-family: var(--font-display); font-size: clamp(1.8rem, 3vw, 2.55rem); line-height: 1.12; font-weight: 400; letter-spacing: -.02em; }
    .pane-intro { margin-top: .8rem; font-family: var(--font-body); font-size: 1.08rem; line-height: 1.55; color: var(--text-muted); }
    .section-rule { height: 1px; background: var(--border); margin: 1.8rem 0; }

    .scenario-label { margin-bottom: .7rem; font-size: .66rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-light); }
    .scenario-list { display: grid; gap: .5rem; }
    .scenario-button { width: 100%; display: grid; grid-template-columns: 1.9rem 1fr; gap: .7rem; align-items: start; padding: .72rem .8rem; background: transparent; border: 1px solid var(--border); color: var(--text); text-align: left; cursor: pointer; transition: border-color .18s, background .18s, transform .18s; }
    .scenario-button:hover { border-color: var(--forest); background: var(--sage-tint); transform: translateX(2px); }
    .scenario-button.is-selected { border-color: var(--forest); background: var(--sage-tint); }
    .scenario-index { font-family: var(--font-body); font-style: italic; color: var(--gold); }
    .scenario-name { display: block; font-size: .68rem; letter-spacing: .11em; text-transform: uppercase; color: var(--forest-deep); font-weight: 500; }
    .scenario-summary { display: block; margin-top: .18rem; font-family: var(--font-body); font-size: .93rem; line-height: 1.35; color: var(--text-muted); }

    .field-label { display: block; margin-bottom: .45rem; font-size: .68rem; letter-spacing: .13em; text-transform: uppercase; color: var(--text); font-weight: 500; }
    .field-help { display: block; margin: -.1rem 0 .55rem; font-family: var(--font-body); font-size: .94rem; line-height: 1.4; color: var(--text-muted); }
    .lab-textarea { width: 100%; min-height: 118px; resize: vertical; padding: .95rem 1rem; border: 1px solid var(--border-strong); border-radius: 0; background: #fff; color: var(--text); font-family: var(--font-body); font-size: 1.05rem; line-height: 1.5; }
    .lab-textarea::placeholder { color: #777; }
    .lab-textarea:focus { border-color: var(--forest-deep); }
    .context-fields { display: grid; gap: 1.2rem; margin-top: 1.6rem; }
    .context-field .lab-textarea { min-height: 92px; }
    .type-chip { display: inline-flex; align-items: center; gap: .5rem; margin-top: 1rem; padding: .42rem .65rem; background: var(--sage-tint); border: 1px solid rgba(107, 142, 127, .3); color: var(--forest-deep); font-size: .64rem; letter-spacing: .1em; text-transform: uppercase; }
    .type-chip::before { content: ''; width: .38rem; height: .38rem; border-radius: 50%; background: var(--forest); }
    .evidence-meter { margin-top: 1rem; display: flex; justify-content: space-between; gap: 1rem; font-size: .72rem; color: var(--text-muted); }
    .meter-track { flex: 1; max-width: 150px; height: 3px; margin-top: .5rem; background: var(--border); }
    .meter-fill { width: 0; height: 100%; background: var(--forest); transition: width .25s ease; }

    .form-actions { display: flex; align-items: center; gap: .7rem; margin-top: 1.3rem; }
    .lab-button { min-height: 44px; padding: .78rem 1.15rem; border: 1px solid var(--border-strong); background: transparent; color: var(--text); cursor: pointer; font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; font-weight: 500; transition: background .18s, color .18s, border-color .18s; }
    .lab-button-primary { flex: 1; background: var(--forest-deep); color: #fff; border-color: var(--forest-deep); }
    .lab-button-primary:hover:not(:disabled) { background: #344f46; border-color: #344f46; }
    .lab-button:disabled { background: #d9dfdc; border-color: #d9dfdc; color: #6b746f; cursor: not-allowed; }
    .lab-button-quiet:hover { border-color: var(--text); }
    .privacy-note { margin-top: 1rem; font-size: .72rem; line-height: 1.45; color: #666; }
    .lab-error { margin-top: 1rem; padding: .8rem .9rem; border: 1px solid rgba(180, 67, 67, .35); background: rgba(180, 67, 67, .06); color: #8a2f2f; font-size: .82rem; line-height: 1.45; }

    .brief-placeholder { height: 100%; min-height: 570px; display: flex; flex-direction: column; justify-content: space-between; }
    .brief-placeholder-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; }
    .memo-label { font-size: .64rem; letter-spacing: .17em; text-transform: uppercase; color: var(--text-light); }
    .memo-status { display: inline-flex; align-items: center; gap: .45rem; font-size: .64rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-muted); }
    .memo-status::before { content: ''; width: .42rem; height: .42rem; border: 1px solid var(--text-light); border-radius: 50%; }
    .brief-placeholder-copy { max-width: 520px; padding: 4rem 0; }
    .brief-placeholder-copy h2 { font-family: var(--font-display); font-size: clamp(2.2rem, 4vw, 3.4rem); font-weight: 400; line-height: 1.08; letter-spacing: -.03em; }
    .brief-placeholder-copy p { max-width: 450px; margin-top: 1rem; font-family: var(--font-body); font-size: 1.12rem; line-height: 1.55; color: var(--text-muted); }
    .brief-outline { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .outline-item { padding: 1rem .7rem; font-size: .63rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-light); }
    .outline-item + .outline-item { border-left: 1px solid var(--border); }

    .thinking-state { min-height: 570px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
    .thinking-mark { position: relative; width: 76px; height: 76px; margin-bottom: 1.6rem; border: 1px solid var(--border-strong); border-radius: 50%; }
    .thinking-mark::before, .thinking-mark::after { content: ''; position: absolute; inset: 10px; border: 1px solid rgba(107, 142, 127, .35); border-radius: 50%; animation: labPulse 1.7s ease-in-out infinite; }
    .thinking-mark::after { inset: 23px; background: var(--forest); border: 0; animation-delay: .2s; }
    @keyframes labPulse { 0%, 100% { transform: scale(.82); opacity: .45; } 50% { transform: scale(1); opacity: 1; } }
    .thinking-state h2 { font-family: var(--font-display); font-size: 2rem; font-weight: 400; }
    .thinking-state p { min-height: 1.5rem; margin-top: .6rem; font-family: var(--font-body); font-size: 1.05rem; color: var(--text-muted); }

    .decision-brief { animation: briefIn .35s ease; }
    @keyframes briefIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .context-summary { margin-bottom: 1.8rem; border: 1px solid var(--border); background: #fff; }
    .context-summary summary { display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; padding: .9rem 1rem; cursor: pointer; list-style: none; }
    .context-summary summary::-webkit-details-marker { display: none; }
    .context-summary-label { font-size: .64rem; letter-spacing: .14em; text-transform: uppercase; color: var(--forest-deep); font-weight: 500; }
    .context-summary-decision { flex: 1; overflow: hidden; color: var(--text-muted); font-family: var(--font-body); font-size: .94rem; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
    .context-summary-toggle { font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-light); }
    .context-summary[open] .context-summary-toggle { visibility: hidden; }
    .context-summary-body { padding: 0 1rem 1rem; border-top: 1px solid var(--border); }
    .context-summary-list { display: grid; grid-template-columns: 1fr 1fr; gap: .9rem 1.25rem; padding: 1rem 0; }
    .context-summary-item dt { font-size: .59rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-light); }
    .context-summary-item dd { margin-top: .25rem; font-family: var(--font-body); font-size: .92rem; line-height: 1.4; color: var(--text-muted); }
    .context-summary-actions { display: flex; justify-content: flex-end; }
    .brief-header { padding-bottom: 1.8rem; border-bottom: 1px solid var(--border-strong); }
    .brief-header-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .brief-posture { padding: .38rem .62rem; border: 1px solid var(--forest); color: var(--forest-deep); font-size: .64rem; letter-spacing: .12em; text-transform: uppercase; }
    .brief-title { margin-top: 1rem; font-family: var(--font-display); font-size: clamp(2rem, 3.6vw, 3rem); line-height: 1.1; font-weight: 400; letter-spacing: -.025em; }
    .brief-posture-reason { margin-top: .75rem; font-family: var(--font-body); font-size: 1.08rem; line-height: 1.5; color: var(--text-muted); }
    .brief-section { padding: 1.75rem 0; border-bottom: 1px solid var(--border); }
    .brief-section h3 { margin-bottom: 1rem; font-size: .66rem; letter-spacing: .16em; text-transform: uppercase; color: var(--forest-deep); font-weight: 500; }
    .brief-section-copy { font-family: var(--font-body); font-size: 1.06rem; line-height: 1.55; color: var(--text-muted); }
    .facts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    .fact-column { padding: 1rem 1.05rem; background: #fff; border: 1px solid var(--border); }
    .fact-column h4 { margin-bottom: .75rem; font-family: var(--font-display); font-size: 1.05rem; font-weight: 400; }
    .brief-list { list-style: none; display: grid; gap: .65rem; }
    .brief-list li { position: relative; padding-left: 1rem; font-family: var(--font-body); font-size: .98rem; line-height: 1.45; color: var(--text-muted); }
    .brief-list li::before { content: ''; position: absolute; left: 0; top: .62rem; width: .35rem; height: 1px; background: var(--gold); }
    .assumption-item strong { display: block; color: var(--text); font-weight: 500; }
    .assumption-item span { display: block; margin-top: .12rem; }

    .options-wrap { overflow-x: auto; }
    .decision-matrix { width: 100%; table-layout: fixed; border-collapse: collapse; background: #fff; }
    .decision-matrix th, .decision-matrix td { padding: .9rem 1rem; border: 1px solid var(--border); text-align: left; vertical-align: top; }
    .decision-matrix thead th { background: #f2ece6; font-family: var(--font-display); font-size: 1rem; line-height: 1.25; color: var(--text); font-weight: 400; }
    .decision-matrix thead th:first-child { width: 15%; font-family: var(--font-ui); font-size: .59rem; letter-spacing: .09em; text-transform: uppercase; color: var(--text-muted); font-weight: 500; }
    .decision-matrix tbody th { width: 15%; background: #f8f4f0; font-size: .6rem; letter-spacing: .09em; text-transform: uppercase; color: var(--forest-deep); font-weight: 500; }
    .decision-matrix td { font-family: var(--font-body); font-size: .92rem; line-height: 1.45; color: var(--text-muted); }
    .matrix-mobile { display: none; }
    .matrix-option { background: #fff; border: 1px solid var(--border); }
    .matrix-option + .matrix-option { margin-top: 1rem; }
    .matrix-option h4 { padding: .9rem 1rem; background: #f2ece6; font-family: var(--font-display); font-size: 1.1rem; line-height: 1.25; font-weight: 400; }
    .matrix-option dl { padding: 0 1rem; }
    .matrix-option-row { display: grid; grid-template-columns: 7rem 1fr; gap: .75rem; padding: .8rem 0; border-top: 1px solid var(--border); }
    .matrix-option-row dt { font-size: .58rem; letter-spacing: .08em; text-transform: uppercase; color: var(--forest-deep); font-weight: 500; }
    .matrix-option-row dd { font-family: var(--font-body); font-size: .92rem; line-height: 1.42; color: var(--text-muted); }
    .lens-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; }
    .lens-card { padding: 1rem; background: #fff; border-top: 2px solid var(--forest); }
    .lens-card h4 { font-family: var(--font-display); font-size: 1.15rem; font-style: italic; font-weight: 400; }
    .lens-card p { margin-top: .55rem; font-family: var(--font-body); font-size: .94rem; line-height: 1.42; color: var(--text-muted); }
    .lens-need { padding-top: .55rem; border-top: 1px solid var(--border); }
    .lens-need strong { display: block; margin-bottom: .15rem; font-family: var(--font-ui); font-size: .56rem; letter-spacing: .1em; text-transform: uppercase; color: var(--forest-deep); }
    .tension-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem; }
    .tension-card { padding: 1rem; border: 1px solid var(--border); }
    .tension-card strong { display: block; margin-bottom: .35rem; font-size: .6rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-light); }
    .tension-card p { font-family: var(--font-body); font-size: .98rem; line-height: 1.45; color: var(--text-muted); }
    .economics-callout { padding: 1.1rem 1.2rem; border-left: 3px solid var(--gold); background: var(--gold-soft); }
    .threshold-list { margin-top: 1rem; display: grid; gap: .6rem; }
    .threshold-item { display: grid; grid-template-columns: 1fr 1.3fr; gap: .8rem; padding-top: .6rem; border-top: 1px solid var(--border); }
    .threshold-item strong { font-size: .72rem; color: var(--text); }
    .threshold-item span { font-family: var(--font-body); font-size: .94rem; line-height: 1.4; color: var(--text-muted); }
    .recommendation { padding: 1.5rem; background: var(--forest-deep); color: #fff; }
    .recommendation-top { display: flex; justify-content: space-between; gap: 1rem; font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255, 255, 255, .7); }
    .recommendation-move { margin-top: .75rem; font-family: var(--font-body); font-size: 1.2rem; line-height: 1.5; }
    .recommendation-rationale { margin-top: .75rem; padding-top: .75rem; border-top: 1px solid rgba(255,255,255,.18); font-size: .8rem; line-height: 1.5; color: rgba(255,255,255,.78); }
    .actions-table { width: 100%; border-collapse: collapse; }
    .actions-table th, .actions-table td { padding: .7rem .55rem; border-bottom: 1px solid var(--border); text-align: left; vertical-align: top; }
    .actions-table th { font-size: .58rem; letter-spacing: .09em; text-transform: uppercase; color: var(--text-light); }
    .actions-table td { font-family: var(--font-body); font-size: .92rem; line-height: 1.4; color: var(--text-muted); }
    .brief-disclosure { padding: 1rem 0; font-size: .7rem; line-height: 1.5; color: #666; }
    .brief-actions { display: flex; flex-wrap: wrap; gap: .6rem; padding-top: .9rem; }
    .copy-state { min-height: 1.2rem; margin-top: .6rem; font-size: .7rem; color: var(--forest-deep); }

    @media (max-width: 980px) {
      .lab-hero { grid-template-columns: 1fr; gap: 2rem; padding-inline: 1.5rem; }
      .lab-hero-note { max-width: 680px; }
      .lab-shell { padding-inline: 1.5rem; }
      .lab-workspace { grid-template-columns: 1fr; }
      .lab-input-pane { border-right: 0; border-bottom: 1px solid var(--border); }
      .lab-output-pane { min-height: 560px; }
      .lab-workspace.is-results .lab-output-pane { min-height: 0; padding: 2.5rem 2.6rem 3rem; }
    }

    @media (max-width: 640px) {
      .lab-hero { padding: 5.6rem 1rem 2rem; }
      .lab-hero h1 { font-size: 3rem; }
      .lab-hero-note { padding-left: 1rem; }
      .lab-hero-meta { grid-template-columns: 1fr 1fr; }
      .lab-shell { padding: 0 0 5rem; }
      .lab-frame { border-left: 0; border-right: 0; box-shadow: none; }
      .lab-step { justify-content: center; padding: .8rem .35rem; gap: .35rem; letter-spacing: .08em; }
      .lab-step-number { display: none; }
      .lab-input-pane, .lab-output-pane { padding: 1.6rem 1rem 2rem; }
      .lab-workspace.is-results .lab-output-pane { padding: 1.6rem 1rem 2rem; }
      .scenario-button { padding: .78rem; }
      .form-actions { position: sticky; bottom: 0; z-index: 10; margin: 1.2rem -1rem -2rem; padding: .8rem 1rem calc(.8rem + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); border-top: 1px solid var(--border); }
      .facts-grid, .lens-grid, .tension-grid { grid-template-columns: 1fr; }
      .context-summary summary { align-items: flex-start; flex-wrap: wrap; }
      .context-summary-decision { order: 3; flex-basis: 100%; white-space: normal; }
      .context-summary-list { grid-template-columns: 1fr; }
      .decision-matrix { display: none; }
      .matrix-mobile { display: block; }
      .matrix-option-row { grid-template-columns: 1fr; gap: .25rem; }
      .brief-placeholder-top { flex-direction: column; gap: .6rem; }
      .brief-outline { grid-template-columns: 1fr; }
      .outline-item + .outline-item { border-left: 0; border-top: 1px solid var(--border); }
      .threshold-item { grid-template-columns: 1fr; gap: .2rem; }
      .brief-header-top, .recommendation-top { align-items: flex-start; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }

    @media print {
      .site-nav, .site-footer, .lab-hero, .lab-rail, .lab-input-pane, .context-summary, .brief-actions, .copy-state { display: none !important; }
      body { background: #fff; }
      .lab-shell { max-width: none; padding: 0; }
      .lab-frame { border: 0; box-shadow: none; }
      .lab-workspace { display: block; }
      .lab-output-pane { padding: 0; background: #fff; }
      .brief-section { break-inside: avoid; }
    }
  </style>

  <header class="lab-hero">
    <div>
      <div class="lab-kicker">Interactive · Decision Brief</div>
      <h1>Bring a decision.<br />Leave with a <em>brief.</em></h1>
    </div>
    <div class="lab-hero-note">
      <p>Turn a cloud, AI, SaaS, or technology-spend question into shared facts, explicit assumptions, real options, and a next move.</p>
      <div class="lab-hero-meta" aria-label="Lab details">
        <span>Input<strong>Your decision</strong></span>
        <span>Process<strong>Guided context</strong></span>
        <span>Output<strong>Decision brief</strong></span>
      </div>
    </div>
  </header>

  <main class="lab-shell">
    <section class="lab-frame" aria-label="Interactive decision lab">
      <div class="lab-rail" aria-label="Progress">
        <div class="lab-step is-active" id="stepDecision"><span class="lab-step-number">01</span> Context</div>
        <div class="lab-step" id="stepEvidence"><span class="lab-step-number">02</span> Assumptions</div>
        <div class="lab-step" id="stepBrief"><span class="lab-step-number">03</span> Brief</div>
      </div>

      <div class="lab-workspace" id="labWorkspace">
        <aside class="lab-input-pane">
          <div id="decisionStage">
            <div class="pane-eyebrow">Start with the decision</div>
            <h2 class="pane-heading">What are you trying to decide?</h2>
            <p class="pane-intro">Use a starter case or describe the real situation in your own words.</p>

            <div class="section-rule"></div>
            <div class="scenario-label">Starter cases</div>
            <div class="scenario-list" id="scenarioList">
              <button type="button" class="scenario-button" data-type="commitment" data-decision="Our engineering team wants to commit $500K for a year of reserved GPU capacity. Finance wants quarterly flexibility, and we do not yet know whether workload demand will scale or plateau.">
                <span class="scenario-index">i</span><span><span class="scenario-name">GPU commitment</span><span class="scenario-summary">One-year capacity commitment with uncertain demand</span></span>
              </button>
              <button type="button" class="scenario-button" data-type="renewal" data-decision="Our Datadog contract renews in 60 days. Spend has grown 3x in two years, and we do not know which teams or telemetry types caused the increase.">
                <span class="scenario-index">ii</span><span><span class="scenario-name">SaaS renewal</span><span class="scenario-summary">A major renewal after rapid spend growth</span></span>
              </button>
              <button type="button" class="scenario-button" data-type="build_buy" data-decision="Our customer-facing AI feature costs $40K per month on the Claude API and spend is growing. Leadership wants to compare optimization, a smaller model, and building in-house.">
                <span class="scenario-index">iii</span><span><span class="scenario-name">AI build or buy</span><span class="scenario-summary">Rising model cost and margin pressure</span></span>
              </button>
              <button type="button" class="scenario-button" data-type="cost_review" data-decision="Our AWS bill reached $180K per month, finance is asking for reductions, and we have not completed a full cost review in 18 months.">
                <span class="scenario-index">iv</span><span><span class="scenario-name">Cost review</span><span class="scenario-summary">A large bill with limited recent analysis</span></span>
              </button>
              <button type="button" class="scenario-button" data-type="architecture" data-decision="We are a 50-person company running entirely on AWS. Leadership wants multi-cloud resilience and negotiating leverage, while engineering expects significant operating cost.">
                <span class="scenario-index">v</span><span><span class="scenario-name">Multi-cloud</span><span class="scenario-summary">Resilience narrative versus operating complexity</span></span>
              </button>
            </div>

            <div class="section-rule"></div>
            <label class="field-label" for="decisionInput">Your decision</label>
            <span class="field-help" id="decisionHelp">Include the pressure, context, and what is at stake. At least 20 characters.</span>
            <textarea class="lab-textarea" id="decisionInput" maxlength="2000" aria-describedby="decisionHelp" placeholder="Describe the decision you are navigating…"></textarea>
            <div class="form-actions">
              <button type="button" class="lab-button lab-button-primary" id="contextBtn" disabled>Build the context →</button>
              <button type="button" class="lab-button lab-button-quiet" id="resetBtn">Reset</button>
            </div>
          </div>

          <div id="contextStage" hidden>
            <div class="pane-eyebrow" id="contextEyebrow">Decision context</div>
            <h2 class="pane-heading">Give the brief something real to work with.</h2>
            <p class="pane-intro">The Lab asks for the evidence this decision type actually needs.</p>
            <div class="type-chip" id="typeChip"></div>
            <div class="evidence-meter"><span id="evidenceText">0 of 4 evidence fields ready</span><span class="meter-track" aria-hidden="true"><span class="meter-fill" id="meterFill"></span></span></div>
            <div class="context-fields" id="contextFields"></div>
            <div class="form-actions">
              <button type="button" class="lab-button lab-button-primary" id="briefBtn" disabled>Generate the brief →</button>
              <button type="button" class="lab-button lab-button-quiet" id="backBtn">Back</button>
            </div>
          </div>

          <p class="privacy-note">Do not include confidential contract terms, customer data, credentials, or sensitive infrastructure details. Your entries are sent to an AI model to generate the brief.</p>
          <div class="lab-error" id="errorMsg" role="alert" hidden></div>
        </aside>

        <section class="lab-output-pane" id="outputPane" aria-live="polite" aria-busy="false">
          <div class="brief-placeholder" id="placeholderState">
            <div class="brief-placeholder-top"><span class="memo-label">Cloud &amp; Capital · Decision Brief</span><span class="memo-status" id="placeholderStatus">Waiting for context</span></div>
            <div class="brief-placeholder-copy">
              <h2 id="placeholderHeading">The recommendation comes last.</h2>
              <p id="placeholderCopy">First, the Lab separates what is known from what is assumed—then it shows how Finance, FinOps, and Engineering see the same choice.</p>
            </div>
            <div class="brief-outline" aria-label="Brief contents"><div class="outline-item">Facts &amp; assumptions</div><div class="outline-item">Options &amp; economics</div><div class="outline-item">Recommendation &amp; actions</div></div>
          </div>

          <div class="thinking-state" id="thinkingState" role="status" hidden>
            <div class="thinking-mark" aria-hidden="true"></div>
            <h2>Building the decision brief</h2>
            <p id="thinkingText">Separating facts from assumptions</p>
          </div>

          <article class="decision-brief" id="briefState" tabindex="-1" hidden>
            <details class="context-summary" id="contextSummary">
              <summary><span class="context-summary-label">Context supplied</span><span class="context-summary-decision" id="contextSummaryDecision"></span><span class="context-summary-toggle">View details</span></summary>
              <div class="context-summary-body"><dl class="context-summary-list" id="contextSummaryList"></dl><div class="context-summary-actions"><button type="button" class="lab-button lab-button-quiet" id="summaryEditBtn">Edit context</button></div></div>
            </details>
            <header class="brief-header">
              <div class="brief-header-top"><span class="memo-label">Cloud &amp; Capital · Decision Brief</span><span class="brief-posture" id="briefPosture"></span></div>
              <h2 class="brief-title" id="briefTitle"></h2>
              <p class="brief-posture-reason" id="briefPostureReason"></p>
            </header>

            <section class="brief-section"><h3>Facts and assumptions</h3><div class="facts-grid"><div class="fact-column"><h4>Known facts</h4><ul class="brief-list" id="knownFacts"></ul></div><div class="fact-column"><h4>Working assumptions</h4><ul class="brief-list" id="workingAssumptions"></ul></div></div></section>
            <section class="brief-section"><h3>Option comparison</h3><div id="optionMatrix"></div></section>
            <section class="brief-section"><h3>Cross-functional view</h3><div class="lens-grid" id="lensGrid"></div><div class="tension-grid"><div class="tension-card"><strong>Common ground</strong><p id="commonGround"></p></div><div class="tension-card"><strong>Unresolved tension</strong><p id="unresolvedTension"></p></div></div></section>
            <section class="brief-section"><h3>Economics and thresholds</h3><div class="economics-callout"><p class="brief-section-copy" id="economicsAnalysis"></p></div><div class="threshold-list" id="thresholdList"></div></section>
            <section class="brief-section"><h3>Recommendation</h3><div class="recommendation"><div class="recommendation-top"><span>The next move</span><span id="confidenceLabel"></span></div><p class="recommendation-move" id="recommendationMove"></p><p class="recommendation-rationale" id="recommendationRationale"></p></div></section>
            <section class="brief-section"><h3>What would change the answer</h3><ul class="brief-list" id="changeAnswer"></ul></section>
            <section class="brief-section"><h3>Next actions</h3><div class="options-wrap"><table class="actions-table"><thead><tr><th>Action</th><th>Owner</th><th>Evidence</th><th>Timing</th></tr></thead><tbody id="actionsBody"></tbody></table></div></section>
            <p class="brief-disclosure">This is an AI-generated decision aid based only on the context supplied. Validate provider terms, calculations, and financially consequential decisions against primary data before acting.</p>
            <div class="brief-actions"><button type="button" class="lab-button lab-button-primary" id="copyBtn">Copy decision brief</button><button type="button" class="lab-button lab-button-quiet" id="printBtn">Print / Save PDF</button><button type="button" class="lab-button lab-button-quiet" id="editBtn">Edit context</button><button type="button" class="lab-button lab-button-quiet" id="anotherBtn">Try another</button></div>
            <div class="copy-state" id="copyState" aria-live="polite"></div>
          </article>
        </section>
      </div>
    </section>
  </main>

  <script is:inline>
    const state = { decisionType: '', questions: [], answers: {}, brief: null, selectedScenario: null };
    const $ = (id) => document.getElementById(id);
    const decisionInput = $('decisionInput');
    const contextBtn = $('contextBtn');
    const briefBtn = $('briefBtn');
    const errorMsg = $('errorMsg');
    const outputPane = $('outputPane');
    let thinkingTimer = null;

    function setError(message = '') {
      errorMsg.textContent = message;
      errorMsg.hidden = !message;
    }

    function setStep(active) {
      const steps = [$('stepDecision'), $('stepEvidence'), $('stepBrief')];
      steps.forEach((step, index) => {
        step.classList.toggle('is-active', index === active);
        step.classList.toggle('is-complete', index < active);
      });
    }

    function showPlaceholder(mode = 'initial') {
      $('placeholderState').hidden = false;
      $('thinkingState').hidden = true;
      $('briefState').hidden = true;
      if (mode === 'context') {
        $('placeholderStatus').textContent = 'Context in progress';
        $('placeholderHeading').textContent = 'A stronger answer starts with better evidence.';
        $('placeholderCopy').textContent = 'Complete the four decision-specific prompts. The Lab will preserve your facts, expose its assumptions, and only then make a recommendation.';
      } else {
        $('placeholderStatus').textContent = 'Waiting for context';
        $('placeholderHeading').textContent = 'The recommendation comes last.';
        $('placeholderCopy').textContent = 'First, the Lab separates what is known from what is assumed—then it shows how Finance, FinOps, and Engineering see the same choice.';
      }
    }

    function showDecisionStage() {
      $('labWorkspace').classList.remove('is-results');
      $('decisionStage').hidden = false;
      $('contextStage').hidden = true;
      setStep(0);
      showPlaceholder('initial');
      setError();
    }

    function showContextStage() {
      $('labWorkspace').classList.remove('is-results');
      $('decisionStage').hidden = true;
      $('contextStage').hidden = false;
      setStep(1);
      showPlaceholder('context');
      setError();
      updateEvidence();
    }

    function makeElement(tag, className, text) {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    document.querySelectorAll('.scenario-button').forEach((button) => {
      button.addEventListener('click', () => {
        document.querySelectorAll('.scenario-button').forEach((item) => item.classList.remove('is-selected'));
        button.classList.add('is-selected');
        state.selectedScenario = button;
        state.decisionType = button.dataset.type;
        decisionInput.value = button.dataset.decision;
        contextBtn.disabled = false;
        decisionInput.focus();
      });
    });

    decisionInput.addEventListener('input', () => {
      contextBtn.disabled = decisionInput.value.trim().length < 20;
      if (state.selectedScenario && decisionInput.value !== state.selectedScenario.dataset.decision) {
        state.selectedScenario.classList.remove('is-selected');
        state.selectedScenario = null;
        state.decisionType = '';
      }
    });

    async function callLab(payload) {
      const response = await fetch('/api/interactive-lab', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      let data = {};
      try { data = await response.json(); } catch { data = {}; }
      if (!response.ok) throw new Error(data.error || 'The Lab could not complete the request.');
      return data;
    }

    contextBtn.addEventListener('click', async () => {
      const decision = decisionInput.value.trim();
      if (decision.length < 20) return;
      contextBtn.disabled = true;
      contextBtn.textContent = 'Reading the decision…';
      setError();
      try {
        const data = await callLab({ stage: 'questions', decision, decisionType: state.decisionType || undefined });
        state.decisionType = data.decisionType;
        state.questions = data.questions;
        state.answers = data.answers || {};
        renderContextFields(data);
        showContextStage();
        $('contextFields').querySelector('textarea')?.focus();
      } catch (error) {
        setError(error.message);
      } finally {
        contextBtn.textContent = 'Build the context →';
        contextBtn.disabled = decisionInput.value.trim().length < 20;
      }
    });

    function renderContextFields(data) {
      $('typeChip').textContent = data.typeLabel;
      $('contextEyebrow').textContent = data.eyebrow || 'Decision context';
      const container = $('contextFields');
      container.replaceChildren();
      data.questions.forEach((question) => {
        const wrap = makeElement('div', 'context-field');
        const label = makeElement('label', 'field-label', question.label);
        label.htmlFor = `context-${question.id}`;
        const help = makeElement('span', 'field-help', question.prompt);
        help.id = `help-${question.id}`;
        const textarea = makeElement('textarea', 'lab-textarea');
        textarea.id = `context-${question.id}`;
        textarea.maxLength = 1200;
        textarea.value = state.answers[question.id] || '';
        textarea.setAttribute('aria-describedby', help.id);
        textarea.addEventListener('input', () => {
          state.answers[question.id] = textarea.value.trim();
          updateEvidence();
        });
        wrap.append(label, help, textarea);
        container.append(wrap);
      });
    }

    function updateEvidence() {
      const complete = state.questions.filter((question) => (state.answers[question.id] || '').trim().length >= 8).length;
      const total = state.questions.length || 4;
      $('evidenceText').textContent = `${complete} of ${total} evidence fields ready`;
      $('meterFill').style.width = `${(complete / total) * 100}%`;
      briefBtn.disabled = complete !== total;
    }

    $('backBtn').addEventListener('click', showDecisionStage);
    $('resetBtn').addEventListener('click', resetLab);
    $('anotherBtn').addEventListener('click', resetLab);
    function editContext() {
      showContextStage();
      $('contextFields').querySelector('textarea')?.focus();
    }
    $('editBtn').addEventListener('click', editContext);
    $('summaryEditBtn').addEventListener('click', editContext);

    function resetLab() {
      clearInterval(thinkingTimer);
      state.decisionType = '';
      state.questions = [];
      state.answers = {};
      state.brief = null;
      state.selectedScenario = null;
      decisionInput.value = '';
      contextBtn.disabled = true;
      document.querySelectorAll('.scenario-button').forEach((item) => item.classList.remove('is-selected'));
      showDecisionStage();
      decisionInput.focus();
      window.scrollTo({ top: document.querySelector('.lab-frame').offsetTop - 80, behavior: 'smooth' });
    }

    function startThinking() {
      $('placeholderState').hidden = true;
      $('briefState').hidden = true;
      $('thinkingState').hidden = false;
      outputPane.setAttribute('aria-busy', 'true');
      const messages = ['Separating facts from assumptions', 'Comparing the real options', 'Reading Finance, FinOps, and Engineering together', 'Testing the recommendation against uncertainty'];
      let index = 0;
      $('thinkingText').textContent = messages[index];
      clearInterval(thinkingTimer);
      thinkingTimer = setInterval(() => { index = (index + 1) % messages.length; $('thinkingText').textContent = messages[index]; }, 1600);
    }

    function stopThinking() {
      clearInterval(thinkingTimer);
      $('thinkingState').hidden = true;
      outputPane.setAttribute('aria-busy', 'false');
    }

    briefBtn.addEventListener('click', async () => {
      updateEvidence();
      if (briefBtn.disabled) return;
      briefBtn.disabled = true;
      setError();
      setStep(2);
      startThinking();
      try {
        const data = await callLab({ stage: 'brief', decision: decisionInput.value.trim(), decisionType: state.decisionType, answers: state.answers });
        if (data.status !== 'ready' || !data.brief) throw new Error('The Lab needs more context before it can generate the brief.');
        state.brief = data.brief;
        renderBrief(data.brief);
        renderContextSummary();
        stopThinking();
        $('labWorkspace').classList.add('is-results');
        $('briefState').hidden = false;
        $('briefState').focus({ preventScroll: true });
        if (window.innerWidth < 980) $('briefState').scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (error) {
        stopThinking();
        setStep(1);
        showPlaceholder('context');
        setError(error.message);
      } finally {
        updateEvidence();
      }
    });

    function appendTextList(container, items, formatter) {
      container.replaceChildren();
      items.forEach((item) => {
        const li = makeElement('li');
        if (formatter) formatter(li, item); else li.textContent = item;
        container.append(li);
      });
    }

    function withSentencePunctuation(value) {
      const text = value.trim();
      return /[.!?]$/.test(text) ? text : `${text}.`;
    }

    function renderBrief(brief) {
      $('briefPosture').textContent = brief.posture.label;
      $('briefTitle').textContent = brief.decision_summary;
      $('briefPostureReason').textContent = brief.posture.rationale;
      appendTextList($('knownFacts'), brief.known_facts);
      appendTextList($('workingAssumptions'), brief.working_assumptions, (li, item) => {
        li.className = 'assumption-item';
        li.append(makeElement('strong', '', item.assumption), makeElement('span', '', item.why_it_matters));
      });

      renderOptionMatrix(brief.options);

      $('lensGrid').replaceChildren();
      [['finops', 'FinOps'], ['finance', 'Finance'], ['engineering', 'Engineering']].forEach(([key, label]) => {
        const card = makeElement('div', 'lens-card');
        card.append(makeElement('h4', '', label), makeElement('p', '', brief.lenses[key].view));
        const need = makeElement('p', 'lens-need');
        need.append(makeElement('strong', '', 'Needs to know'), document.createTextNode(brief.lenses[key].need));
        card.append(need);
        $('lensGrid').append(card);
      });
      $('commonGround').textContent = brief.common_ground;
      $('unresolvedTension').textContent = brief.unresolved_tension;
      $('economicsAnalysis').textContent = brief.economics.analysis;
      $('thresholdList').replaceChildren();
      if (!brief.economics.thresholds.length) {
        $('thresholdList').append(makeElement('p', 'brief-section-copy', 'No defensible threshold can be set from the supplied evidence yet.'));
      } else {
        brief.economics.thresholds.forEach((threshold) => {
          const item = makeElement('div', 'threshold-item');
          item.append(
            makeElement('strong', '', `${threshold.metric} · ${threshold.trigger}`),
            makeElement('span', '', `${withSentencePunctuation(threshold.meaning)} Basis: ${withSentencePunctuation(threshold.basis)}`),
          );
          $('thresholdList').append(item);
        });
      }
      $('confidenceLabel').textContent = `${brief.recommendation.confidence} confidence`;
      $('recommendationMove').textContent = brief.recommendation.move;
      $('recommendationRationale').textContent = brief.recommendation.rationale;
      appendTextList($('changeAnswer'), brief.change_the_answer);
      $('actionsBody').replaceChildren();
      brief.next_actions.forEach((action) => {
        const row = document.createElement('tr');
        ['action', 'owner', 'evidence', 'timing'].forEach((key) => row.append(makeElement('td', '', action[key])));
        $('actionsBody').append(row);
      });
    }

    function renderContextSummary() {
      $('contextSummary').open = false;
      $('contextSummaryDecision').textContent = decisionInput.value.trim();
      const list = $('contextSummaryList');
      list.replaceChildren();
      state.questions.forEach((question) => {
        const item = makeElement('div', 'context-summary-item');
        item.append(makeElement('dt', '', question.label), makeElement('dd', '', state.answers[question.id] || ''));
        list.append(item);
      });
    }

    function renderOptionMatrix(options) {
      const criteria = [
        ['economics', 'Economics'],
        ['operational_effect', 'Operating effect'],
        ['reversibility', 'Reversibility'],
        ['risk', 'Risk'],
        ['evidence_needed', 'Evidence needed'],
      ];
      const container = $('optionMatrix');
      container.replaceChildren();

      const table = makeElement('table', 'decision-matrix');
      const head = document.createElement('thead');
      const headRow = document.createElement('tr');
      headRow.append(makeElement('th', '', 'Criterion'));
      options.forEach((option) => headRow.append(makeElement('th', '', option.name)));
      head.append(headRow);
      const body = document.createElement('tbody');
      criteria.forEach(([key, label]) => {
        const row = document.createElement('tr');
        const rowHeader = makeElement('th', '', label);
        rowHeader.scope = 'row';
        row.append(rowHeader);
        options.forEach((option) => row.append(makeElement('td', '', option[key])));
        body.append(row);
      });
      table.append(head, body);

      const mobile = makeElement('div', 'matrix-mobile');
      options.forEach((option) => {
        const card = makeElement('section', 'matrix-option');
        card.append(makeElement('h4', '', option.name));
        const list = document.createElement('dl');
        criteria.forEach(([key, label]) => {
          const row = makeElement('div', 'matrix-option-row');
          row.append(makeElement('dt', '', label), makeElement('dd', '', option[key]));
          list.append(row);
        });
        card.append(list);
        mobile.append(card);
      });
      container.append(table, mobile);
    }

    function briefToText(brief) {
      const lines = [
        'CLOUD & CAPITAL · DECISION BRIEF', '', brief.decision_summary, `Posture: ${brief.posture.label}`, brief.posture.rationale, '',
        'KNOWN FACTS', ...brief.known_facts.map((item) => `- ${item}`), '', 'WORKING ASSUMPTIONS',
        ...brief.working_assumptions.map((item) => `- ${item.assumption} — ${item.why_it_matters}`), '', 'OPTIONS',
      ];
      brief.options.forEach((option) => lines.push(`${option.name}\nEconomics: ${option.economics}\nOperating effect: ${option.operational_effect}\nReversibility: ${option.reversibility}\nRisk: ${option.risk}\nEvidence needed: ${option.evidence_needed}`, ''));
      lines.push('CROSS-FUNCTIONAL VIEW', `FinOps: ${brief.lenses.finops.view} Needs: ${brief.lenses.finops.need}`, `Finance: ${brief.lenses.finance.view} Needs: ${brief.lenses.finance.need}`, `Engineering: ${brief.lenses.engineering.view} Needs: ${brief.lenses.engineering.need}`, '', `Common ground: ${brief.common_ground}`, `Unresolved tension: ${brief.unresolved_tension}`, '', 'ECONOMICS & THRESHOLDS', brief.economics.analysis);
      brief.economics.thresholds.forEach((threshold) => lines.push('', `Metric: ${threshold.metric}`, `Trigger: ${threshold.trigger}`, `Meaning: ${withSentencePunctuation(threshold.meaning)} Basis: ${withSentencePunctuation(threshold.basis)}`));
      lines.push('', 'RECOMMENDATION', brief.recommendation.move, `${brief.recommendation.confidence} confidence — ${brief.recommendation.rationale}`, '', 'WHAT WOULD CHANGE THE ANSWER', ...brief.change_the_answer.map((item) => `- ${item}`), '', 'NEXT ACTIONS');
      brief.next_actions.forEach((action) => lines.push(`- ${action.action} | Owner: ${action.owner} | Evidence: ${action.evidence} | Timing: ${action.timing}`));
      lines.push('', 'AI-generated decision aid. Validate provider terms, calculations, and financially consequential decisions against primary data before acting.');
      return lines.join('\n');
    }

    $('copyBtn').addEventListener('click', async () => {
      if (!state.brief) return;
      try {
        await navigator.clipboard.writeText(briefToText(state.brief));
        $('copyState').textContent = 'Decision brief copied.';
      } catch {
        $('copyState').textContent = 'Copy was blocked by the browser. Use Print / Save PDF instead.';
      }
    });
    $('printBtn').addEventListener('click', () => window.print());
  </script>
</BaseLayout>
