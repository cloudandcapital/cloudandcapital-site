---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import LearningArtwork from '../components/LearningArtwork.astro';
import '../styles/services.css';
import '../styles/editorial-pages.css';
const topics = [
  {kind:'invest', title:'Investing foundations', text:'Stocks, ETFs, diversification, and the difference between investing and trading.', tint:'sage'},
  {kind:'chart', title:'Reading a chart', text:'Price, volume, timeframes, and levels. Learn what a chart shows and what it leaves out.', tint:'clay'},
  {kind:'trade', title:'Swing & day trading', text:'Compare approaches, describe a hypothetical setup, and understand risk before practicing.', tint:'sand'},
] as const;
---
<BaseLayout title="Investing & Trading Lessons | Cloud & Capital" description="One-to-one investing and beginner trading lessons with Diana Molski. Clear explanations, historical examples, and guided practice.">
  <main id="main-content" class="offer-page editorial-page learning-page">
    <section class="offer-shell editorial-hero"><div><p class="offer-eyebrow">Investing &amp; trading · One-to-one lessons</p><h1><span class="markets-title-line">Make the markets</span><br /><em>make more sense.</em></h1><p class="editorial-lede">Bring your questions. We’ll work through the concepts, the charts, and the parts that haven’t clicked yet.</p><p class="editorial-aside">A chart is information. It is not a permission slip.</p><div class="offer-actions"><a class="offer-button" href="#lesson-inquiry">Ask about a lesson →</a><a class="quiet-link" href="#lesson-topics">Explore the topics ↓</a></div></div><div class="editorial-hero-art"><LearningArtwork kind="hero" /></div></section>
    <section id="lesson-topics" class="offer-shell editorial-section"><div class="editorial-heading"><div><p class="offer-eyebrow">Choose a starting point</p><h2>One topic.<br /><em>Room for your questions.</em></h2></div><p>We start with what you already know. These are possible lesson topics, not a course you have to complete in order.</p></div><div class="topic-grid">{topics.map(t=><article class:list={['topic-card',t.tint]}><div class="topic-art"><LearningArtwork kind={t.kind} /></div><h3>{t.title}</h3><p>{t.text}</p></article>)}</div><p class="small-note">Options are a separate topic after the foundations make sense.</p></section>
    <section class="lesson-detail-band"><div class="offer-shell lesson-detail"><div><p class="offer-eyebrow">A tailored introductory lesson</p><h2>Leave with something<br /><em>you can work through.</em></h2><p>A 60–75 minute session, with the topic, format, and fixed fee agreed before booking.</p></div><ul class="lesson-inclusions"><li><strong>Start where you are.</strong><span>A short preparation questionnaire and one agreed topic.</span></li><li><strong>See it in context.</strong><span>Clear explanations, worked examples, and historical charts when useful.</span></li><li><strong>Try it yourself.</strong><span>A concise guide and a historical or paper practice task.</span></li><li><strong>Ask the follow-up.</strong><span>One question round within seven calendar days.</span></li></ul></div></section>
    <section class="offer-shell lesson-founder editorial-section"><img src="/images/diana-molski-portrait.png" alt="Diana Molski" width="820" height="806" loading="lazy"/><div><p class="offer-eyebrow">Your guide · Diana Molski</p><h2>Finance background.<br /><em>Human explanations.</em></h2><p>I studied finance and worked in wealth management at Morgan Stanley. I like helping people ask better questions about money—and making room for the ones they thought they should already know.</p><p class="small-note">Lessons teach concepts and practice. They do not provide personal investment recommendations, live trading signals, or promises of profitable results. Custom indicators and extensive platform setup are separate scopes.</p></div></section>
    <section id="lesson-inquiry" class="editorial-contact"><div class="offer-shell editorial-contact-grid"><div><p class="offer-eyebrow">Let’s start where you are</p><h2>What would you<br /><em>like to understand?</em></h2><p>Tell me the topic and what you’ve explored. No account balances or holdings are needed.</p><a class="quiet-link" href="/services">Here for business services? →</a></div><InquiryForm kind="learning" /></div></section>
  </main>
</BaseLayout>
