---
const credentials = [
  {
    category: 'AI workflows',
    image: '/images/claude-partner-badge-claude-code.png',
    alt: 'Claude Partner Badge, Claude Code, issued by Anthropic',
    width: 650,
    height: 650,
    name: 'Claude Partner Badge',
    detail: 'Claude Code',
    issuer: 'Anthropic',
    href: 'https://www.credly.com/org/anthropic/badge/claude-partner-badge-claude-code',
  },
  {
    category: 'Technology costs',
    image: '/images/finops-certified-practitioner.png',
    alt: 'FinOps Certified Practitioner badge, issued by The Linux Foundation',
    width: 600,
    height: 600,
    name: 'FinOps Certified',
    detail: 'Practitioner',
    issuer: 'The Linux Foundation',
    href: 'https://www.credly.com/org/the-linux-foundation/badge/finops-certified-practitioner.3/',
  },
];
---
<div class="featured-credentials" aria-label="Featured professional credentials">
  {credentials.map(credential => (
    <a class="featured-credential" href={credential.href} target="_blank" rel="noopener noreferrer">
      <p class="credential-category">{credential.category}</p>
      <img src={credential.image} alt={credential.alt} width={credential.width} height={credential.height} loading="lazy" decoding="async" />
      <h3>{credential.name}<span>{credential.detail}</span></h3>
      <p class="credential-issuer">Issued by {credential.issuer}</p>
      <span class="credential-link">Badge details <span aria-hidden="true">↗</span></span>
    </a>
  ))}
</div>
<style>
  .featured-credentials { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.5rem, 5vw, 4rem); width: min(100%, 39rem); margin: 2rem auto 2.25rem; }
  .featured-credential { display: flex; flex-direction: column; align-items: center; min-width: 0; color: #faf6ef; text-align: center; text-decoration: none; }
  .credential-category { margin: 0 0 1rem; color: #d1dfd6; font: 400 .61rem/1.5 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
  img { display: block; flex: none; width: 7.5rem; height: 7.5rem; object-fit: contain; }
  h3 { margin: 1rem 0 .45rem; font: 400 1.1rem/1.4 'Jost', sans-serif; }
  h3 span { display: block; font-weight: 500; }
  .credential-issuer { margin: 0; color: #d1dfd6; font: 400 .72rem/1.5 'Jost', sans-serif; }
  .credential-link { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; margin-top: auto; padding-top: .25rem; font: 400 .8rem/1.5 'Jost', sans-serif; text-decoration: underline; text-underline-offset: .2em; }
  .featured-credential:hover .credential-link { color: #f1cdca; }
  .featured-credential:focus-visible { outline: 2px solid #f1cdca; outline-offset: 7px; border-radius: 4px; }
  @media (max-width: 560px) {
    .featured-credentials { gap: 1.25rem; margin-block: 1.75rem 2rem; }
    .credential-category { min-height: 3em; margin-bottom: .65rem; font-size: .55rem; }
    img { width: 6.5rem; height: 6.5rem; }
    h3 { min-height: 4.2em; margin-top: .8rem; font-size: .92rem; }
    .credential-issuer { min-height: 3em; font-size: .67rem; }
    .credential-link { font-size: .75rem; }
  }
</style>
