---
interface Props { kind: 'hero' | 'cost' | 'workflow' | 'setup'; }
const { kind } = Astro.props;
---
<div class:list={['service-artwork', kind]} aria-hidden="true">
  {kind === 'hero' ? <svg viewBox="0 0 560 480" focusable="false">
    <ellipse cx="278" cy="261" rx="230" ry="174" fill="#dfe4d8" />
    <g transform="translate(72 95) rotate(-8 85 100)"><rect width="172" height="224" rx="9" fill="#fffaf4" stroke="#638374" stroke-width="1.6"/><path d="M25 40h72M25 54h102M25 80h122" stroke="#adb9ab" stroke-width="3" stroke-linecap="round"/><rect x="25" y="103" width="122" height="17" rx="3" fill="#d5dfd2"/><rect x="25" y="130" width="88" height="17" rx="3" fill="#e8c9c6"/><rect x="25" y="157" width="108" height="17" rx="3" fill="#c0cfba"/><path d="M25 196h61" stroke="#638374" stroke-width="2" stroke-linecap="round"/></g>
    <g transform="translate(230 179) rotate(5 120 90)"><rect width="240" height="176" rx="10" fill="#faf8f0" stroke="#638374" stroke-width="1.6"/><path d="M0 27h240" stroke="#adb9ab"/><circle cx="16" cy="14" r="3" fill="#b78783"/><circle cx="28" cy="14" r="3" fill="#b3c4a6"/><circle cx="40" cy="14" r="3" fill="#d2ba8d"/><rect x="23" y="54" width="57" height="37" rx="5" fill="#dce4d5"/><rect x="98" y="54" width="57" height="37" rx="5" fill="#e8c9c6"/><rect x="174" y="54" width="43" height="37" rx="5" fill="#dce4d5"/><path d="M80 72h18m57 0h19M51 91v28h143V91" fill="none" stroke="#638374" stroke-width="1.6"/><rect x="101" y="107" width="51" height="38" rx="5" fill="#6f8b77"/><path d="m116 125 7 7 14-15" fill="none" stroke="#fffaf4" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></g>
    <g fill="none" stroke="#a57573" stroke-width="2" stroke-linecap="round"><path d="M282 118c57-33 127-16 139 34m-13-9 13 10 6-17"/><path d="M127 345c-33 27-18 67 36 59m-13-8 16 7-11 12"/></g>
    <text x="239" y="81">what’s it costing?</text><text x="213" y="415">what’s worth changing?</text>
    <g transform="translate(444 329)"><ellipse cx="32" cy="42" rx="44" ry="12" fill="#c9d4c0"/><path d="M4 1h51v31c0 18-51 18-51 0z" fill="#e1b9b3" stroke="#a57573" stroke-width="1.4"/><path d="M55 7c27-3 22 25 0 23" fill="none" stroke="#a57573" stroke-width="2"/><ellipse cx="30" cy="1" rx="25" ry="7" fill="#faf5ee" stroke="#a57573" stroke-width="1.4"/><path d="M23-17c-11-9 10-12 1-23m16 24c-11-9 9-12 0-22" fill="none" stroke="#82917e" stroke-width="1.5"/></g>
  </svg> : <svg viewBox="0 0 360 205" focusable="false">
    {kind === 'cost' && <><ellipse cx="181" cy="172" rx="119" ry="15" fill="#b8c9ad" opacity=".5"/><g transform="translate(87 29) rotate(-7 66 65)"><rect width="135" height="136" rx="6" fill="#faf8ef" stroke="#5d7b69" stroke-width="1.5"/><path d="M20 25h61M20 39h91" stroke="#a7b9a0" stroke-width="3" stroke-linecap="round"/><rect x="20" y="64" width="95" height="13" rx="2" fill="#b0c5a3"/><rect x="20" y="87" width="67" height="13" rx="2" fill="#d4aeaa"/><path d="M20 117h95" stroke="#5d7b69"/></g><g transform="translate(195 83) rotate(9 45 41)"><rect width="78" height="89" rx="8" fill="#708b77"/><rect x="12" y="12" width="54" height="21" rx="3" fill="#edf0e6"/>{[0,1,2].map(r=>[0,1,2].map(c=><rect x={14+c*19} y={44+r*12} width="11" height="6" rx="2" fill="#d9e2d1"/>))}</g></>}
    {kind === 'workflow' && <><path d="M85 107c35-42 56 39 89-5s65-13 92 4" fill="none" stroke="#b78582" stroke-width="1.8" stroke-dasharray="4 5"/><g transform="translate(56 48) rotate(-7 35 42)"><rect width="74" height="94" rx="5" fill="#faf8ef" stroke="#9e7573" stroke-width="1.4"/><path d="M16 23h41M16 37h31M16 51h41" stroke="#c5a09a" stroke-width="3" stroke-linecap="round"/><path d="m19 72 7 6 12-15" fill="none" stroke="#718574" stroke-width="2"/></g><g transform="translate(148 73) rotate(5 31 29)"><rect width="65" height="73" rx="5" fill="#dce4d3" stroke="#718574" stroke-width="1.4"/><path d="M17 19h32M17 33h23M17 47h32" stroke="#8a9c80" stroke-width="3" stroke-linecap="round"/></g><g transform="translate(249 52)"><rect width="64" height="82" rx="5" fill="#faf8ef" stroke="#9e7573" stroke-width="1.4"/><path d="M16 22h31M16 36h24M16 50h31" stroke="#c5a09a" stroke-width="3" stroke-linecap="round"/></g><path d="M89 164h180m-10-7 10 7-10 7" fill="none" stroke="#718574" stroke-width="2" stroke-linecap="round"/></>}
    {kind === 'setup' && <><ellipse cx="179" cy="171" rx="115" ry="12" fill="#c9c7b8" opacity=".5"/><rect x="88" y="40" width="187" height="120" rx="7" fill="#faf8ef" stroke="#718574" stroke-width="1.5"/><path d="M88 62h187" stroke="#b7c0ae"/><circle cx="101" cy="51" r="2.5" fill="#c49a93"/><circle cx="112" cy="51" r="2.5" fill="#abc09e"/><rect x="103" y="76" width="53" height="67" rx="3" fill="#dce4d3"/><path d="M114 92h32M114 106h24M114 120h32" stroke="#94aa87" stroke-width="3" stroke-linecap="round"/><path d="M174 91h79M174 108h48M174 125h65" stroke="#c8b8a2" stroke-width="5" stroke-linecap="round"/><circle cx="261" cy="145" r="28" fill="#708b77"/><path d="m247 146 10 10 19-23" fill="none" stroke="#faf8ef" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M62 76l-10-3m14-11-6-9m17 3-1-12M288 30l7-7m-1 18 11-1" stroke="#b78582" stroke-width="2" stroke-linecap="round"/></>}
  </svg>}
</div>
<style>
  .service-artwork{width:100%;} svg{width:100%;height:auto;display:block;} text{font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;fill:#855e5d;font-size:29px;}
</style>
