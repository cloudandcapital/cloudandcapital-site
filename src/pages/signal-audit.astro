---
import BaseLayout from '../layouts/BaseLayout.astro';
import SignalAuditResults from '../components/SignalAuditResults.astro';
import { EXAMPLE, scoreAudit } from '../lib/signal-audit.js';
import '../styles/signal-audit.css';
const renewalExample = scoreAudit(EXAMPLE.answers);
---
<BaseLayout title="Signal Audit: put technology costs to work | Cloud & Capital" description="Answer 12 questions about technology spending. Find where information gets stuck, what to check first, and who to involve. Free, with no sign-up.">
  <main id="main-content" class="audit-main">
    <header class="audit-hero audit-rail">
      <a class="audit-back" href="/tools">← All free tools</a>
      <div class="audit-hero-grid">
        <div class="audit-hero-copy">
          <p class="audit-eyebrow">Technology costs · Signal Audit</p>
          <h1><span>Can your cost reports</span> <em>change a decision?</em></h1>
          <p class="audit-dek">Find what gets lost between the bill and the decision. Answer 12 questions to get a first step, someone to involve, and a way to check progress.</p>
          <p class="audit-fit">For cloud, AI, and software spending in a business. Choose one team, product, or part of the business you know.</p>
          <div class="audit-meta"><span>12 questions</span><span>About 5 minutes</span><span>No sign-up</span><span>Instant result</span></div>
          <div class="audit-hero-actions"><a class="audit-text-action" href="/insights/using-signal-audit">How to use the result <span aria-hidden="true">→</span></a></div>
        </div>
        <aside class="audit-preview" aria-labelledby="previewTitle">
          <div class="audit-preview-top"><p class="audit-eyebrow">Example result</p><span class="audit-preview-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="m7 11 3 3 7-7"/><path d="M19 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h7"/></svg></span></div>
          <p class="audit-preview-scope">One team · Software renewals</p>
          <h2 id="previewTitle">{renewalExample.priority.title}</h2>
          <dl class="audit-preview-details">
            <div><dt>Who to involve</dt><dd>{renewalExample.priority.owners}</dd></div>
            <div><dt>What to check</dt><dd>{renewalExample.priority.measures[0]}</dd></div>
          </dl>
          <button id="exampleButton" type="button" class="audit-text-action">Explore this example <span aria-hidden="true">→</span></button>
        </aside>
      </div>
    </header>
    <div id="liveStatus" class="audit-sr-only" role="status" aria-live="polite"></div>
    <noscript><p class="audit-rail audit-notice">The questionnaire needs JavaScript. You can still <a href="/insights/using-signal-audit">read the guide and worked example</a>.</p></noscript>
    <section id="auditStage" class="audit-rail audit-stage" aria-label="Signal Audit questionnaire">
      <form id="auditForm" novalidate>
        <div id="setupPanel" class="audit-panel">
          <p class="audit-eyebrow">Start with one scope</p>
          <h2 id="stageTitle" tabindex="-1">What are you reviewing?</h2>
          <p class="audit-intro">Keep the same scope in mind for every answer. One person can cover several roles. Your choices set the context; the scoring rules stay the same.</p>
          <fieldset><legend>Which part of the business?</legend><div id="targetScopes" class="audit-choices"></div></fieldset>
          <fieldset><legend>Which technology spending? <span>Choose one or more</span></legend><div id="technologyScopes" class="audit-choices"></div><p class="audit-field-help">Choose individual categories, or Mixed technology portfolio for the whole mix.</p></fieldset>
          <p class="audit-privacy">Your answers and result stay in this browser tab. Copy or print the result before leaving. Site analytics record tool activity, without your answers.</p>
          <p id="scopeResetWarning" class="audit-notice" role="status" hidden></p>
          <p id="setupError" class="audit-error" role="alert"></p>
          <div class="audit-controls audit-controls-end"><button class="audit-button primary" type="button" id="beginButton" aria-describedby="setupError scopeResetWarning">Begin the audit →</button></div>
        </div>
        <div id="questionPanel" class="audit-panel" hidden>
          <p id="scopeChangeNotice" class="audit-notice" hidden>You changed the scope, so the earlier answers have been cleared. Answer for this scope from the start.</p>
          <div class="audit-progress-head"><div><p id="dimensionName" class="audit-eyebrow"></p><p id="progressText"></p></div><span id="questionNumber" aria-hidden="true"></span></div>
          <div id="questionProgress" role="progressbar" aria-label="Question progress" aria-valuemin="1" aria-valuemax="12" aria-valuenow="1"><div id="segments" class="audit-segments" aria-hidden="true"></div></div>
          <fieldset aria-describedby="answerHelp questionExample"><legend id="questionPrompt" tabindex="-1"></legend><p id="questionExample" class="audit-field-help"></p><p id="answerHelp" class="audit-field-help">Choose the closest answer to what happens today.</p><div id="answerChoices" class="audit-choices audit-answers"></div></fieldset>
          <p id="answerError" class="audit-error" role="alert"></p>
          <div class="audit-controls"><button class="audit-button secondary" type="button" id="previousButton">← Previous</button><button class="audit-button primary" type="button" id="nextButton" aria-describedby="answerError">Next →</button></div>
        </div>
      </form>
    </section>
    <SignalAuditResults />
  </main>
  <script>
    import { mountSignalAudit } from '../lib/signal-audit-ui.js';
    mountSignalAudit(document);
  </script>
</BaseLayout>
