---
import BaseLayout from '../layouts/BaseLayout.astro';
import { newsletter, writing, writingFeatured } from '../data/siteContent';

const archive = writing.slice(1);
---

<BaseLayout
  title="Writing | Cloud & Capital"
  description="Research and field notes on cloud economics, AI infrastructure, technology spend, and capital allocation."
>
  <main id="main-content">
    <section class="writing-hero" aria-labelledby="writing-title">
      <div class="writing-container writing-hero-grid">
        <div class="writing-hero-copy">
          <p class="section-label">Writing</p>
          <h1 id="writing-title">Cloud economics, AI infrastructure, and the decisions behind the bill.</h1>
          <p>Research and field notes on technology spend, capital allocation, and the operating choices shaping the bill.</p>
        </div>
        <div class="manuscript-visual" aria-label="Cloud and Capital annotated research manuscript">
          <div class="manuscript-paper">
            <p class="manuscript-label">Research note</p>
            <p class="manuscript-subject">Cloud economics / AI infrastructure</p>
            <div class="manuscript-lines" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <p class="manuscript-fragment">capital follows capacity</p>
            <p class="manuscript-fragment manuscript-fragment-offset">cost reveals the decision later</p>
            <aside class="manuscript-annotation" aria-label="Margin annotation">
              <em>capacity first →<br />cost follows.</em>
            </aside>
            <p class="manuscript-meta">C&amp;C research desk · issue file</p>
          </div>
        </div>
      </div>
    </section>

    <section class="newsletter-feature" aria-labelledby="newsletter-title">
      <div class="writing-container newsletter-feature-inner">
        <div>
          <p class="section-label section-label-light">{newsletter.label}</p>
          <h2 id="newsletter-title">{newsletter.title}</h2>
        </div>
        <div class="newsletter-feature-detail">
          <p>{newsletter.description}</p>
          <div class="newsletter-actions">
            <a href={newsletter.subscribeHref} target="_blank" rel="noopener noreferrer" data-analytics-event="cta_click" data-analytics-destination="substack" data-analytics-source="writing_newsletter">Subscribe on Substack <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="featured-article" aria-labelledby="featured-title">
      <div class="writing-container">
        <div class="featured-article-heading">
          <p class="section-label">Featured</p>
        </div>
        <a class="featured-article-link" href={writingFeatured.href} target="_blank" rel="noopener noreferrer" data-analytics-event="cta_click" data-analytics-destination="substack" data-analytics-source="writing_featured">
          <div class="featured-article-copy">
            <p class="article-meta">{writingFeatured.date} <span>{writingFeatured.topic}</span></p>
            <h2 id="featured-title">{writingFeatured.title}</h2>
            <p>{writingFeatured.description}</p>
            <span>READ ARTICLE <span aria-hidden="true">→</span></span>
          </div>
          <div class="featured-article-image">
            <img src={writingFeatured.image} alt={writingFeatured.imageAlt} />
          </div>
        </a>
      </div>
    </section>

    <section class="writing-archive" aria-labelledby="archive-title">
      <div class="writing-container">
        <div class="archive-heading">
          <p class="section-label">Archive</p>
          <h2 id="archive-title">Recent writing.</h2>
        </div>
        <div class="archive-grid">
          {archive.map((article) => (
            <a href={article.href} target="_blank" rel="noopener noreferrer" class="archive-entry" data-analytics-event="cta_click" data-analytics-destination="substack" data-analytics-source="writing_archive">
              <div class="archive-image">
                <img src={article.archiveImage} alt={article.archiveImageAlt} loading="lazy" />
              </div>
              <div class="archive-copy">
                <p class="article-meta">{article.date} <span>{article.topic}</span></p>
                <h3>{article.title}</h3>
                <p>{article.description}</p>
                <span class="archive-link">READ ARTICLE <span aria-hidden="true">→</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="writing-cta" aria-labelledby="writing-cta-title">
      <div class="writing-container writing-cta-inner">
        <div>
          <p class="section-label section-label-gold">From research to systems</p>
          <h2 id="writing-cta-title">See the tools behind<br class="writing-cta-break" /> the analysis.</h2>
        </div>
        <a href="/work" data-analytics-event="cta_click" data-analytics-destination="work" data-analytics-source="writing_contact">Explore the work <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main { overflow: hidden; background: #f5eee9; }
  .writing-container { width: calc(100% - 7rem); margin: 0 auto; }
  .writing-hero, .featured-article, .writing-archive { padding: clamp(4.5rem, 5.5vw, 5.5rem) 0; }
  .writing-hero { padding-top: clamp(6rem, 8vw, 7rem); padding-bottom: clamp(4.5rem, 5.5vw, 5.5rem); }
  .writing-hero-grid, .newsletter-feature-inner, .featured-article-link, .archive-grid, .writing-cta-inner { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(3.5rem, 5vw, 5.5rem); align-items: start; }
  .section-label { margin: 0 0 1.25rem; font-family: 'DM Mono', monospace; font-size: .62rem; letter-spacing: .18em; line-height: 1.5; text-transform: uppercase; color: #6b8e7f; }
  .section-label::after { content: ''; display: inline-block; width: 3rem; height: 1px; margin: 0 0 .25rem .75rem; background: currentColor; opacity: .55; }
  .writing-hero h1, h2, h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 300; color: #000; }
  .writing-hero h1 { max-width: 14ch; margin: 0; font-size: clamp(3.1rem, 4.4vw, 4.75rem); line-height: .98; letter-spacing: -.035em; }
  .writing-hero-copy > p:last-child { max-width: 58ch; margin: 2rem 0 0; font-family: 'DM Sans', sans-serif; font-size: clamp(.95rem, 1.4vw, 1.08rem); line-height: 1.82; color: #4a4a4a; }
  .manuscript-visual { position: relative; display: grid; place-items: center; justify-self: start; width: 91%; max-width: none; aspect-ratio: 13 / 10; min-height: 0; padding: clamp(1.15rem, 2vw, 1.85rem); overflow: hidden; background: #71685e; border-top: 1px solid #6b8e7f; }
  .manuscript-paper { position: relative; box-sizing: border-box; width: calc(100% - clamp(.75rem, 1.15vw, 1.1rem)); height: calc(100% - clamp(.75rem, 1.15vw, 1.1rem)); min-height: 0; padding: clamp(1.2rem, 2vw, 1.75rem); background: #fbfaf7; border: 1px solid rgba(33,31,27,.14); box-shadow: 0 .55rem 1.1rem rgba(33,31,27,.13); }
  .manuscript-label, .manuscript-subject, .manuscript-meta { margin: 0; font-family: 'DM Mono', monospace; font-size: .57rem; letter-spacing: .13em; line-height: 1.5; text-transform: uppercase; }
  .manuscript-label { color: #55796c; }
  .manuscript-subject { margin-top: .55rem; color: #514c45; }
  .manuscript-lines { position: absolute; right: clamp(1.2rem, 2vw, 1.75rem); bottom: 3.35rem; left: clamp(1.2rem, 2vw, 1.75rem); display: grid; grid-template-rows: repeat(6, 1fr); height: 4.15rem; }
  .manuscript-lines span { border-top: 1px solid rgba(33,31,27,.1); }
  .manuscript-fragment { position: absolute; top: 39%; left: clamp(1.2rem, 2vw, 1.75rem); width: fit-content; max-width: calc(100% - clamp(7.25rem, 14vw, 8.75rem)); margin: 0; padding: .1rem .22rem; background: rgba(221,185,119,.55); font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.3rem, 2vw, 1.75rem); line-height: 1.1; color: #211f1b; }
  .manuscript-fragment-offset { top: 55%; margin-left: clamp(.25rem, 1vw, .75rem); background: rgba(168,192,181,.48); }
  .manuscript-annotation { position: absolute; top: 41%; right: clamp(1.75rem, 3vw, 2.25rem); width: clamp(6.25rem, 11vw, 7rem); margin: 0; padding-left: clamp(.45rem, 1vw, .7rem); border-left: 1px solid rgba(85,121,108,.65); color: #4b463f; }
  .manuscript-annotation em { font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(.82rem, 1.22vw, 1rem); font-style: italic; line-height: 1.05; white-space: nowrap; }
  .manuscript-meta { position: absolute; left: clamp(1.35rem, 2.5vw, 2.25rem); bottom: 1.3rem; color: #3d6055; }
  .newsletter-feature { padding: clamp(4.5rem, 5.5vw, 5.5rem) 0; background: #000; color: #f5eee9; }
  .section-label-light { color: #ddb977; }.section-label-light::after { opacity: .4; }
  .newsletter-feature h2 { max-width: 18ch; margin: 0; font-size: clamp(2.4rem, 4.275vw, 4.5rem); line-height: .99; color: #f5eee9; }
  .newsletter-feature-inner { align-items: center; }
  .newsletter-feature-detail { display: flex; flex-direction: column; justify-content: center; }
  .newsletter-feature-detail > p { max-width: 34ch; margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.2rem, 1.55vw, 1.42rem); font-style: italic; font-weight: 400; line-height: 1.5; letter-spacing: -.005em; color: rgba(245,238,233,.78); }
  .newsletter-actions { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2rem; }
  .newsletter-actions a, .featured-article-copy > span, .archive-link { font-family: 'DM Mono', monospace; font-size: .62rem; letter-spacing: .12em; line-height: 1.5; text-transform: uppercase; text-decoration: none; }
  .newsletter-actions a { padding: .9rem 1.2rem; background: #6b8e7f; color: #fff; }
  .newsletter-actions a:hover { background: #86a89a; border-color: #86a89a; }
  .featured-article { padding-top: clamp(2.5rem, 3.5vw, 3.25rem); padding-bottom: clamp(2.5rem, 4vw, 3.25rem); background: #fbfaf7; }
  .featured-article-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; margin-bottom: 1.5rem; }
  .featured-article-heading .section-label { margin-bottom: 0; }
  .featured-article-heading > p:last-child { margin: 0; font-family: 'DM Mono', monospace; font-size: .58rem; letter-spacing: .14em; text-transform: uppercase; color: #8b8b8b; }
  .featured-article-link { padding: clamp(2.1rem, 2.75vw, 2.5rem) 0 clamp(1.75rem, 2.5vw, 2.25rem); border-top: 2px solid #6b8e7f; border-bottom: 1px solid rgba(0,0,0,.13); color: inherit; text-decoration: none; }
  .featured-article-link > * { min-width: 0; }
  .featured-article-copy { width: min(100%, 33.75rem); padding: .25rem clamp(1.5rem, 5vw, 4.5rem) 1rem 0; display: flex; flex-direction: column; justify-content: flex-start; }
  .article-meta { margin: 0 0 .9rem; font-family: 'DM Mono', monospace; font-size: .58rem; letter-spacing: .13em; line-height: 1.5; text-transform: uppercase; color: #6b8e7f; }
  .featured-article-copy .article-meta { white-space: normal; }
  .article-meta span::before { content: '·'; margin: 0 .5rem; color: #b88c45; }
  .featured-article-copy h2 { max-width: 15ch; margin: 0 0 1.25rem; font-size: clamp(2.5rem, 4.2vw, 4.45rem); line-height: .99; }
  .featured-article-copy > p { max-width: 44ch; margin: 0; font-family: 'DM Sans', sans-serif; font-size: .93rem; line-height: 1.83; color: #4a4a4a; }
  .featured-article-copy > span { margin-top: 2.25rem; color: #3d6055; }
  .featured-article-image { aspect-ratio: 40 / 21; overflow: hidden; background: #ebe3db; }
  .featured-article-image img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .featured-article-link:hover .featured-article-copy > span { text-decoration: underline; text-underline-offset: .3em; }
  .writing-archive { background: #f5eee9; border-top: 1px solid rgba(0,0,0,.1); }
  .archive-heading { max-width: 46rem; margin-bottom: 3.25rem; }
  .archive-heading h2, .writing-cta h2 { margin: 0; font-size: clamp(2.25rem, 4vw, 4rem); line-height: 1.03; letter-spacing: -.025em; }
  .archive-grid { row-gap: clamp(2.25rem, 3.5vw, 3.25rem); border-top: 1px solid rgba(0,0,0,.16); padding-top: clamp(2rem, 3vw, 2.75rem); }
  .archive-entry { display: grid; grid-template-columns: clamp(11.25rem, 15vw, 13.75rem) minmax(0, 1fr); column-gap: clamp(1rem, 2vw, 1.5rem); align-items: start; min-width: 0; color: inherit; text-decoration: none; }
  .archive-image { aspect-ratio: 4 / 3; overflow: hidden; background: #e6ddd4; }
  .archive-image img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
  .archive-entry:hover .archive-image img { transform: scale(1.025); }
  .archive-copy { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .archive-entry h3 { margin: 0 0 .9rem; font-size: clamp(1.5rem, 2.2vw, 2rem); line-height: 1.04; }
  .archive-copy > p:last-of-type { max-width: 40ch; margin: 0; font-family: 'DM Sans', sans-serif; font-size: .86rem; line-height: 1.7; color: #4a4a4a; }
  .archive-link { display: inline-block; padding-top: 1rem; color: #3d6055; white-space: nowrap; }
  .archive-entry:hover .archive-link { text-decoration: underline; text-underline-offset: .3em; }
  .writing-cta { padding: clamp(4.5rem, 5.5vw, 5.5rem) 0; background: #3d6055; }
  .writing-cta-inner { align-items: center; }
  .section-label-gold { color: #ddb977; }.section-label-gold::after { opacity: .4; }
  .writing-cta h2 { max-width: 24ch; color: #fff; }
  .writing-cta a { justify-self: end; padding: .95rem 1.3rem; background: #fff; color: #3d6055; font-family: 'DM Mono', monospace; font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; text-decoration: none; white-space: nowrap; }
  .writing-cta a:hover { background: #f5eee9; }
  @media (max-width: 900px) {
    .writing-hero-grid, .newsletter-feature-inner, .featured-article-link, .writing-cta-inner { grid-template-columns: 1fr; }
    .writing-hero-grid { gap: 0; }.manuscript-visual { width: min(91%, 42rem); margin-top: 3rem; }
    .newsletter-feature-detail { justify-content: start; }.featured-article-copy { padding: 2.5rem 0; }.featured-article-image { width: 100%; order: -1; }
  }
  @media (max-width: 720px) {
    .writing-container { width: calc(100% - 2.5rem); }.writing-hero h1 { max-width: 12ch; }.featured-article-heading { display: block; }.featured-article-heading > p:last-child { margin-top: .75rem; }
    .archive-grid { grid-template-columns: 1fr; gap: 2.25rem; }.archive-entry { grid-template-columns: clamp(7.5rem, 32vw, 8.75rem) minmax(0, 1fr); column-gap: 1rem; }.archive-link { padding-top: 1rem; }
    .writing-cta-inner { align-items: start; }.writing-cta a { justify-self: start; }.writing-cta-break { display: none; }
  }
  @media (max-width: 480px) {
    .writing-hero { padding-top: 6.75rem; }.writing-hero h1 { font-size: clamp(2.85rem, 14vw, 4rem); }.newsletter-actions { flex-direction: column; }.newsletter-actions a { text-align: center; }
    .manuscript-visual { min-height: 22.5rem; margin-top: 2.5rem; }.manuscript-paper { min-height: 16.2rem; padding: 1.25rem; }.manuscript-lines { right: 1.25rem; bottom: 2.5rem; left: 1.25rem; height: 2.5rem; }.manuscript-fragment { max-width: calc(100% - 6.8rem); }.manuscript-annotation { top: 41%; right: .8rem; width: 4.75rem; padding-left: .4rem; }.manuscript-annotation em { font-size: .68rem; }
    .featured-article-copy { padding-top: 2rem; padding-bottom: 2.5rem; }
  }
</style>
