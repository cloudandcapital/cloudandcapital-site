---
import '../styles/global.css';
import '../styles/type.css';
import HeadMeta from '../components/HeadMeta.astro';
import Analytics from '../components/Analytics.astro';
import FooterSocialLinks from '../components/FooterSocialLinks.astro';
import { footerLinks, navigation } from '../data/siteContent';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Cloud & Capital',
  description = '',
  noindex = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <HeadMeta title={title} description={description} noindex={noindex} />
    <Analytics />
  </head>
  <body>
    <style>
      .site-nav {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 200;
        padding: 1.25rem 3.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(245,238,233,.96);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(0,0,0,.07);
      }
      .site-nav-logo {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 44px;
        gap: 1px;
        text-decoration: none;
      }
      .site-nav-logo-main {
        font-family: 'Cormorant Garamond', 'Georgia', serif;
        font-size: 1rem;
        font-weight: 500;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: #000;
      }
      .site-nav-logo-sub {
        font-family: 'DM Mono', monospace;
        font-size: .54rem;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #4A4A4A;
      }
      .site-nav-links {
        display: flex;
        gap: 2rem;
        list-style: none;
        margin: 0; padding: 0;
        align-items: center;
      }
      .site-nav-links a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding-inline: .25rem;
        font-family: 'DM Mono', monospace;
        font-size: .75rem;
        font-weight: 500;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: #4A4A4A;
        text-decoration: none;
        transition: color .2s;
      }
      .site-nav-links a:hover { color: #000; }
      .site-nav-links a:focus-visible, .site-nav-logo:focus-visible, .site-nav-toggle:focus-visible { outline: 2px solid #3d6055; outline-offset: 4px; }
      .site-nav-dropdown { position: relative; }
      .site-nav-dropdown::after { content: ''; position: absolute; top: 100%; left: -0.5rem; right: -0.5rem; height: 1rem; z-index: 209; }
      .site-nav-dropdown-btn {
        font-family: 'DM Mono', monospace;
        font-size: .58rem;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: #4A4A4A;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        display: flex;
        align-items: center;
        gap: .3rem;
        transition: color .2s;
      }
      .site-nav-dropdown-btn:hover { color: #000; }
      .site-nav-chevron { font-size: .48rem; display: inline-block; transition: transform .2s; }
      .site-nav-dropdown:hover .site-nav-chevron,
      .site-nav-dropdown.is-open .site-nav-chevron { transform: rotate(180deg); }
      .site-nav-dropdown-menu {
        display: none;
        position: absolute;
        top: calc(100% + .85rem);
        right: 0;
        background: #faf7f2;
        border: 1px solid rgba(0,0,0,.08);
        box-shadow: 0 8px 28px rgba(0,0,0,.08);
        list-style: none;
        padding: .4rem 0;
        min-width: 168px;
        z-index: 210;
      }
      .site-nav-dropdown:hover .site-nav-dropdown-menu,
      .site-nav-dropdown:focus-within .site-nav-dropdown-menu,
      .site-nav-dropdown.is-open .site-nav-dropdown-menu { display: block; }
      .site-nav-dropdown-menu li a {
        display: block;
        padding: .55rem 1.25rem;
        font-family: 'DM Mono', monospace;
        font-size: .58rem;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: #4A4A4A;
        text-decoration: none;
        transition: color .15s, background .15s;
        white-space: nowrap;
      }
      .site-nav-dropdown-menu li a:hover { color: #000; background: rgba(107,142,127,.07); }
      .site-nav-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-width: 44px;
        min-height: 44px;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 6px 4px;
        z-index: 201;
      }
      .site-nav-toggle span {
        display: block;
        width: 22px;
        height: 1.5px;
        background: #000;
        border-radius: 2px;
        transition: background .25s;
      }
      .site-nav-toggle.is-open span { background: rgba(244,239,230,.9); }
      .site-footer {
        padding: 1.75rem 0 1.5rem;
        background: #211f1b;
        border-top: 1px solid rgba(245,238,233,.13);
      }
      .site-footer-top { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1.5rem; }
      .site-footer-logo {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.1rem;
        font-weight: 500;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: #f5eee9;
        text-decoration: none;
      }
      .site-footer-logo:focus-visible, .site-footer-links a:focus-visible { outline: 2px solid #f5eee9; outline-offset: 4px; }
      .site-footer-links { display: flex; flex-wrap: wrap; justify-content: center; gap: .25rem 1.5rem; list-style: none; margin: 0; padding: 0; }
      .site-footer-links a { display: inline-flex; align-items: center; min-height: 44px; font-family: 'DM Mono', monospace; font-size: .72rem; letter-spacing: .075em; text-transform: uppercase; color: rgba(245,238,233,.76); text-decoration: none; transition: color .2s; }
      .site-footer-links a:hover { color: #f5eee9; }
      .site-footer-social { justify-self: end; }
      .site-footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.25rem; padding-top: 1.15rem; border-top: 1px solid rgba(245,238,233,.13); }
      .site-footer-copy { font-family: 'DM Mono', monospace; font-size: .68rem; line-height: 1.6; color: rgba(245,238,233,.68); }
      .site-footer-tagline { font-family: 'DM Mono', monospace; font-size: .68rem; line-height: 1.6; letter-spacing: .07em; text-transform: uppercase; color: rgba(245,238,233,.68); }
      @media (max-width: 1020px) {
        .site-footer-top { grid-template-columns: 1fr; justify-items: start; gap: .35rem; }
        .site-footer-links { justify-content: flex-start; }
        .site-footer-social { justify-self: start; }
      }
      @media (max-width: 1020px) {
        .site-nav { padding: 1rem 1.25rem; }
        .site-nav-toggle { display: flex; z-index: 301; }
        .site-nav-links {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          background: #191714;
          flex-direction: column;
          align-items: flex-start;
          justify-content: flex-start;
          gap: 0;
          z-index: 300;
          list-style: none;
          padding: .75rem 0 1.25rem;
          max-height: calc(100vh - 60px);
          overflow-y: auto;
          border-top: 1px solid rgba(255,255,255,.06);
          box-shadow: 0 12px 32px rgba(0,0,0,.35);
        }
        .site-nav-links.is-open { display: flex; }
        .site-nav-links > li { width: 100%; }
        .site-nav-links a {
          display: flex;
          padding: .8rem 1.75rem;
          font-size: .8125rem;
          letter-spacing: .07em;
          color: rgba(244,239,230,.9);
        }
        .site-nav-links a:hover { color: rgba(244,239,230,1); }
        .site-nav-links a:focus-visible { outline-color: #f5eee9; outline-offset: -4px; }
        .site-nav-dropdown { width: 100%; }
        .site-nav-dropdown-btn { display: block; width: 100%; padding: .8rem 1.75rem; text-align: left; color: rgba(244,239,230,.65); font-size: .68rem; letter-spacing: .16em; }
        .site-nav-dropdown-btn:hover { color: rgba(244,239,230,1); }
        .site-nav-dropdown-menu { position: static; background: rgba(255,255,255,.04); border: none; box-shadow: none; padding: .25rem 0; min-width: 0; text-align: left; }
        .site-nav-dropdown-menu li a { padding: .6rem 1.75rem .6rem 2.75rem; color: rgba(244,239,230,.42); font-size: .63rem; background: transparent; }
        .site-nav-dropdown-menu li a:hover { color: rgba(244,239,230,.85); background: transparent; }
        .site-footer-links { gap: 0 1.25rem; }
        .site-footer-bottom { flex-wrap: wrap; gap: .4rem 1rem; }
      }
    </style>
    <nav class="site-nav">
      <a class="site-nav-logo" href="/"><span class="site-nav-logo-main">Cloud &amp; Capital</span><span class="site-nav-logo-sub">Turning numbers into strategy.</span></a>
      <button type="button" class="site-nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="tool-nav-links" id="tool-nav-toggle">
        <span></span><span></span><span></span>
      </button>
      <ul class="site-nav-links" id="tool-nav-links">
        {navigation.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
    <script>
      (function() {
        var toggle = document.getElementById('tool-nav-toggle');
        var links = document.getElementById('tool-nav-links');
        if (!toggle || !links) return;
        toggle.addEventListener('click', function() {
          var isOpen = links.classList.toggle('is-open');
          toggle.classList.toggle('is-open', isOpen);
          toggle.setAttribute('aria-expanded', String(isOpen));
          toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
          document.body.style.overflow = isOpen ? 'hidden' : '';
        });
        document.addEventListener('keydown', function(event) {
          if (event.key === 'Escape' && links.classList.contains('is-open')) {
            toggle.click();
            toggle.focus();
          }
        });
        links.querySelectorAll('a').forEach(function(a) {
          a.addEventListener('click', function() {
            links.classList.remove('is-open');
            toggle.classList.remove('is-open');
            toggle.setAttribute('aria-expanded', 'false');
            toggle.setAttribute('aria-label', 'Open menu');
            document.body.style.overflow = '';
          });
        });
      })();
    </script>
    <slot />
    <footer class="site-footer">
      <div class="site-shell site-footer-inner">
        <div class="site-footer-top">
          <a class="site-footer-logo" href="/">Cloud &amp; Capital</a>
          <ul class="site-footer-links">
            {footerLinks.map((link) => <li><a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a></li>)}
          </ul>
          <div class="site-footer-social"><FooterSocialLinks /></div>
        </div>
        <div class="site-footer-bottom">
          <span class="site-footer-copy">© 2026 Cloud &amp; Capital</span>
          <span class="site-footer-tagline">TURNING NUMBERS INTO STRATEGY.</span>
        </div>
      </div>
    </footer>
  </body>
</html>
