    font-size: .68rem;
    letter-spacing: .16em;
    color: rgba(244,239,230,.65);
  }
  .nav-links a:hover { color: rgba(244,239,230,1); }

  /* ── Tools dropdown (mobile, inside nav panel) ── */
  .nav-has-dropdown { width: 100%; }
  .nav-dropdown-btn { display: block; width: 100%; padding: .8rem 1.75rem; text-align: left; color: rgba(244,239,230,.65); font-size: .68rem; letter-spacing: .16em; }
  .nav-dropdown-btn:hover { color: rgba(244,239,230,1); }
  .nav-dropdown-menu { position: static; background: rgba(255,255,255,.04); border: none; box-shadow: none; padding: .25rem 0; min-width: 0; text-align: left; }
  .nav-dropdown-menu li a { padding: .6rem 1.75rem .6rem 2.75rem; color: rgba(244,239,230,.42); font-size: .63rem; background: transparent; }
  .nav-dropdown-menu li a:hover { color: rgba(244,239,230,.85); background: transparent; }

  /* ── Advisory: stack photo over content ── */
  .advisory-inner {
    grid-template-columns: 1fr !important;
    gap: 2rem !important;
  }
  .adv-photo {
    width: min(280px, 90%) !important;
    margin: 0 auto !important;
  }
  .adv-content {
    padding: 2.5rem 1.5rem !important;
  }

  /* ── Discipline 4-col inline grid → 1 col ── */
  section#discipline > div[style*="display:grid"][style*="grid-template-columns"] {
    grid-template-columns: 1fr !important;
  }

  /* ── Work: stack editorial grid ── */
  .work-editorial-grid {
    grid-template-columns: 1fr !important;
  }
  .work-feature-copy { min-height: auto; }
  .work-feature-right { min-height: 360px; }

  /* ── Writing: restore padding removed by full-bleed desktop rule ── */
