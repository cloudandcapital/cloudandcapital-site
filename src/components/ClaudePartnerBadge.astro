---
interface Props { dark?: boolean; }
const { dark = false } = Astro.props;
---
<aside class:list={['claude-credential', { 'on-dark': dark }]} aria-label="Claude Code partner badge">
  <img src="/images/claude-partner-badge-claude-code.png" alt="Claude Partner Badge, Claude Code" width="650" height="650" loading="lazy" decoding="async" />
  <div>
    <p class="badge-issuer">Issued by Anthropic</p>
    <p class="badge-name">Claude Partner Badge <span>Claude Code</span></p>
    <a href="https://www.credly.com/org/anthropic/badge/claude-partner-badge-claude-code" target="_blank" rel="noopener noreferrer">About this badge <span aria-hidden="true">↗</span></a>
  </div>
</aside>
<style>
  .claude-credential { display: flex; align-items: center; gap: 1.25rem; max-width: 34rem; margin-block: 1.5rem 0; padding: 1.1rem 1.3rem; border: 1px solid #bd9c8d66; border-radius: 14px; background: #f2e7dd; color: #302923; }
  img { flex: none; width: 6.5rem; height: 6.5rem; object-fit: contain; }
  p { margin: 0; }
  .badge-issuer { font: 400 .61rem/1.6 'DM Mono', monospace; letter-spacing: .06em; text-transform: uppercase; }
  .badge-name { margin-top: .3rem; font: 400 1.1rem/1.4 'Jost', sans-serif; }
  .badge-name span { display: block; font-weight: 500; }
  a { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; color: inherit; font: 400 .83rem/1.5 'Jost', sans-serif; text-underline-offset: .2em; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .on-dark { background: #faf6ef0a; border-color: #f5eee947; color: #faf6ef; }
  .on-dark .badge-issuer { color: #d1dfd6; }
  @media (max-width: 380px) { .claude-credential { gap: .85rem; padding: 1rem; } img { width: 5rem; height: 5rem; } .badge-name { font-size: 1rem; } }
</style>
