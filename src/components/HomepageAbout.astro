---
import '@fontsource/caveat/latin-400.css';
import { about } from '../data/siteContent';
import FlowText from './FlowText.astro';
---
<section class="diana-about" id="about" aria-labelledby="about-title">
  <div class="diana-shell">
    <div class="diana-grid">
      <header class="diana-intro" data-reveal>
        <p class="diana-eyebrow">About</p>
        <h2 id="about-title">{about.heading}</h2>
      </header>

      <div class="diana-visual" data-reveal>
        <div class="diana-photo-cluster">
          <div class="diana-portrait">
            <div class="diana-portrait-window">
              <img src="/images/diana-molski-portrait.png" alt="Diana Molski" width="820" height="806" loading="lazy" decoding="async" />
            </div>
          </div>
          <figure class="diana-polaroid diana-myszka">
            <div class="diana-photo-window">
              <img src="/images/myszka-about.webp" alt="Myszka looking over her shoulder while curled up on a bed" width="901" height="1600" loading="lazy" decoding="async" />
              <img class="diana-natural-fur" src="/images/myszka-about.webp" alt="" aria-hidden="true" width="901" height="1600" loading="lazy" decoding="async" />
            </div>
            <figcaption>Myszka</figcaption>
          </figure>
          <figure class="diana-polaroid diana-beach">
            <div class="diana-photo-window">
              <img src="/images/south-bay-sunset-about.webp" alt="Palm trees framing a pier at sunset in the South Bay" width="900" height="600" loading="lazy" decoding="async" />
            </div>
            <figcaption>South Bay</figcaption>
          </figure>
        </div>
      </div>

      <div class="diana-story" data-reveal>
        <div class="diana-biography">
          {about.biography.map(paragraph => <p><FlowText text={paragraph} /></p>)}
          <p class="diana-invitation">
            <FlowText text={about.invitation.text} />{' '}
            <a href={about.invitation.href}>{about.invitation.linkText}</a>.
          </p>
        </div>
        <aside class="diana-community" aria-labelledby="diana-community-title">
          <div class="diana-event-image">
            <img src="/images/event-poster-vol01.png" alt="Using AI to Put the Ops in FinOps, hosted by Diana Molski" width="1200" height="1200" loading="lazy" decoding="async" />
          </div>
          <div class="diana-event-copy">
            <p class="diana-event-date">April 9, 2026 · Hawthorne</p>
            <h3 id="diana-community-title">Hosted FinOps Weekly LA</h3>
            <p><FlowText text="I organized and hosted LA’s first FinOps Weekly meetup with SmartClouds, featuring speakers from Ulta Beauty and Wiv.ai." /></p>
          </div>
        </aside>
      </div>
    </div>

    <section class="diana-credentials" id="credentials" aria-label="Professional credentials and contributions" data-reveal>
    <ul class="cp-badges" role="list">
    <li>
    <img src="/images/finops-certified-practitioner.png" alt="FinOps Certified Practitioner" width="96" height="96" loading="lazy" decoding="async" />
    </li>
    <li>
    <img src="/images/finops-certified-focus-analyst.png" alt="FinOps Certified FOCUS Analyst" width="96" height="96" loading="lazy" decoding="async" />
    </li>
    <li>
    <img src="/images/aws-certified-cloud-practitioner.png" alt="AWS Certified Cloud Practitioner" width="96" height="96" loading="lazy" decoding="async" />
    </li>
    <li>
    <img src="/images/claude-partner-badge-claude-code.png" alt="Claude Partner Badge: Claude Code" width="96" height="96" loading="lazy" decoding="async" />
    </li>
    </ul>
    <div class="cp-footer">
    <details class="cp-details">
    <summary>See all credentials <span class="cp-disclosure-icon" aria-hidden="true">
    </span>
    </summary>
    <ul class="cp-full-list" role="list">
    <li>
    <strong>FinOps Certified Practitioner</strong>
    <span>The Linux Foundation</span>
    </li>
    <li>
    <strong>FinOps Certified FOCUS Analyst</strong>
    <span>The Linux Foundation</span>
    </li>
    <li>
    <strong>AWS Certified Cloud Practitioner</strong>
    <span>Amazon Web Services</span>
    </li>
    <li>
    <strong>Microsoft Certified: Azure AI Fundamentals</strong>
    <span>Microsoft</span>
    </li>
    <li>
    <strong>Claude Partner Badge: Claude Code</strong>
    <span>Anthropic</span>
    </li>
    <li>
    <strong>Intuit Bookkeeping Certification</strong>
    <span>Intuit</span>
    </li>
    <li>
    <strong>Intuit QuickBooks Certification Level 1</strong>
    <span>Intuit</span>
    </li>
    <li>
    <strong>FinOps Governance for Cloud & AI</strong>
    <span>Stacklet · Training</span>
    </li>
    <li>
    <strong>API Deployment Practitioner</strong>
    <span>OpenAI Partner Network · Training</span>
    </li>
    </ul>
    </details>
    <div class="cp-contributions">
    <span>Contributions</span>
    <a href="https://hub.pointfive.co/inefficiencies/overcommitted-savings-plans-after-temporary-ai-inference-demand-spikes?cloud-services=aws-savings-plans" target="_blank" rel="noopener noreferrer">PointFive <span aria-hidden="true">↗</span>
    </a>
    <a href="https://hub.xerj.org/contributors/dianuhs" target="_blank" rel="noopener noreferrer">AI Cost Lens · XERJ <span aria-hidden="true">↗</span>
    </a>
    </div>
    </div>
    </section>
  </div>
</section>

<style>
  .diana-about { padding: clamp(4.5rem, 7vw, 6.25rem) 0; background: var(--theme-forest-panel, #3d6055); color: #faf6ef; scroll-margin-top: 5rem; }
  .diana-shell { width: min(calc(100% - 4rem), 78rem); margin-inline: auto; }
  .diana-grid { display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); grid-template-areas: 'photos intro' 'photos story'; grid-template-rows: auto 1fr; column-gap: clamp(3rem, 6vw, 5.5rem); align-items: start; }
  .diana-intro { grid-area: intro; margin-bottom: 1.5rem; }
  .diana-eyebrow { margin: 0; color: #d1dfd6; font: 400 .61rem/1.5 'DM Mono', monospace; letter-spacing: .14em; text-transform: uppercase; }
  .diana-intro .diana-eyebrow { display: flex; align-items: center; gap: .75rem; }
  .diana-intro .diana-eyebrow::after { content: ''; flex: none; width: 2.7rem; height: 1px; background: currentColor; opacity: .42; }
  .diana-intro h2 { margin: .85rem 0 0; color: #faf6ef; font: 400 clamp(3.3rem, 5vw, 4.5rem)/1 'Cormorant Garamond', Georgia, serif; letter-spacing: -.035em; }
  .diana-visual { grid-area: photos; align-self: center; min-width: 0; }
  .diana-photo-cluster { position: relative; isolation: isolate; width: min(100%, 27rem); aspect-ratio: .59; margin-inline: auto; }
  .diana-portrait { position: absolute; z-index: 1; top: 1.5%; left: 17%; width: 72%; }
  .diana-portrait-window { overflow: hidden; aspect-ratio: 1; border-radius: 50%; box-shadow: 0 1px 2px #152d2759, 3px 9px 18px -7px #152d2773; }
  .diana-portrait-window img { display: block; width: 100%; height: 100%; object-fit: cover; transform: scale(1.012); }
  .diana-polaroid { --photo-tilt: -8deg; position: absolute; z-index: 2; box-sizing: border-box; width: 42%; margin: 0; padding: clamp(.5rem, 1vw, .7rem); border: 1px solid var(--theme-line, #fffefa); border-radius: 2px; background: var(--cream); color: var(--theme-ink, #2f2927); box-shadow: 1px 2px 0 #d9d1c4, 0 5px 8px -4px #142d2773, 3px 12px 20px -10px #122a258c; transform: rotate(var(--photo-tilt)); }
  .diana-myszka { --photo-warmth: .42; top: 47%; left: 3%; }
  .diana-beach { --photo-warmth: .42; --photo-tilt: 6deg; z-index: 3; top: 65%; right: 4%; }
  .diana-photo-window { position: relative; isolation: isolate; overflow: hidden; aspect-ratio: 1; background: var(--cream); }
  .diana-photo-window::after { content: ''; position: absolute; inset: 0; background: var(--theme-sand-panel, #f2dca5); mix-blend-mode: multiply; opacity: .12; pointer-events: none; }
  .diana-beach .diana-photo-window::after { opacity: .03; }
  .diana-photo-window img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .diana-myszka .diana-photo-window img { object-position: 50% 42%; }
  .diana-myszka .diana-photo-window img, .diana-beach .diana-photo-window img { filter: sepia(var(--photo-warmth)) saturate(1.08) contrast(1.02) brightness(1.01); }
  .diana-myszka .diana-photo-window .diana-natural-fur { position: absolute; inset: 0; z-index: 1; filter: none; opacity: 1; mask-image: radial-gradient(ellipse 36% 27% at 45% 34%, #000 80%, transparent 100%), radial-gradient(ellipse 40% 31% at 41% 69%, #000 80%, transparent 100%); pointer-events: none; }
  .diana-beach .diana-photo-window img { object-position: 35% 50%; filter: none; }
  .diana-polaroid figcaption { padding: .55rem .1rem .2rem; font: 400 clamp(1.4rem, 2.5vw, 1.85rem)/1.05 'Caveat', 'Segoe Print', 'Bradley Hand', cursive; font-synthesis: none; text-align: center; }
  .diana-story { grid-area: story; min-width: 0; }
  .diana-biography p { max-width: 64ch; margin: 1.05rem 0 0; color: #f3f0e9; font-size: .95rem; line-height: 1.75; text-wrap: pretty; }
  .diana-biography p:first-child { margin-top: 0; }
  .diana-invitation a { color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
  .diana-community { display: grid; grid-template-columns: clamp(8.1rem, 11.7vw, 9.9rem) minmax(0, 1fr); align-items: start; gap: 1.2rem; margin-top: 1.8rem; padding-top: 1.6rem; border-top: 1px solid var(--theme-line, #f5eee92e); }
  .diana-event-image { display: block; border: 1px solid var(--theme-line, #f5eee966); border-radius: 6px; overflow: hidden; box-shadow: 0 8px 16px -8px #162e27b3; }
  .diana-event-image img { display: block; width: 100%; height: auto; }
  .diana-event-date { margin: 0; color: #d1dfd6; font: 400 .55rem/1.6 'DM Mono', monospace; letter-spacing: .035em; }
  .diana-event-copy h3 { margin: .4rem 0; color: #faf6ef; font: italic 400 clamp(1.6rem, 2.75vw, 1.75rem)/1.1 'Cormorant Garamond', Georgia, serif; text-wrap: balance; }
  .diana-event-copy > p:last-of-type { margin: .6rem 0 .35rem; color: #e8eee7; font-size: .82rem; line-height: 1.65; text-wrap: pretty; }
  .diana-about a:focus-visible { outline: 2px solid var(--theme-line, #f2c8c9); outline-offset: 5px; }
  @media (max-width: 1020px) and (min-width: 761px) {
    .diana-grid { grid-template-columns: minmax(0, .72fr) minmax(0, 1.28fr); column-gap: 2.5rem; }
    .diana-visual { align-self: start; margin-top: 2rem; }
    .diana-myszka { left: 1%; }
    .diana-beach { right: 1%; }
    .diana-photo-cluster { aspect-ratio: .56; }
  }
  @media (max-width: 760px) {
    .diana-shell { width: min(calc(100% - 2.5rem), 40rem); }
    .diana-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'intro' 'photos' 'story'; grid-template-rows: auto auto auto; gap: 0; }
    .diana-intro { margin-bottom: 1.75rem; }
    .diana-intro h2 { font-size: clamp(3.15rem, 12vw, 4.25rem); }
    .diana-visual { width: min(100%, 25rem); margin-inline: auto; }
    .diana-photo-cluster { width: 94%; }
    .diana-story { margin-top: 2.25rem; }
    .diana-biography p { font-size: .95rem; }
    .diana-polaroid figcaption { font-size: clamp(1.4rem, 6vw, 1.85rem); }
  }
  @media (max-width: 560px) {
    .diana-community { grid-template-columns: minmax(0, 1fr); gap: 1.2rem; }
    .diana-event-image { width: 9.9rem; margin-inline: auto; }
  }
  @media (max-width: 380px) {
    .diana-photo-cluster { aspect-ratio: .55; }
  }
  .diana-about { padding-bottom: 2.5rem; }
.diana-credentials{margin-top:2rem;padding-top:1.25rem;border-top:1px solid #f5eee947;color:#faf6ef}
.cp-badges{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.75rem;max-width:42rem;padding:0;margin:1.1rem auto 1rem;list-style:none}
.cp-badges li{display:flex;align-items:center;justify-content:center;min-width:0}
.cp-badges img{display:block;width:5.25rem;height:5.25rem;object-fit:contain}
.cp-footer{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:.25rem 1.5rem}
.cp-details{min-width:0}
.cp-details summary{display:flex;align-items:center;gap:.75rem;width:fit-content;min-height:44px;cursor:pointer;font:400 .77rem/1.5 Jost,system-ui,sans-serif;color:#edf1ea;list-style:none;text-underline-offset:.22em}
.cp-details summary::-webkit-details-marker{display:none}
.cp-details summary:hover{text-decoration:underline}
.cp-disclosure-icon{position:relative;display:block;width:10px;height:10px}
.cp-disclosure-icon::before,.cp-disclosure-icon::after{content:'';position:absolute;background:currentColor;left:0;right:0;top:4px;height:1px}
.cp-disclosure-icon::after{transform:rotate(90deg)}
.cp-details[open] .cp-disclosure-icon::after{transform:rotate(0)}
.cp-badges li:nth-child(2) img{transform:scale(1.15)}
.cp-details[open]{grid-column:1/-1}
.cp-full-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem 2rem;list-style:none;padding:1rem 0;margin:0}
.cp-full-list li{display:flex;flex-direction:column;gap:.25rem;min-width:0}
.cp-full-list strong{font:400 .85rem/1.5 Jost,system-ui,sans-serif;color:#faf6ef}
.cp-full-list li>span{font:400 .7rem/1.45 Jost,system-ui,sans-serif;color:#cbdad0}
.cp-contributions{display:flex;flex-wrap:wrap;align-items:center;justify-content:flex-end;gap:.25rem 1rem;min-height:44px;font:400 .77rem/1.5 Jost,system-ui,sans-serif}
.cp-contributions>span{font:400 .55rem/1.6 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase;color:#cbdad0}
.cp-contributions a{display:inline-flex;align-items:center;gap:.4rem;min-height:44px;color:#edf1ea;text-decoration:none}
.cp-contributions a:hover{text-decoration:underline;text-underline-offset:.22em}
.cp-details[open]+.cp-contributions{grid-column:1/-1;justify-content:flex-start}
.diana-credentials a:focus-visible,.cp-details summary:focus-visible{outline:2px solid #f2c8c9;outline-offset:4px}
@media(max-width:760px){.cp-badges{max-width:26rem;gap:.65rem;margin-block:1.3rem 1rem}
.cp-badges img{width:4rem;height:4rem}
.cp-footer{grid-template-columns:minmax(0,1fr);gap:.1rem}
.cp-contributions{justify-content:flex-start;column-gap:1rem;row-gap:0}
.cp-full-list{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.1rem 1rem}
.cp-contributions>span{flex-basis:100%;padding-top:.3rem}
.diana-credentials{margin-top:2rem}
#credentials{scroll-margin-top:6rem}
}
@media(max-width:370px){.cp-badges{gap:.35rem}
.cp-badges img{width:3.75rem;height:3.75rem}
.cp-full-list{grid-template-columns:minmax(0,1fr)}
}
@media(prefers-reduced-motion:reduce){.cp-disclosure-icon::after{transition:none}
}

</style>

