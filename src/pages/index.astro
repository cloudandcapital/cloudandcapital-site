---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroDataArtwork from '../components/HeroDataArtwork.astro';
import {
  about,
  contactLink,
  newsletter,
  featuredWriting,
  marketsMimosasLatest,
  tools,
  writingFeatured,
} from '../data/siteContent';

const aiCostLens = tools.find((tool) => tool.slug === 'ai-cost-lens');
const cloudCostGuard = tools.find((tool) => tool.slug === 'cloud-cost-guard-lumen');
const marketTape = tools.find((tool) => tool.slug === 'market-tape');
const signalAudit = tools.find((tool) => tool.slug === 'signal-audit');
const interactiveLab = tools.find((tool) => tool.slug === 'interactive-lab');
const featuredArticles = [writingFeatured, marketsMimosasLatest, featuredWriting];
---

<BaseLayout
  title="Cloud & Capital | Turning numbers into strategy"
  description="Financial tools and clear analysis from Diana Molski across markets, business costs, cloud, and AI."
>
  <main class="home" id="main-content">
    <section class="hero" aria-labelledby="home-title">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <h1 id="home-title">
            Before you invest it, spend it, or build with it,
            <span class="scribbled-word">understand it.<svg viewBox="0 0 250 26" preserveAspectRatio="none" aria-hidden="true"><path d="M4 18 C55 6 111 27 246 10" /><path d="M18 22 C91 13 161 23 226 15" /></svg></span>
          </h1>
          <p class="hero-lede">I’m Diana. I follow markets, build free tools, and write about the money questions that come up in business and real life. If a headline and the numbers tell different stories, I want to know why.</p>
          <p class="hero-byline">Diana Molski · Finance analyst and tool builder</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#tools" data-analytics-event="cta_click" data-analytics-destination="work" data-analytics-source="homepage_hero">Explore the tools</a>
            <a class="button hero-secondary" href="#writing" data-analytics-event="cta_click" data-analytics-destination="writing" data-analytics-source="homepage_hero">Read the writing</a>
          </div>
        </div>

        <div class="hero-visual">
          <HeroDataArtwork />
        </div>
      </div>
    </section>

    <section class="paths" aria-labelledby="paths-title">
      <div class="shell">
        <div class="section-heading paths-heading" data-reveal>
          <div>
            <p class="eyebrow">Start with your question</p>
            <h2 id="paths-title">What are you here to figure out?</h2>
          </div>
        </div>

        <div class="path-grid">
          <a class="path-card" href="/learn" data-reveal data-analytics-event="cta_click" data-analytics-destination="writing" data-analytics-source="homepage_path_personal">
            <div class="path-number">01</div>
            <p class="card-label">Your money</p>
            <h3>Learn what the market is doing and why.</h3>
            <p>Tailored investing and trading lessons, worked examples, and guided practice.</p>
            <span class="path-action"><span>Explore learning</span><span aria-hidden="true">→</span></span>
          </a>

          <a class="path-card path-card-tint" href="/services" data-reveal data-analytics-event="cta_click" data-analytics-destination="contact" data-analytics-source="homepage_path_business">
            <div class="path-number">02</div>
            <p class="card-label">Your business</p>
            <h3>Know where the money and time are going.</h3>
            <p>Technology cost reviews, recurring reporting, and practical improvements using the tools you already have.</p>
            <span class="path-action"><span>Explore business services</span><span aria-hidden="true">→</span></span>
          </a>

          <a class="path-card" href="/tools" data-reveal data-analytics-event="cta_click" data-analytics-destination="work" data-analytics-source="homepage_path_team">
            <div class="path-number">03</div>
            <p class="card-label">Your technology spend</p>
            <h3>See what cloud and AI are actually costing.</h3>
            <p>Allocation, forecasts, unit economics, anomalies, commitments, SaaS licenses, and the cost behind AI results.</p>
            <span class="path-action"><span>Explore the technical work</span><span aria-hidden="true">→</span></span>
          </a>
        </div>
        <p class="education-note">Education and research only. Cloud &amp; Capital does not provide personal investment advice.</p>
      </div>
    </section>

    <section class="tools-section" id="tools" aria-labelledby="tools-title">
      <div class="shell">
        <div class="section-heading tools-heading" data-reveal>
          <div>
            <p class="eyebrow eyebrow-light">Tools</p>
            <h2 id="tools-title">Tools for real questions.</h2>
          </div>
          <p>Everything here is free to use. Open a tool, see the method, or look through the code.</p>
        </div>

        {aiCostLens && (
          <article class="flagship-tool" data-reveal>
            <div class="flagship-copy">
              <p class="card-label card-label-gold">Featured tool · AI economics</p>
              <h3>{aiCostLens.title}</h3>
              <p class="tool-question">What did one usable result really cost?</p>
              <p>Estimate a route from published prices. With matched cost, usage, and checked outcomes, see whether a cheaper option still holds up after quality and rework.</p>
              <div class="tool-actions">
                <a class="tool-launch" href={aiCostLens.href} target="_blank" rel="noopener noreferrer" data-analytics-event="cta_click" data-analytics-destination="ai_cost_lens" data-analytics-source="homepage_featured_tools">Open AI Cost Lens <span aria-hidden="true">→</span></a>
                <a class="tool-source" href={aiCostLens.sourceHref} target="_blank" rel="noopener noreferrer" data-analytics-event="cta_click" data-analytics-destination="ai_cost_lens_github" data-analytics-source="homepage_featured_tools"><span class="tool-source-label">View the source</span><span class="tool-source-arrow" aria-hidden="true">→</span></a>
              </div>
            </div>
            <a class="flagship-window" href={aiCostLens.href} target="_blank" rel="noopener noreferrer" aria-label="Open AI Cost Lens" data-analytics-event="cta_click" data-analytics-destination="ai_cost_lens" data-analytics-source="homepage_featured_tools">
              <span class="window-bar" aria-hidden="true">
                <span class="window-dots"><i></i><i></i><i></i></span>
                <span>lens.cloudandcapital.com · illustrative example</span>
              </span>
              <span class="window-canvas">
                <img src="/images/ai-cost-lens-cost-anatomy-wide.png" alt="AI Cost Lens illustrative example comparing the full cost of two AI routes" width="2190" height="964" loading="lazy" />
              </span>
            </a>
          </article>
        )}

        <div class="tool-grid">
          {cloudCostGuard && (
            <a class="tool-card" href={cloudCostGuard.href} target="_blank" rel="noopener noreferrer" data-reveal data-analytics-event="cta_click" data-analytics-destination="cloud_cost_guard" data-analytics-source="homepage_featured_tools">
              <div class="tool-preview">
                <div class="preview-surface">
                  <div class="window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>guard.cloudandcapital.com</span></div>
                  <img src="/images/cloud-cost-guard-spend-reconciliation.jpg" alt="Published technology spend, passed reconciliation, and Cloud, Direct AI, and SaaS breakdown" width="1216" height="474" loading="lazy" />
                </div>
              </div>
              <p class="card-label">Cloud, AI, and SaaS</p>
              <h3>Cloud Cost Guard</h3>
              <p class="tool-question">Why did the bill move?</p>
              <p>Trace cost drivers, flag anomalies, and forecast the next bill.</p>
              <span class="tool-card-action"><span>Open Cloud Cost Guard</span><span aria-hidden="true">→</span></span>
            </a>
          )}

          {marketTape && (
            <a class="tool-card" href={marketTape.href} target="_blank" rel="noopener noreferrer" data-reveal data-analytics-event="cta_click" data-analytics-destination="market_tape" data-analytics-source="homepage_featured_tools">
              <div class="tool-preview">
                <div class="preview-surface market-preview">
                  <div class="window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>market-tape.cloudandcapital.com</span></div>
                  <div class="market-crop"><img src="/images/market-tape-internals-momentum.jpg" alt="Market internals and momentum leaders and laggards with sparklines" width="1104" height="430" loading="lazy" /></div>
                </div>
              </div>
              <p class="card-label">Markets</p>
              <h3>{marketTape.title}</h3>
              <p class="tool-question">What is moving across the market?</p>
              <p>Follow 52 rates, sectors, commodities, and risk signals in one live view.</p>
              <span class="tool-card-action"><span>Open Market Tape</span><span aria-hidden="true">→</span></span>
            </a>
          )}
        </div>

        <div class="smaller-tools" data-reveal>
          <div class="smaller-tools-intro">
            <h3 class="card-label">More tools</h3>
          </div>
          {signalAudit && (
            <a class="small-tool" href={signalAudit.href} data-analytics-event="cta_click" data-analytics-destination="signal_audit" data-analytics-source="homepage_featured_tools">
              <span>Signal Audit</span>
              <p>Find where technology cost accountability is breaking down.</p>
              <strong aria-hidden="true">→</strong>
            </a>
          )}
          {interactiveLab && (
            <a class="small-tool" href={interactiveLab.href} data-analytics-event="cta_click" data-analytics-destination="interactive_lab" data-analytics-source="homepage_featured_tools">
              <span>Interactive Lab</span>
              <p>Organize the evidence around a real technology spend decision.</p>
              <strong aria-hidden="true">→</strong>
            </a>
          )}
        </div>

      </div>
    </section>

    <section class="writing-section" id="writing" aria-labelledby="writing-title">
      <div class="shell">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow">Writing</p>
            <h2 id="writing-title">Markets, money, and what I’m learning as I build.</h2>
          </div>
        </div>


        <div class="article-grid">
          {featuredArticles.map((article, index) => (
            <a class="article-card" href={article.href} target="_blank" rel="noopener noreferrer" data-reveal data-analytics-event="cta_click" data-analytics-destination="substack" data-analytics-source="homepage_writing">
              <div class="article-copy">
                {index < 2 && <p class="article-latest">{index === 0 ? 'Featured essay' : 'Latest'}</p>}
                <p class="card-label">{article.topic.replace(' · Issue No. 1', '').replace(' · Issue no. 1', '')} · {article.date}</p>
                <h3>{article.title}</h3>
                <p>{article.description}</p>
                <span><span>Read</span><span aria-hidden="true">→</span></span>
              </div>
              {index === 0 && (
                <div class="decision-artwork" role="img" aria-label="What gets built, what gets locked in, and what becomes the default.">
                  <svg class="decision-linework" viewBox="0 0 500 500" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M 72 -15 V 194 M 72 270 V 440 M 350 18 V 178 M 350 236 V 515 M 18 108 H 306 M 116 174 H 510" />
                    <path d="M -20 360 H 286 M 212 426 H 505" />
                  </svg>
                  <div class="decision-terms" aria-hidden="true">
                    <div class="decision-term decision-built"><span>What gets</span><strong>Built</strong></div>
                    <div class="decision-term decision-locked"><span>What gets</span><strong>Locked in</strong></div>
                    <div class="decision-term decision-default"><span>What becomes the</span><strong>Default</strong></div>
                  </div>
                </div>
              )}

            </a>
          ))}
        </div>

        <div class="writing-actions">
          <a class="button button-primary" href={newsletter.subscribeHref} target="_blank" rel="noopener noreferrer" data-analytics-event="cta_click" data-analytics-destination="substack" data-analytics-source="homepage_writing">View all writing</a>
        </div>
      </div>
    </section>

    <section class="about-section" id="about" aria-labelledby="about-title">
      <div class="site-shell">
        <div class="about-grid">
          <div class="about-identity" data-reveal>
            <p class="eyebrow eyebrow-light">About Diana</p>
            <img class="about-portrait" src="/images/diana-molski-portrait.png" alt="Diana Molski" width="820" height="806" loading="lazy" />
            <p class="about-location">Founder, Cloud &amp; Capital · Los Angeles</p>
            <h2 id="about-title"><span>{about.headingLead}</span> <span>{about.headingMiddle}</span> <em>{about.headingItalic}</em></h2>
          </div>

          <div class="about-copy" data-reveal>
            {about.biography.map((paragraph) => <p class="about-body">{paragraph}</p>)}

            <p class="about-credentials-label">Credentials</p>
            <dl class="credentials" aria-label="Professional credentials">
              {about.credentials.map((credential) => (
                <div class="credential-row"><dt>{credential.category}</dt><dd>{credential.detail}</dd></div>
              ))}
              <div class="credential-row credential-contribution">
                <dt>CONTRIBUTION</dt>
                <dd><a class="contribution-link" href={about.recognitionUrl} target="_blank" rel="noopener noreferrer"><span>{about.recognition}</span><span aria-hidden="true">→</span></a></dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="site-shell contact-inner" data-reveal>
        <p class="eyebrow eyebrow-gold">Get in touch</p>
        <h2 id="contact-title"><span>Have a number, bill, or idea</span> <span>you want to make sense of?</span></h2>
        <div class="contact-copy">
          <p>Tell me what you’re working on, what isn’t adding up, or what you want another set of eyes on.</p>
          <a class="contact-email-card" href={contactLink.href} data-analytics-event="cta_click" data-analytics-destination="contact" data-analytics-source="homepage_contact">
            <span class="contact-email-label">Email Diana <svg class="contact-email-heart" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8.1 13.6C5.5 11.9 2.1 9.5 1.9 6.3c-.1-1.6.8-2.8 2.2-2.9 1.5-.2 2.8.9 3.7 2.1 1-1.6 2.4-2.5 3.7-2.3 1.7.2 2.5 1.5 2.3 3-.3 2.8-3.1 5.1-5.7 7.4Z" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <span class="contact-email-address">diana@cloudandcapital.com</span>
            <span class="contact-email-circle" aria-hidden="true"><span class="contact-email-arrow">→</span></span>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.documentElement.classList.add('reveal-ready');
  const revealItems = document.querySelectorAll('[data-reveal]');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12 });
    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  }
</script>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { background: #f5eee9; color: #191714; }
  .home { overflow: hidden; font-family: 'Jost', system-ui, sans-serif; }
  #tools, #writing, #about, #contact { scroll-margin-top: 5rem; }
  .shell { width: min(calc(100% - 4rem), 78rem); margin-inline: auto; }
  h1, h2, h3, p { margin: 0; }
  h1, h2, h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400; text-wrap: balance; }
  p { text-wrap: pretty; }
  a { color: inherit; }
  :global(.reveal-ready) [data-reveal] { opacity: 0; transform: translateY(1.1rem); transition: opacity .7s ease, transform .7s ease; }
  :global(.reveal-ready) [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
  .eyebrow,
  .card-label {
    font-family: 'DM Mono', monospace;
    font-size: .61rem;
    font-weight: 400;
    letter-spacing: .16em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .eyebrow { display: flex; align-items: center; gap: .75rem; color: #4f7567; }
  .eyebrow::after { content: ''; width: 2.7rem; height: 1px; background: currentColor; opacity: .42; }
  .eyebrow-light { color: #b4c8bf; }
  .eyebrow-gold { color: #ddb977; }
  .button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: .82rem 1.2rem;
    border: 1px solid transparent;
    font-family: 'DM Mono', monospace;
    font-size: .62rem;
    letter-spacing: .12em;
    line-height: 1.4;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform .18s ease, background .18s ease, color .18s ease, border-color .18s ease;
  }
  .button:hover { transform: translateY(-2px); }
  .button:focus-visible,
  .text-action:focus-visible,
  .path-card a:focus-visible,
  .tool-card a:focus-visible,
  .small-tool:focus-visible,
  .article-card:focus-visible { outline: 2px solid currentColor; outline-offset: .3rem; }
  .button-primary { background: #4f7167; color: #f5eee9; }
  .button-primary:hover { background: #45675e; }
  .button-white { background: #f5eee9; color: #2b2622; }
  .button-white:hover { background: #fff; }
  .text-action {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    padding: .35rem 0 .42rem;
    font-family: 'DM Mono', monospace;
    font-size: .61rem;
    letter-spacing: .11em;
    line-height: 1.5;
    text-transform: uppercase;
    text-decoration: none;
  }
  .text-action > span:first-child { position: relative; }
  .text-action > span:first-child::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(.28);
    transform-origin: left;
    transition: transform .22s ease;
  }
  .text-action:hover > span:first-child::after, .text-action:focus-visible > span:first-child::after { transform: scaleX(1); }
  .text-action > span:last-child { transition: transform .22s ease; }
  .text-action:hover > span:last-child { transform: translateX(.16rem); }
  .text-action-dark { color: #2e4e44; }
  .text-action-light { color: #b9cec5; }

  .hero { padding: clamp(7.6rem, 10vw, 9rem) 0 clamp(4.25rem, 7vw, 6rem); background: #f5eee9; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(3rem, 7vw, 6.5rem); align-items: center; }
  .hero-copy h1 { max-width: 13ch; margin-top: 0; font-size: clamp(3.7rem, 5.55vw, 5.75rem); line-height: .93; letter-spacing: -.042em; }
  .scribbled-word { position: relative; display: inline-block; font-style: italic; color: #3d6055; white-space: nowrap; }
  .scribbled-word svg { position: absolute; left: -.08em; right: -.08em; bottom: -.16em; width: calc(100% + .16em); height: .28em; overflow: visible; }
  .scribbled-word path { fill: none; stroke: #c29260; stroke-width: 2.2; stroke-linecap: round; opacity: .75; stroke-dasharray: 260; stroke-dashoffset: 260; animation: scribble-in 1.1s ease forwards 1s; }
  .scribbled-word path:last-child { opacity: .42; animation-delay: 1.22s; }
  .hero-lede { max-width: 58ch; margin-top: 1.6rem; color: #4a4a4a; font-size: 1rem; line-height: 1.78; }
  .hero-byline { margin-top: 1.15rem; color: #6c665f; font-family: 'DM Mono', monospace; font-size: .6rem; letter-spacing: .11em; line-height: 1.5; text-transform: uppercase; }
  .hero-actions,
  .writing-actions,
  .contact-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.4rem; margin-top: 1.8rem; }
  .hero-visual { min-width: 0; padding: .75rem .5rem 1.25rem; }
  @media (min-width: 1280px) {
    .hero-visual { width: min(calc(100% + 75px), 660px); justify-self: end; align-self: end; margin-block: -24px -20px; position: relative; top: 0; }
  }
  .hero-actions .button, .writing-actions .button { min-height: 48px; border-radius: 8px; padding: .9rem 1.25rem; color: #f5eee9; }
  .hero-actions .button:focus-visible, .writing-actions .button:focus-visible { outline-color: #3d6055; }
  .hero-actions .hero-secondary:focus-visible { outline-color: #8f6265; }
  .hero-actions .hero-secondary { background: #b78384; color: #24211e; border-color: transparent; }
  .hero-actions .hero-secondary:hover { background: #af7d7f; }

  .paths { padding: clamp(4.5rem, 7vw, 6.25rem) 0; background: #fbfaf7; }
  .section-heading { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(20rem, .9fr); gap: clamp(2.5rem, 7vw, 6.5rem); align-items: end; }
  .section-heading h2 { max-width: 18ch; margin-top: .9rem; font-size: clamp(2.65rem, 4vw, 4.2rem); line-height: .99; letter-spacing: -.035em; }
  .section-heading > p { max-width: 39ch; padding-left: 1.4rem; border-left: 2px solid rgba(107, 142, 127, .4); color: #4a4a4a; font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.08rem, 1.55vw, 1.35rem); line-height: 1.52; text-wrap: balance; }
  .path-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 2.25rem; border-top: 0; border-bottom: 1px solid rgba(25, 23, 20, .14); }
  .path-card { position: relative; min-height: 20.5rem; padding: 2.2rem; display: flex; flex-direction: column; border-right: 1px solid rgba(25, 23, 20, .12); }
  .path-card:last-child { border-right: 0; }
  .path-card-tint { background: #afb8a8; }
  .path-number { position: absolute; top: 1.875rem; right: 1.875rem; color: rgba(61, 96, 85, .22); font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(5.75rem, 7vw, 7rem); font-weight: 400; line-height: .8; letter-spacing: -.065em; pointer-events: none; }
  .card-label { color: #4f7167; }
  .path-card h3 { max-width: 13ch; margin-top: 1.2rem; font-size: clamp(1.9rem, 2.5vw, 2.65rem); line-height: 1.03; letter-spacing: -.025em; }
  .path-card > p:not(.card-label) { max-width: 39ch; margin-top: 1rem; color: #3b3b38; font-size: .88rem; line-height: 1.7; }
  .path-card a,
  .tool-card a { align-self: flex-start; margin-top: auto; padding-top: 1.5rem; color: #3d6055; font-family: 'DM Mono', monospace; font-size: .6rem; letter-spacing: .1em; line-height: 1.5; text-transform: uppercase; text-decoration: none; }
  .path-card a:hover,
  .tool-card a:hover { text-decoration: underline; text-underline-offset: .32rem; }
  .education-note { margin-top: 1rem; color: #79726b; font-size: .7rem; line-height: 1.55; }

  .writing-section { padding: clamp(4.25rem, 6vw, 5.6rem) 0; background: #eadfce; }
  .article-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 2rem; background: rgba(25, 23, 20, .14); border-top: 1px solid rgba(25, 23, 20, .14); border-bottom: 1px solid rgba(25, 23, 20, .14); }
  .article-card { min-width: 0; background: #f5eee9; color: inherit; text-decoration: none; }
  .article-copy { min-height: 16rem; padding: 1.55rem; display: flex; flex-direction: column; }
