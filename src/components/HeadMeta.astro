---
import { canonicalPath, createSiteGraph, serializeJsonLd } from '../lib/seo.js';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  image?: string;
  structuredData?: Record<string, unknown>[];
  type?: 'website' | 'article';
}

const {
  title,
  description = '',
  noindex = false,
  image = '/images/og-image.png',
  structuredData = [],
  type = 'website',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://cloudandcapital.com');
const canonicalUrl = new URL(canonicalPath(Astro.url.pathname), siteUrl);
const imageUrl = new URL(image, siteUrl);
const graph = createSiteGraph({ siteUrl, pathname: Astro.url.pathname, title, description, entities: structuredData });
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- One versioned icon source prevents route-specific or cached framework fallbacks. -->
<link rel="icon" href="/icon.png?v=cloud-and-capital" type="image/png" />
<link rel="shortcut icon" href="/icon.png?v=cloud-and-capital" type="image/png" />
<link rel="apple-touch-icon" href="/icon.png?v=cloud-and-capital" />
<link rel="canonical" href={canonicalUrl} />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="theme-color" content="#F5EEE9" />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Cloud & Capital" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description || 'Turning numbers into strategy'} />
<meta property="og:image" content={imageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description || 'Turning numbers into strategy'} />
<meta name="twitter:image" content={imageUrl} />
{!noindex && <script type="application/ld+json" set:html={serializeJsonLd(graph)} />}
