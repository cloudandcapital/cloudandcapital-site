---
import BaseLayout from '../layouts/BaseLayout.astro';
import DecisionDesk from '../components/DecisionDesk.astro';
import {
  about,
  contactLink,
  featuredWriting,
  marketsMimosasLatest,
  tools,
  writingFeatured,
} from '../data/siteContent';

const aiCostLens = tools.find((tool) => tool.slug === 'ai-cost-lens');
const cloudCostGuard = tools.find((tool) => tool.slug === 'cloud-cost-guard-lumen');
const marketTape = tools.find((tool) => tool.slug === 'market-tape');
const signalAudit = tools.find((tool) => tool.slug === 'signal-audit');
const interactiveLab = tools.find((tool) => tool.slug === 'interactive-lab');
const featuredArticles = [marketsMimosasLatest, writingFeatured, featuredWriting];
---

<BaseLayout
  title="Cloud & Capital | Turning numbers into strategy"
  description="Financial tools and clear analysis from Diana Molski across markets, business costs, cloud, and AI."
>
  <main class="home" id="main-content">
    <section class="hero" aria-labelledby="home-title">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <h1 id="home-title">
            Before you invest it, spend it, or build with it,
            <span class="scribbled-word">understand it.<svg viewBox="0 0 250 26" preserveAspectRatio="none" aria-hidden="true"><path d="M4 18 C55 6 111 27 246 10" /><path d="M18 22 C91 13 161 23 226 15" /></svg></span>
          </h1>
          <p class="hero-lede">Cloud &amp; Capital is where I build free tools and share clear analysis for people learning about money, businesses watching costs, and teams managing cloud and AI spend.</p>
          <p class="hero-byline">By Diana Molski · Finance analyst and builder</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#tools" data-analytics-event="cta_click" data-analytics-destination="work" data-analytics-source="homepage_hero">Explore the tools</a>
            <a class="button hero-secondary" href="/writing" data-analytics-event="cta_click" data-analytics-destination="writing" data-analytics-source="homepage_hero">Read the writing</a>
          </div>
        </div>

        <div class="hero-visual">
          <DecisionDesk />
        </div>
      </div>
    </section>

    <section class="proof" aria-label="Diana Molski professional background">
      <div class="shell proof-grid">
        <div class="proof-item">
          <span>Finance</span>
          <strong>Morgan Stanley · Equity trading</strong>
        </div>
        <div class="proof-item">
          <span>Analysis</span>
          <strong>Forecasting · Variance · Unit economics</strong>
        </div>
        <div class="proof-item">
          <span>Build</span>
          <strong>Excel · SQL · Python · Power BI</strong>
        </div>
        <div class="proof-item">
          <span>Certified</span>
          <strong>FinOps · AWS · Azure AI</strong>
        </div>
      </div>
    </section>

    <section class="paths" aria-labelledby="paths-title">
      <div class="shell">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow">Start with your question</p>
            <h2 id="paths-title">What are you here to figure out?</h2>
          </div>
          <p>Choose the one that sounds most like you. Start simple. Get technical when it helps.</p>
        </div>

        <div class="path-grid">
          <article class="path-card" data-reveal>
            <div class="path-number">01</div>
            <p class="card-label">Your money</p>
            <h3>Learn what the market is doing and why.</h3>
            <p>Markets &amp; Mimosas and clear research on the numbers behind the headlines.</p>
            <a href="/writing" data-analytics-event="cta_click" data-analytics-destination="writing" data-analytics-source="homepage_path_personal">Start with the writing <span aria-hidden="true">→</span></a>
          </article>

          <article class="path-card path-card-tint" data-reveal>
            <div class="path-number">02</div>
            <p class="card-label">Your business</p>
            <h3>Know where the money and time are going.</h3>
            <p>Budgets, forecasts, software costs, AI workflows, and clearer systems for everyday business decisions.</p>
            <a href="#contact" data-analytics-event="cta_click" data-analytics-destination="contact" data-analytics-source="homepage_path_business">Tell me what is going on <span aria-hidden="true">→</span></a>
          </article>

          <article class="path-card" data-reveal>
            <div class="path-number">03</div>
            <p class="card-label">Your technology spend</p>
            <h3>See what cloud and AI are actually costing.</h3>
            <p>Allocation, forecasts, unit economics, anomalies, commitments, SaaS licenses, and the cost behind AI results.</p>
            <a href="/work" data-analytics-event="cta_click" data-analytics-destination="work" data-analytics-source="homepage_path_team">Explore the technical work <span aria-hidden="true">→</span></a>
          </article>
        </div>
        <p class="education-note">Education and research only. Cloud &amp; Capital does not provide personal investment advice.</p>
      </div>
    </section>

    <section class="tools-section" id="tools" aria-labelledby="tools-title">
      <div class="shell">
        <div class="section-heading tools-heading" data-reveal>
          <div>
            <p class="eyebrow eyebrow-light">Featured tools</p>
            <h2 id="tools-title">Tools for real questions.</h2>
          </div>
          <p>Everything here is free to try. For the technical work, you can also see the source code or the method behind it.</p>
        </div>

        {aiCostLens && (
          <article class="flagship-tool" data-reveal>
            <div class="flagship-copy">
              <p class="card-label card-label-gold">Flagship tool · AI economics · Live</p>
              <h3>{aiCostLens.title}</h3>
              <p class="tool-question">What did one usable result really cost?</p>
              <p>Compare model usage, infrastructure, and human review in one place. A cheaper model bill is not always a real saving.</p>
              <div class="tool-actions">
                <a href={aiCostLens.href} target="_blank" rel="noopener noreferrer" data-analytics-event="cta_click" data-analytics-destination="ai_cost_lens" data-analytics-source="homepage_featured_tools">Open the tool <span aria-hidden="true">→</span></a>
                <a href={aiCostLens.sourceHref} target="_blank" rel="noopener noreferrer" data-analytics-event="cta_click" data-analytics-destination="ai_cost_lens_github" data-analytics-source="homepage_featured_tools">View the source <span aria-hidden="true">→</span></a>
              </div>
            </div>
            <a class="flagship-window" href={aiCostLens.href} target="_blank" rel="noopener noreferrer" aria-label="Open AI Cost Lens" data-analytics-event="cta_click" data-analytics-destination="ai_cost_lens" data-analytics-source="homepage_featured_tools">
              <span class="window-bar" aria-hidden="true">
                <span class="window-dots"><i></i><i></i><i></i></span>
                <span>lens.cloudandcapital.com</span>
              </span>
              <span class="window-canvas">
                <img src="/images/ai-cost-lens-cost-anatomy-wide.png" alt="AI Cost Lens comparing the full cost of two AI production routes" width="2190" height="964" loading="lazy" />
              </span>
            </a>
          </article>
        )}

        <div class="tool-grid">
          {cloudCostGuard && (
            <article class="tool-card" data-reveal>
              <div class="mini-viz mini-cost" aria-hidden="true">
                <div class="mini-viz-top"><span>Cost drivers</span><i></i></div>
                <div class="mini-bars"><span></span><span></span><span></span><span></span><span></span><span></span></div>
                <div class="mini-anomaly"><i></i><span>Look here</span></div>
              </div>
              <p class="card-label">Cloud, AI, and SaaS</p>
              <h3>Cloud Cost Guard <small>with Lumen</small></h3>
              <p class="tool-question">Why did the bill move?</p>
              <p>Investigate spend, surface anomalies and cost drivers, and work through a forecast in plain English.</p>
              <a href={cloudCostGuard.href} target="_blank" rel="noopener noreferrer" data-analytics-event="cta_click" data-analytics-destination="cloud_cost_guard" data-analytics-source="homepage_featured_tools">Open Cloud Cost Guard <span aria-hidden="true">→</span></a>
            </article>
          )}

          {marketTape && (
            <article class="tool-card" data-reveal>
              <div class="mini-viz mini-market" aria-hidden="true">
                <svg viewBox="0 0 480 130" preserveAspectRatio="none">
                  <path class="market-grid" d="M0 32H480M0 65H480M0 98H480M96 0V130M192 0V130M288 0V130M384 0V130" />
                  <path class="market-line" pathLength="1" d="M0 101 C52 90 79 105 120 77 S187 85 231 59 S307 66 350 38 S426 48 480 18" />
                </svg>
                <div class="market-tags"><span>Rates</span><span>Sectors</span><span>Risk</span></div>
              </div>
              <p class="card-label">Markets</p>
              <h3>{marketTape.title}</h3>
              <p class="tool-question">What is moving across the market?</p>
              <p>A live view of 52 rates, sectors, commodities, and risk signals connected to technology, capital, and infrastructure.</p>
              <a href={marketTape.href} target="_blank" rel="noopener noreferrer" data-analytics-event="cta_click" data-analytics-destination="market_tape" data-analytics-source="homepage_featured_tools">Open Market Tape <span aria-hidden="true">→</span></a>
            </article>
          )}
        </div>

        <div class="smaller-tools" data-reveal>
          <div class="smaller-tools-intro">
            <p class="card-label">More to explore</p>
            <h3>Bring your own question.</h3>
          </div>
          {signalAudit && (
            <a class="small-tool" href={signalAudit.href} data-analytics-event="cta_click" data-analytics-destination="signal_audit" data-analytics-source="homepage_featured_tools">
              <span>Signal Audit</span>
              <p>Find where technology cost accountability is breaking down.</p>
              <strong aria-hidden="true">→</strong>
            </a>
          )}
          {interactiveLab && (
            <a class="small-tool" href={interactiveLab.href} data-analytics-event="cta_click" data-analytics-destination="interactive_lab" data-analytics-source="homepage_featured_tools">
              <span>Interactive Lab</span>
              <p>Organize the evidence around a real technology spend decision.</p>
              <strong aria-hidden="true">→</strong>
            </a>
          )}
        </div>

        <div class="section-action">
          <a class="text-action text-action-light" href="/work" data-analytics-event="cta_click" data-analytics-destination="work" data-analytics-source="homepage_featured_tools">View all tools <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="writing-section" id="writing" aria-labelledby="writing-title">
      <div class="shell">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow">Writing</p>
            <h2 id="writing-title">Markets, money, AI, and the business behind all three.</h2>
          </div>
          <p>I write about what moves money, what technology really costs, and who ends up paying for it.</p>
        </div>

        <ul class="writing-topics" aria-label="Cloud and Capital writing topics" data-reveal>
          <li>Markets &amp; investing</li>
          <li>AI in real life</li>
          <li>Business &amp; growth</li>
          <li>Technology economics</li>
        </ul>

        <div class="article-grid">
          {featuredArticles.map((article) => (
            <a class="article-card" href={article.href} target="_blank" rel="noopener noreferrer" data-reveal data-analytics-event="cta_click" data-analytics-destination="substack" data-analytics-source="homepage_writing">
              <div class="article-image">
                <img src={article.archiveImage} alt={article.archiveImageAlt} width="800" height="600" loading="lazy" />
              </div>
              <div class="article-copy">
                <p class="card-label">{article.topic} · {article.date}</p>
                <h3>{article.title}</h3>
                <p>{article.description}</p>
                <span>Read on Substack <span aria-hidden="true">→</span></span>
              </div>
            </a>
          ))}
        </div>

        <div class="writing-actions">
          <a class="text-action text-action-dark" href="/writing" data-analytics-event="cta_click" data-analytics-destination="writing" data-analytics-source="homepage_writing">Explore all writing <span aria-hidden="true">→</span></a>
          <a class="text-action text-action-dark" href="https://cloudandcapital.substack.com" target="_blank" rel="noopener noreferrer" data-analytics-event="cta_click" data-analytics-destination="substack" data-analytics-source="homepage_writing">Subscribe on Substack <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="about-section" id="about" aria-labelledby="about-title">
      <div class="shell">
        <div class="about-grid">
          <div class="about-intro" data-reveal>
            <div class="about-person">
              <img src="/images/diana-molski-portrait.png" alt="Diana Molski" width="820" height="806" loading="lazy" />
              <div>
                <p class="eyebrow eyebrow-light">About Diana</p>
                <span>Founder, Cloud &amp; Capital · Los Angeles</span>
              </div>
            </div>
            <h2 id="about-title">I know finance. I also know how to build.</h2>
          </div>

          <div class="about-copy" data-reveal>
            <p class="about-lede">I started my career at Morgan Stanley and later traded equities. I earned my B.S. in Business Administration, Finance from California State University, Dominguez Hills.</p>
            <p>Today my work spans forecasting, financial modeling, cost analysis, cloud and AI economics, and the public tools you see here. I can trace a number back to the data, build the analysis around it, and explain it clearly to finance and technical teams.</p>
            <p>The answer should hold up when someone asks where it came from, and it should be useful to the person making the decision.</p>

            <ul class="credentials" aria-label="Professional credentials">
              {about.credentials.map((credential) => <li>{credential}</li>)}
            </ul>

            <a class="recognition" href={about.recognitionUrl} target="_blank" rel="noopener noreferrer">{about.recognition} <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <article class="event-proof" data-reveal>
          <div class="event-copy">
            <p class="card-label card-label-gold">Community · April 2026</p>
            <h3>Hosted the first FinOps Weekly Los Angeles meetup.</h3>
            <p>I organized and hosted the event at Common Space Brewery in Hawthorne, with speakers from Ulta Beauty and Wiv.ai and people from finance, engineering, cloud, and FinOps in the room.</p>
            <span>Common Space Brewery · Hawthorne, California</span>
          </div>
          <div class="event-visual">
            <div class="event-poster-wrap">
              <img class="event-poster" src="/images/event-poster-vol01.png" alt="April 2026 poster naming Diana Molski as the Los Angeles meetup host" width="1200" height="1200" loading="lazy" />
            </div>
            <img class="event-photo" src="/images/community/photo-3.jpeg" alt="People gathering at the April 2026 Los Angeles cloud cost meetup" width="4032" height="3024" loading="lazy" />
          </div>
        </article>
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="shell contact-grid" data-reveal>
        <div>
          <p class="eyebrow eyebrow-gold">Get in touch</p>
          <h2 id="contact-title"><span>Have a number, bill, or idea</span><span>you want to make sense of?</span></h2>
        </div>
        <div class="contact-copy">
          <p>Tell me what you are working on and what is getting in the way. It can be for you, your business, or a team dealing with cloud and AI costs.</p>
          <div class="contact-actions">
            <a class="button button-white" href={contactLink.href} data-analytics-event="cta_click" data-analytics-destination="contact" data-analytics-source="homepage_contact">Email Diana</a>
            <a class="text-action text-action-light" href="https://www.linkedin.com/in/dianalyst" target="_blank" rel="noopener noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.documentElement.classList.add('reveal-ready');
  const revealItems = document.querySelectorAll('[data-reveal]');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12 });
    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  }
</script>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { background: #f5eee9; color: #191714; }
  .home { overflow: hidden; font-family: 'Jost', system-ui, sans-serif; }
  #tools, #writing, #about, #contact { scroll-margin-top: 5rem; }
  .shell { width: min(calc(100% - 4rem), 78rem); margin-inline: auto; }
  h1, h2, h3, p { margin: 0; }
  h1, h2, h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400; text-wrap: balance; }
  p { text-wrap: pretty; }
  a { color: inherit; }
  :global(.reveal-ready) [data-reveal] { opacity: 0; transform: translateY(1.1rem); transition: opacity .7s ease, transform .7s ease; }
  :global(.reveal-ready) [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
  .eyebrow,
  .card-label,
  .proof-item > span {
    font-family: 'DM Mono', monospace;
    font-size: .61rem;
    font-weight: 400;
    letter-spacing: .16em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .eyebrow { display: flex; align-items: center; gap: .75rem; color: #4f7567; }
  .eyebrow::after { content: ''; width: 2.7rem; height: 1px; background: currentColor; opacity: .42; }
  .eyebrow-light { color: #b4c8bf; }
  .eyebrow-gold { color: #ddb977; }
  .button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: .82rem 1.2rem;
    border: 1px solid transparent;
    font-family: 'DM Mono', monospace;
    font-size: .62rem;
    letter-spacing: .12em;
    line-height: 1.4;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform .18s ease, background .18s ease, color .18s ease, border-color .18s ease;
  }
  .button:hover { transform: translateY(-2px); }
  .button:focus-visible,
  .text-action:focus-visible,
  .path-card a:focus-visible,
  .tool-card a:focus-visible,
  .small-tool:focus-visible,
  .article-card:focus-visible,
  .recognition:focus-visible { outline: 2px solid currentColor; outline-offset: .3rem; }
  .button-primary { background: #3d6055; color: #fff; }
  .button-primary:hover { background: #4f7567; }
  .button-white { background: #f5eee9; color: #2b2622; }
  .button-white:hover { background: #fff; }
  .text-action {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    padding: .35rem 0 .42rem;
    font-family: 'DM Mono', monospace;
    font-size: .61rem;
    letter-spacing: .11em;
    line-height: 1.5;
    text-transform: uppercase;
    text-decoration: none;
  }
  .text-action::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(.28);
    transform-origin: left;
    transition: transform .22s ease;
  }
  .text-action:hover::after { transform: scaleX(1); }
  .text-action span { transition: transform .22s ease; }
  .text-action:hover span { transform: translateX(.16rem); }
  .text-action-dark { color: #2e4e44; }
  .text-action-light { color: #b9cec5; }

  .hero { padding: clamp(7.6rem, 10vw, 9rem) 0 clamp(4.25rem, 7vw, 6rem); background: #f5eee9; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(3rem, 7vw, 6.5rem); align-items: center; }
  .hero-copy h1 { max-width: 13ch; margin-top: 0; font-size: clamp(3.7rem, 5.55vw, 5.75rem); line-height: .93; letter-spacing: -.042em; }
  .scribbled-word { position: relative; display: inline-block; font-style: italic; color: #3d6055; white-space: nowrap; }
  .scribbled-word svg { position: absolute; left: -.08em; right: -.08em; bottom: -.16em; width: calc(100% + .16em); height: .28em; overflow: visible; }
  .scribbled-word path { fill: none; stroke: #c29260; stroke-width: 2.2; stroke-linecap: round; opacity: .75; stroke-dasharray: 260; stroke-dashoffset: 260; animation: scribble-in 1.1s ease forwards 1s; }
  .scribbled-word path:last-child { opacity: .42; animation-delay: 1.22s; }
  .hero-lede { max-width: 58ch; margin-top: 1.6rem; color: #4a4a4a; font-size: 1rem; line-height: 1.78; }
  .hero-byline { margin-top: 1.15rem; color: #6c665f; font-family: 'DM Mono', monospace; font-size: .6rem; letter-spacing: .11em; line-height: 1.5; text-transform: uppercase; }
  .hero-actions,
  .writing-actions,
  .contact-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.4rem; margin-top: 1.8rem; }
  .hero-visual { min-width: 0; padding: .75rem .5rem 1.25rem; }
  .hero-actions .button { min-height: 48px; border-radius: 8px; padding: .9rem 1.25rem; }
  .hero-actions .hero-secondary { background: #e2e8df; color: #2e4e44; border-color: #cbd7cd; }
  .hero-actions .hero-secondary:hover { background: #d5dfd2; }

  .proof { background: #211f1b; color: #f5eee9; }
  .proof-grid { display: grid; grid-template-columns: 1.05fr 1.25fr 1.1fr .85fr; }
  .proof-item { min-height: 4.8rem; padding: 1rem .9rem; display: flex; align-items: baseline; gap: .5rem; border-right: 1px solid rgba(245, 238, 233, .12); white-space: nowrap; }
  .proof-item:first-child { padding-left: 0; }
  .proof-item:last-child { padding-right: 0; border-right: 0; }
  .proof-item > span { color: #ddb977; }
  .proof-item strong { display: block; color: rgba(245, 238, 233, .82); font-family: 'Cormorant Garamond', Georgia, serif; font-size: .9rem; font-weight: 400; line-height: 1.2; }

  .paths { padding: clamp(4.5rem, 7vw, 6.25rem) 0; background: #fbfaf7; }
  .section-heading { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(20rem, .9fr); gap: clamp(2.5rem, 7vw, 6.5rem); align-items: end; }
  .section-heading h2 { max-width: 18ch; margin-top: .9rem; font-size: clamp(2.65rem, 4vw, 4.2rem); line-height: .99; letter-spacing: -.035em; }
  .section-heading > p { max-width: 39ch; padding-left: 1.4rem; border-left: 2px solid rgba(107, 142, 127, .4); color: #4a4a4a; font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.08rem, 1.55vw, 1.35rem); line-height: 1.52; text-wrap: balance; }
  .path-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 3.25rem; border-top: 2px solid #6b8e7f; border-bottom: 1px solid rgba(25, 23, 20, .14); }
  .path-card { position: relative; min-height: 20.5rem; padding: 2.2rem; display: flex; flex-direction: column; border-right: 1px solid rgba(25, 23, 20, .12); }
  .path-card:last-child { border-right: 0; }
  .path-card-tint { background: #edf2ee; }
  .path-number { position: absolute; top: 1.7rem; right: 1.8rem; color: rgba(61, 96, 85, .22); font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2.5rem; line-height: 1; }
