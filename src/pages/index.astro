---
import BaseLayout from '../layouts/BaseLayout.astro';
import BusinessArtwork from '../components/BusinessArtwork.astro';
import ServiceWatermark from '../components/ServiceWatermark.astro';
import {
  about,
  contactLink,
  newsletter,
  tools,
  homepageWriting,
} from '../data/siteContent';

const aiCostLens = tools.find((tool) => tool.slug === 'ai-cost-lens');
const cloudCostGuard = tools.find((tool) => tool.slug === 'cloud-cost-guard-lumen');
const marketTape = tools.find((tool) => tool.slug === 'market-tape');
const signalAudit = tools.find((tool) => tool.slug === 'signal-audit');
const interactiveLab = tools.find((tool) => tool.slug === 'interactive-lab');
const featuredArticles = homepageWriting;
---

<BaseLayout
  title="Cloud & Capital | AI, Cloud Costs & Workflow Consulting"
  description="AI, cloud, and software cost reviews for startups, plus workflow reviews and automation setup for service businesses. Work with Diana Molski or explore free tools."
>
  <main class="home" id="main-content">
    <section class="hero" aria-labelledby="home-title">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Business services · Finance &amp; technology</p>
          <h1 id="home-title">Better decisions about your tools, your costs, <em>and your time.</em></h1>
          <p class="hero-lede">I’m Diana. I help small businesses and growing tech teams understand technology spending, improve recurring work, and put useful tools in place.</p>
          <p class="hero-context">Maybe your cloud or AI bill keeps growing. Maybe the same report takes hours every month. Or you know what needs improving and want help building it. We’ll start with the question you need answered.</p>
          <p class="hero-byline">Diana Molski · Finance analyst and tool builder</p>
          <div class="hero-actions">
            <a class="button button-primary" href="/services" data-analytics-event="cta_click" data-analytics-destination="services" data-analytics-source="homepage_hero">Explore business services</a>
            <a class="button hero-secondary" href="#tools" data-analytics-event="cta_click" data-analytics-destination="work" data-analytics-source="homepage_hero">Try the free tools</a>
          </div>
        </div>

        <div class="hero-visual">
          <BusinessArtwork />
        </div>
      </div>
    </section>

    <section class="paths" id="services" aria-labelledby="paths-title">
      <div class="shell">
        <div class="section-heading paths-heading" data-reveal>
          <div><p class="eyebrow">Three ways to work together</p><h2 id="paths-title">What needs a closer look?</h2></div>
          <p>Start with the spending, the work, or a project you already have in mind.</p>
        </div>
        <div class="path-grid">
          <a class="path-card" href="/services" data-reveal data-analytics-event="cta_click" data-analytics-destination="services" data-analytics-source="homepage_path_business">
            <ServiceWatermark kind="cost" />
            <p class="card-label">Technology Cost Review</p>
            <h3 class="cost-question"><span>“Why does the</span> <span>bill keep growing?”</span></h3>
            <p>For teams with meaningful cloud, AI, or software costs. Understand what’s driving the bill and what deserves attention.</p>
            <p class="path-deliverable"><strong>You leave with</strong> a cost baseline, an explanation of the changes, and prioritized next steps.</p>
            <span class="path-action"><span>Explore the cost review</span><span class="link-arrow" aria-hidden="true">→</span></span>
          </a>
          <a class="path-card path-card-tint" href="/services#workflow-review" data-reveal data-analytics-event="cta_click" data-analytics-destination="services" data-analytics-source="homepage_path_workflow">
            <ServiceWatermark kind="workflow" />
            <p class="card-label">AI &amp; Workflow Review</p>
            <h3>“Why does this take so long?”</h3>
            <p>For service businesses moving the same information between emails, documents, and spreadsheets. Review one recurring task.</p>
            <p class="path-deliverable"><strong>You leave with</strong> a map of the work and a plan for improving it, including whether AI belongs in it.</p>
            <span class="path-action"><span>Explore the workflow review</span><span class="link-arrow" aria-hidden="true">→</span></span>
          </a>
          <a class="path-card" href="/services#practical-setup" data-reveal data-analytics-event="cta_click" data-analytics-destination="services" data-analytics-source="homepage_path_setup">
            <ServiceWatermark kind="setup" />
            <p class="card-label">Tool &amp; Automation Setup</p>
            <h3>“Can you help me build it?”</h3>
            <p>For a defined project: a reporting template, connected tools, or a small automation. Start here when you know what you need.</p>
            <p class="path-deliverable"><strong>You leave with</strong> the agreed setup, checks, and instructions for using it.</p>
            <span class="path-action"><span>Explore setup</span><span class="link-arrow" aria-hidden="true">→</span></span>
          </a>
        </div>
        <p class="service-scope-note">A clear scope, fixed quote, and timeline before work begins. Start with an email.</p>
      </div>
    </section>

    <section class="review-examples" aria-labelledby="examples-title">
      <div class="shell">
        <div class="section-heading" data-reveal>
          <div><p class="eyebrow">See the approach</p><h2 id="examples-title">What would a review actually tell you?</h2></div>
        </div>
        <div class="example-grid">
          <a href="/services/examples#cost" class="example-card" data-reveal data-analytics-event="cta_click" data-analytics-destination="services" data-analytics-source="homepage_examples">
            <p class="card-label">Technology costs</p>
            <h3><span>A growing product.</span> <span>An even faster growing bill.</span></h3>
            <p>Follow three months of spending and investigate why the AI cost per accepted result rose.</p>
            <span class="example-action"><span>See the cost review</span><span class="link-arrow" aria-hidden="true">→</span></span>
          </a>
          <a href="/services/examples#workflow" class="example-card" data-reveal data-analytics-event="cta_click" data-analytics-destination="services" data-analytics-source="homepage_examples">
            <p class="card-label">Recurring work</p>
            <h3><span>The same numbers.</span> <span>Copied into every report.</span></h3>
            <p>See why a controlled reporting template could be a better first step than adding AI.</p>
            <span class="example-action"><span>See the workflow review</span><span class="link-arrow" aria-hidden="true">→</span></span>
          </a>
        </div>
      </div>
    </section>

    <section class="tools-section" id="tools" aria-labelledby="tools-title">
      <div class="shell">
        <div class="section-heading tools-heading" data-reveal>
          <div>
            <p class="eyebrow eyebrow-light">Tools</p>
            <h2 id="tools-title">Tools for real questions.</h2>
          </div>
          <p>Everything here is free to use. Open a tool, see the method, or look through the code.<br /><a class="browse-tools-link" href="/tools" data-analytics-event="cta_click" data-analytics-destination="work" data-analytics-source="homepage_featured_tools"><span>Browse all free tools</span><span class="link-arrow" aria-hidden="true">→</span></a></p>
        </div>

        {aiCostLens && (
          <article class="flagship-tool" data-reveal>
            <div class="flagship-copy">
              <p class="card-label card-label-gold">Featured tool · AI economics</p>
              <h3>{aiCostLens.title}</h3>
              <p class="tool-question">What did one usable result really cost?</p>
              <p>Estimate a route from published prices. With matched cost, usage, and checked outcomes, see whether a cheaper option still holds up after quality and rework.</p>
              <div class="tool-actions">
                <a class="tool-launch" href={aiCostLens.href} target="_blank" rel="noopener noreferrer" data-analytics-event="cta_click" data-analytics-destination="ai_cost_lens" data-analytics-source="homepage_featured_tools">Open AI Cost Lens <span class="link-arrow" aria-hidden="true">→</span></a>
                <a class="tool-source" href={aiCostLens.sourceHref} target="_blank" rel="noopener noreferrer" data-analytics-event="cta_click" data-analytics-destination="ai_cost_lens_github" data-analytics-source="homepage_featured_tools"><span class="tool-source-label">View the source</span><span class="tool-source-arrow link-arrow" aria-hidden="true">→</span></a>
              </div>
            </div>
            <a class="flagship-window" href={aiCostLens.href} target="_blank" rel="noopener noreferrer" aria-label="Open AI Cost Lens" data-analytics-event="cta_click" data-analytics-destination="ai_cost_lens" data-analytics-source="homepage_featured_tools">
              <span class="window-bar" aria-hidden="true">
                <span class="window-dots"><i></i><i></i><i></i></span>
                <span>lens.cloudandcapital.com · illustrative example</span>
              </span>
              <span class="window-canvas">
                <img src="/images/ai-cost-lens-cost-anatomy-wide.png" alt="AI Cost Lens illustrative example comparing the full cost of two AI routes" width="2190" height="964" loading="lazy" />
              </span>
            </a>
          </article>
        )}

        <div class="tool-grid">
          {cloudCostGuard && (
            <a class="tool-card" href={cloudCostGuard.href} target="_blank" rel="noopener noreferrer" data-reveal data-analytics-event="cta_click" data-analytics-destination="cloud_cost_guard" data-analytics-source="homepage_featured_tools">
              <div class="tool-preview">
                <div class="preview-surface">
                  <div class="window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>guard.cloudandcapital.com</span></div>
                  <img src="/images/cloud-cost-guard-spend-reconciliation.jpg" alt="Published technology spend, passed reconciliation, and Cloud, Direct AI, and SaaS breakdown" width="1216" height="474" loading="lazy" />
                </div>
              </div>
              <p class="card-label">Cloud, AI, and SaaS</p>
              <h3>Cloud Cost Guard</h3>
              <p class="tool-question">Why did the bill move?</p>
              <p>Trace cost drivers, review anomalies, and understand the records behind the bill.</p>
              <span class="tool-card-action"><span>Open Cloud Cost Guard</span><span class="link-arrow" aria-hidden="true">→</span></span>
            </a>
          )}

          <a class="tool-card renewal-feature" href="/resources/software-renewal" data-reveal data-analytics-event="cta_click" data-analytics-destination="work" data-analytics-source="homepage_featured_tools">
            <div class="renewal-art" aria-hidden="true"><span>Before you renew.</span><svg viewBox="0 0 210 110" fill="none"><path d="M40 22H171M40 55H171M40 88H135" stroke="currentColor" stroke-width="2" opacity=".25"/><path d="m15 18 5 5 10-12m-15 40 5 5 10-12m-15 40 5 5 10-12" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <p class="card-label">Free worksheet</p><h3>Software Renewal Checklist</h3>
            <p class="tool-question">Is this subscription worth keeping?</p>
            <p>Eight questions about the bill, how the tool is used, and what changing it would involve.</p>
            <span class="tool-card-action"><span>Get the checklist</span><span class="link-arrow" aria-hidden="true">→</span></span>
          </a>
        </div>

        <div class="smaller-tools" data-reveal>
          <div class="smaller-tools-intro">
            <h3 class="card-label">More tools</h3>
          </div>
          {signalAudit && (
            <a class="small-tool" href={signalAudit.href} data-analytics-event="cta_click" data-analytics-destination="signal_audit" data-analytics-source="homepage_featured_tools">
              <span class="small-tool-label"><span>Signal Audit</span><span class="link-arrow" aria-hidden="true">→</span></span>
              <p>Find where technology cost accountability is breaking down.</p>
            </a>
          )}
          {interactiveLab && (
            <a class="small-tool" href={interactiveLab.href} data-analytics-event="cta_click" data-analytics-destination="interactive_lab" data-analytics-source="homepage_featured_tools">
              <span class="small-tool-label"><span>Interactive Lab</span><span class="link-arrow" aria-hidden="true">→</span></span>
              <p>Organize the evidence around a real technology spend decision.</p>
            </a>
          )}
        </div>
        <div class="tool-review-invitation" data-reveal><p>Want help making sense of your own technology spending?</p><a class="text-action" href="/services#technology-cost-review" data-analytics-event="cta_click" data-analytics-destination="services" data-analytics-source="homepage_featured_tools"><span>Explore a Technology Cost Review</span><span class="link-arrow" aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="about-section" id="about" aria-labelledby="about-title">
      <div class="site-shell">
        <div class="about-grid">
          <div class="about-identity" data-reveal>
            <p class="eyebrow eyebrow-light">About Diana</p>
            <img class="about-portrait" src="/images/diana-molski-portrait.png" alt="Diana Molski" width="820" height="806" loading="lazy" />
            <p class="about-location">Founder, Cloud &amp; Capital · Los Angeles</p>
            <h2 id="about-title"><span>{about.headingLead}</span> <span>{about.headingMiddle}</span> <em>{about.headingItalic}</em></h2>
          </div>

          <div class="about-copy" data-reveal>
            {about.biography.map((paragraph) => <p class="about-body">{paragraph}</p>)}

            <p class="about-credentials-label">Credentials</p>
            <dl class="credentials" aria-label="Professional credentials">
              {about.credentials.map((credential) => (
                <div class="credential-row"><dt>{credential.category}</dt><dd>{credential.detail}</dd></div>
              ))}
              <div class="credential-row credential-contribution">
                <dt>CONTRIBUTION</dt>
                <dd><a class="contribution-link" href={about.recognitionUrl} target="_blank" rel="noopener noreferrer"><span>{about.recognition}</span><span class="link-arrow" aria-hidden="true">→</span></a></dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="writing-section" id="writing" aria-labelledby="writing-title">
      <div class="shell">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow">Writing</p>
            <h2 id="writing-title">Markets, money, and what I’m learning as I build.</h2>
          </div>
        </div>


        <div class="article-grid">
          {featuredArticles.map((article, index) => (
            <a class="article-card" href={article.href} target="_blank" rel="noopener noreferrer" data-reveal data-analytics-event="cta_click" data-analytics-destination="substack" data-analytics-source="homepage_writing">
              <div class="article-copy">
                <p class="article-latest">{index === 0 ? 'Featured essay' : index === 1 ? 'Latest' : 'Previously'}</p>
                <p class="card-label">{article.topic.replace(' · Issue No. 1', '').replace(' · Issue no. 1', '')} · {article.date}</p>
                <h3>{article.title}</h3>
                <p>{article.description}</p>
                <span class="article-action"><span>Read</span><span class="link-arrow" aria-hidden="true">→</span></span>
              </div>
              {index === 0 && (
                <div class="decision-artwork" role="img" aria-label="What gets built, what gets locked in, and what becomes the default.">
                  <svg class="decision-linework" viewBox="0 0 500 500" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M 72 -15 V 194 M 72 270 V 440 M 350 18 V 178 M 350 236 V 515 M 18 108 H 306 M 116 174 H 510" />
                    <path d="M -20 360 H 286 M 212 426 H 505" />
                  </svg>
                  <div class="decision-terms" aria-hidden="true">
                    <div class="decision-term decision-built"><span>What gets</span><strong>Built</strong></div>
                    <div class="decision-term decision-locked"><span>What gets</span><strong>Locked in</strong></div>
                    <div class="decision-term decision-default"><span>What becomes the</span><strong>Default</strong></div>
                  </div>
                </div>
              )}

            </a>
          ))}
        </div>

        <div class="writing-actions">
          <a class="button button-primary" href="/insights">Explore business insights</a>
          <a class="button button-secondary" href={newsletter.subscribeHref} target="_blank" rel="noopener noreferrer" data-analytics-event="cta_click" data-analytics-destination="substack" data-analytics-source="homepage_writing">Read Markets &amp; Mimosas</a>
        </div>
      </div>
    </section>

    <section class="learning-section" aria-labelledby="learning-title">
      <div class="shell learning-grid">
        <div data-reveal><p class="eyebrow">Investing &amp; trading</p><h2 id="learning-title">Here for your own money questions?</h2></div>
        <div data-reveal><p>Learn investing and trading concepts through one-to-one lessons, worked examples, and guided practice. Bring the questions you’ve been wanting to ask.</p><a class="text-action" href="/learn" data-analytics-event="cta_click" data-analytics-destination="learn" data-analytics-source="homepage_path_personal"><span>Explore investing &amp; trading lessons</span><span class="link-arrow" aria-hidden="true">→</span></a>
          {marketTape && <a class="learning-market-link" href={marketTape.href} target="_blank" rel="noopener noreferrer" data-analytics-event="cta_click" data-analytics-destination="market_tape" data-analytics-source="homepage_writing"><span>Explore market context in Market Tape</span><span class="link-arrow" aria-hidden="true">→</span></a>}
          <p class="education-note">Education and research only. Cloud &amp; Capital does not provide personal investment advice.</p>
        </div>
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="site-shell contact-inner" data-reveal>
        <p class="eyebrow eyebrow-gold">Get in touch</p>
        <h2 id="contact-title"><span>Have a number, bill, or idea</span> <span>you want to make sense of?</span></h2>
        <div class="contact-copy">
          <p>Tell me what’s getting stuck, which tools you use, and what you’d like to change. A few lines are enough.</p>
          <a class="contact-email-card" href={contactLink.href} data-analytics-event="cta_click" data-analytics-destination="contact" data-analytics-source="homepage_contact">
            <span class="contact-email-label">Email Diana <svg class="contact-email-heart" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8.1 13.6C5.5 11.9 2.1 9.5 1.9 6.3c-.1-1.6.8-2.8 2.2-2.9 1.5-.2 2.8.9 3.7 2.1 1-1.6 2.4-2.5 3.7-2.3 1.7.2 2.5 1.5 2.3 3-.3 2.8-3.1 5.1-5.7 7.4Z" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <span class="contact-email-address">diana@cloudandcapital.com</span>
            <span class="contact-email-circle" aria-hidden="true"><span class="contact-email-arrow">→</span></span>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.documentElement.classList.add('reveal-ready');
  const revealItems = document.querySelectorAll('[data-reveal]');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12 });
    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  }
</script>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { background: #f5eee9; color: #191714; }
  .home { overflow: hidden; font-family: 'Jost', system-ui, sans-serif; }
  #tools, #writing, #about, #contact { scroll-margin-top: 5rem; }
  .shell { width: min(calc(100% - 4rem), 78rem); margin-inline: auto; }
  h1, h2, h3, p { margin: 0; }
  h1, h2, h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400; text-wrap: balance; }
  p { text-wrap: pretty; }
  a { color: inherit; }
  :global(.reveal-ready) [data-reveal] { opacity: 0; transform: translateY(1.1rem); transition: opacity .7s ease, transform .7s ease; }
  :global(.reveal-ready) [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
  .eyebrow,
  .card-label {
    font-family: 'DM Mono', monospace;
    font-size: .61rem;
    font-weight: 400;
    letter-spacing: .16em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .eyebrow { display: flex; align-items: center; gap: .75rem; color: #4f7567; }
  .eyebrow::after { content: ''; width: 2.7rem; height: 1px; background: currentColor; opacity: .42; }
  .eyebrow-light { color: #b4c8bf; }
  .eyebrow-gold { color: #ddb977; }
  .button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: .82rem 1.2rem;
    border: 1px solid transparent;
    font-family: 'DM Mono', monospace;
    font-size: .62rem;
    letter-spacing: .12em;
    line-height: 1.4;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform .18s ease, background .18s ease, color .18s ease, border-color .18s ease;
  }
  .button:hover { transform: translateY(-2px); }
  .button:focus-visible,
  .text-action:focus-visible,
  .path-card a:focus-visible,
  .tool-card a:focus-visible,
  .small-tool:focus-visible,
  .article-card:focus-visible { outline: 2px solid currentColor; outline-offset: .3rem; }
  .button-primary { background: #4f7167; color: #f5eee9; }
  .button-primary:hover { background: #45675e; }
  .button-white { background: #f5eee9; color: #2b2622; }
  .button-white:hover { background: #fff; }
  .text-action {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    padding: .35rem 0 .42rem;
    font-family: 'DM Mono', monospace;
    font-size: .61rem;
    letter-spacing: .11em;
    line-height: 1.5;
    text-transform: uppercase;
    text-decoration: none;
  }
  .text-action > span:first-child { position: relative; }
  .text-action > span:first-child::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(.28);
    transform-origin: left;
    transition: transform .22s ease;
  }
  .text-action:hover > span:first-child::after, .text-action:focus-visible > span:first-child::after { transform: scaleX(1); }
  .text-action > span:last-child { transition: transform .22s ease; }
  .text-action:hover > span:last-child { transform: translateX(.16rem); }
  .text-action-dark { color: #2e4e44; }
  .text-action-light { color: #b9cec5; }

  .hero { padding: clamp(7.6rem, 10vw, 9rem) 0 clamp(4.25rem, 7vw, 6rem); background: #f5eee9; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(3rem, 7vw, 6.5rem); align-items: center; }
  .hero-copy h1 { max-width: 15ch; margin-top: 0; font-size: clamp(3.7rem, 5.55vw, 5.75rem); line-height: .93; letter-spacing: -.042em; }
  .scribbled-word { position: relative; display: inline-block; font-style: italic; color: #3d6055; white-space: nowrap; }
  .scribbled-word svg { position: absolute; left: -.08em; right: -.08em; bottom: -.16em; width: calc(100% + .16em); height: .28em; overflow: visible; }
  .scribbled-word path { fill: none; stroke: #c29260; stroke-width: 2.2; stroke-linecap: round; opacity: .75; stroke-dasharray: 260; stroke-dashoffset: 260; animation: scribble-in 1.1s ease forwards 1s; }
  .scribbled-word path:last-child { opacity: .42; animation-delay: 1.22s; }
  .hero-lede { max-width: 58ch; margin-top: 1.6rem; color: #4a4a4a; font-size: 1rem; line-height: 1.78; }
  .hero-byline { margin-top: 1.15rem; color: #6c665f; font-family: 'DM Mono', monospace; font-size: .6rem; letter-spacing: .11em; line-height: 1.5; text-transform: uppercase; }
  .hero-actions,
  .writing-actions,
  .contact-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.4rem; margin-top: 1.8rem; }
  .hero-visual { min-width: 0; padding: .75rem .5rem 1.25rem; }
  @media (min-width: 1280px) {
