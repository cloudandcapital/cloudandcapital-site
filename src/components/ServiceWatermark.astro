---
interface Props { kind: 'cost' | 'workflow' | 'setup'; }
const { kind } = Astro.props;
const artwork = {
  cost: '/images/service-bill-3d.webp',
  workflow: '/images/service-clock-3d.webp',
  setup: '/images/service-blocks-3d.webp',
};
---
<img
  class="service-watermark"
  data-kind={kind}
  src={artwork[kind]}
  alt=""
  aria-hidden="true"
  width="512"
  height="512"
  loading="lazy"
  decoding="async"
/>

<style>
  .service-watermark { position: absolute; top: 1.1rem; right: 1.1rem; width: 7.5rem; height: 7.5rem; object-fit: contain; pointer-events: none; }
  .service-watermark[data-kind="cost"] { width: 7rem; height: 7rem; }
  @media (max-width: 760px) {
    .service-watermark { top: 1.25rem; right: 1rem; width: 6.75rem; height: 6.75rem; }
    .service-watermark[data-kind="cost"] { width: 6.25rem; height: 6.25rem; }
  }
</style>
