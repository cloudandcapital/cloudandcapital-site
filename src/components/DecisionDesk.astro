---
const analyses = [
  { id: 'invest', label: 'Invest', numbers: '10-year yields are up 18 bps while growth stocks are down 2.4%.', conclusion: 'Rates are driving the move, not broad panic.' },
  { id: 'spend', label: 'Spend', numbers: '6 of 27 software tools are barely used. Renewal is in 14 days.', conclusion: 'Review the licenses before the contract renews.' },
  { id: 'build', label: 'Build', numbers: 'Model usage is $35k, infrastructure is $25k, and human review is $52.8k.', total: 'Total cost: $112.8k', conclusion: 'The cheaper model is not the cheaper result.' },
];
---

<div class="analysis-stack" data-decision-desk>
  <div class="analysis-card">
    <div class="analysis-tabs" role="tablist" aria-label="Explore the Cloud and Capital focus areas">
      {analyses.map((analysis, index) => (
        <button id={`decision-tab-${analysis.id}`} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`decision-panel-${analysis.id}`} tabindex={index === 0 ? 0 : -1}>{analysis.label}</button>
      ))}
    </div>
    <div class="analysis-content">
      {analyses.map((analysis, index) => (
        <section id={`decision-panel-${analysis.id}`} role="tabpanel" aria-labelledby={`decision-tab-${analysis.id}`} tabindex="0" hidden={index !== 0}>
          <p class="analysis-numbers">{analysis.numbers}</p>
          <h2 class="analysis-conclusion">{analysis.conclusion}</h2>
          {analysis.total && <p class="analysis-total">{analysis.total}</p>}
        </section>
      ))}
    </div>
    <p class="analysis-note">Sample analysis</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-decision-desk]').forEach((desk) => {
    const tabs = Array.from(desk.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(desk.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const activate = (index: number) => {
      if (tabs[index].getAttribute('aria-selected') === 'true') return;
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
        panels[i].classList.toggle('was-selected', i === index);
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        let next: number;
        switch (event.key) {
          case 'ArrowRight': next = (index + 1) % tabs.length; break;
          case 'ArrowLeft': next = (index - 1 + tabs.length) % tabs.length; break;
          case 'Home': next = 0; break;
          case 'End': next = tabs.length - 1; break;
          default: return;
        }
        event.preventDefault();
        activate(next);
        tabs[next].focus();
      });
    });
  });
</script>

<style>
  .analysis-stack { position: relative; isolation: isolate; min-width: 0; }
  .analysis-stack::before { content: ''; position: absolute; inset: 12px -5px -12px 12px; z-index: -1; border-radius: 22px; border: 1px solid #c9d3c6; background: #dfe5da; transform: rotate(2deg); }
  .analysis-card { position: relative; padding: clamp(1.5rem, 3vw, 2.6rem); border: 1px solid #cbd5c8; border-radius: 21px; background: linear-gradient(135deg, #fffdf8, #f4f0e7); box-shadow: 0 28px 65px -22px rgba(38, 54, 44, .3), 0 5px 15px rgba(38, 54, 44, .04); color: #262a24; }
  .analysis-tabs { display: flex; gap: .4rem; padding: .3rem; border-radius: 12px; background: #e9ede4; }
  .analysis-tabs button { flex: 1; min-width: 0; min-height: 44px; border: 0; border-radius: 9px; background: transparent; color: #506356; font-family: 'Jost', sans-serif; font-size: .9rem; font-weight: 500; cursor: pointer; }
  .analysis-tabs button[aria-selected='true'] { background: #3d6055; color: #fffdf8; box-shadow: 0 3px 8px rgba(38, 54, 44, .12); }
  .analysis-tabs button:hover:not([aria-selected='true']) { background: #dce4d6; }
  .analysis-tabs button:focus-visible, [role='tabpanel']:focus-visible { outline: 2px solid #3d6055; outline-offset: 4px; }
  .analysis-content { display: grid; margin-top: clamp(2rem, 4vw, 3.2rem); }
  [role='tabpanel'] { grid-area: 1 / 1; min-width: 0; }
  [role='tabpanel'][hidden] { display: block; visibility: hidden; pointer-events: none; }
  .analysis-numbers { margin: 0 0 1.5rem; max-width: 39ch; color: #60675c; font-family: 'Jost', sans-serif; font-size: 1rem; line-height: 1.7; }
  .analysis-conclusion { margin: 0; max-width: 18ch; color: #304d40; font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.2rem, 3.2vw, 3.2rem); font-weight: 500; letter-spacing: -.025em; line-height: 1.08; text-wrap: balance; }
  .analysis-total { margin: 1.3rem 0 0; color: #846340; font-family: 'Jost', sans-serif; font-size: .88rem; }
  .analysis-note { margin: 2.5rem 0 0; color: #76786c; font-family: 'Jost', sans-serif; font-size: .72rem; letter-spacing: .06em; }
  .was-selected { animation: settle-in .3s ease both; }
  @keyframes settle-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 480px) {
    .analysis-card { padding: 1.4rem; }
    .analysis-conclusion { font-size: 2.3rem; }
    .analysis-numbers { font-size: .94rem; }
  }
  @media (prefers-reduced-motion: reduce) { .was-selected { animation: none; } }
</style>
