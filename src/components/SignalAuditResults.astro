<section id="results" class="results-rail brief" aria-labelledby="resultTitle" hidden>
  <header class="brief-masthead">
    <div class="brief-masthead-copy">
      <p class="step-label">Your operating pattern</p>
      <h2 id="resultTitle"></h2>
      <p id="resultMeaning" class="brief-meaning"></p>
    </div>
    <div class="brief-summary" aria-label="Result summary">
      <div class="brief-metrics">
        <div><strong id="axisSignalScore">—</strong><span>Signal Readiness</span></div>
        <div><strong id="axisDecisionScore">—</strong><span>Decision Integration</span></div>
        <div><strong id="evidenceScore">—</strong><span>Evidence coverage</span></div>
      </div>
      <dl class="brief-scope">
        <div><dt>Assessment scope</dt><dd id="scopeLabel"></dd></div>
        <div><dt>Technology scope</dt><dd id="technologyLabel" class="brief-technology-list"></dd></div>
        <div class="sr-only"><dt>Confidence</dt><dd id="confidenceLabel"></dd></div>
      </dl>
    </div>
  </header>

  <section class="brief-profile" aria-labelledby="profileTitle">
    <div class="brief-section-heading">
      <p class="step-label">Your signal profile</p>
      <h3 id="profileTitle">Where information becomes decision-ready</h3>
    </div>
    <div class="brief-profile-grid">
      <figure class="brief-map" aria-labelledby="mapTitle mapDescription">
        <figcaption><h4 id="mapTitle">Signal map</h4></figcaption>
        <div class="brief-map-frame">
          <div class="brief-axis-y">Decision Integration <span>→</span></div>
          <div class="brief-map-plot" id="mapPlot">
            <span class="brief-quadrant quadrant-nw">Decisions ahead of the data</span>
            <span class="brief-quadrant quadrant-ne">Decision-embedded</span>
            <span class="brief-quadrant quadrant-sw">Invoice-led</span>
            <span class="brief-quadrant quadrant-se">Visible, not embedded</span>
            <span id="mapPoint" class="brief-map-point" aria-hidden="true"><i></i><b>You</b></span>
          </div>
          <div class="brief-axis-x">Signal Readiness <span>→</span></div>
        </div>
        <p id="mapDescription" class="brief-map-description"></p>
      </figure>

      <section class="brief-dimensions" aria-labelledby="dimensionsTitle">
        <h4 id="dimensionsTitle">Four-dimension profile</h4>
        <div class="brief-findings">
          <p><span>Strongest signal</span><strong id="strongestFinding">—</strong></p>
          <p class="priority"><span>Priority area</span><strong id="priorityFinding">—</strong></p>
        </div>
        <div id="dimensionCards"></div>
      </section>
    </div>
  </section>

  <section class="brief-move" aria-labelledby="moveTitle">
    <div>
      <p class="step-label">Prioritized 30-day move</p>
      <h3 id="moveTitle"></h3>
      <p id="moveText"></p>
    </div>
    <div class="brief-move-details">
      <p><strong>Suggested owners</strong><span id="ownerText"></span></p>
      <p><strong>Suggested KPI</strong><span id="measureText"></span></p>
    </div>
  </section>

  <section class="brief-discussion" aria-labelledby="discussionTitle">
    <p class="step-label">Take into the next team discussion</p>
    <h3 id="discussionTitle">Three questions worth answering together</h3>
    <ol id="discussionQuestions"></ol>
  </section>

  <section class="brief-interpretation" aria-labelledby="interpretationTitle">
    <div class="brief-section-heading">
      <p class="step-label">Secondary perspective</p>
      <h3 id="interpretationTitle">AI-assisted interpretation</h3>
      <span id="aiStatus" class="sr-only" role="status">Adding context…</span>
    </div>
    <div class="brief-interpretation-grid">
      <section><h4>Pattern read</h4><p id="patternRead"></p></section>
      <section><h4>Decision implication</h4><p id="decisionImplication"></p></section>
      <section><h4>Scope watchpoint</h4><p id="scopeWatchpoint"></p></section>
    </div>
    <p class="brief-privacy">To create this interpretation, the selected scope choices and answers are sent to the configured AI provider. The audit collects no name, company, email, or free-text business information.</p>
  </section>

  <section class="brief-actions" aria-label="Report actions">
    <div class="brief-actions-main">
      <button class="button primary" id="printButton">Print or Save as PDF</button>
      <button class="button secondary" id="copyButton">Copy Summary</button>
    </div>
    <div class="brief-actions-quiet">
      <button class="brief-text-action" id="retakeButton">Retake audit</button>
      <a class="brief-text-action" href="/interactive-lab">Explore the Interactive Lab →</a>
    </div>
  </section>

  <details class="brief-methodology">
    <summary>Methodology and privacy</summary>
    <div>
      <p>This is a directional self-assessment, not a certification or external benchmark. It is informed by concepts from the <a href="https://www.finops.org/insights/2026-finops-framework/">FinOps Framework</a> and <a href="https://www.finops.org/wg/finops-assessment/">FinOps Assessment Guide</a>, used under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. Cloud &amp; Capital adapted those concepts independently; the FinOps Foundation does not endorse this assessment. Appropriate practice depends on organizational need—not every advanced practice is universally necessary.</p>
      <p>Answers are held in this page for the current session and are not paired with identity or contact information.</p>
    </div>
  </details>
</section>

