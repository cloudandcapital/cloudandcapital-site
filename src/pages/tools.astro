---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLabel from '../components/ActionLabel.astro';
import DirectoryToolCard from '../components/DirectoryToolCard.astro';
import { directoryTools, toolTopics, upcomingTools } from '../data/toolDirectory';

const allEntries = [...directoryTools, ...upcomingTools];
const filters = [{ id: 'all', label: 'View all', tone: 'all' }, ...toolTopics];
---
<BaseLayout title="Free Finance & Technology Tools | Cloud & Capital" description="Free tools for AI costs, cloud bills, software renewals, market context, and business decisions. See what each tool does, what to bring, and what you get.">
  <main id="main-content" class="tools-page">
    <section class="tools-hero" aria-labelledby="tools-title">
      <div class="site-shell">
        <div class="hero-layout">
          <div class="hero-copy">
            <p class="eyebrow">Free tools</p>
            <h1 id="tools-title"><span>Find something</span><em>that helps.</em></h1>
            <p>Understand a bill, keep track of renewals, explore the market, or work through a decision. Start with what you need.</p>
          </div>
          <div class="hero-art" aria-hidden="true">
            <span class="library-folder">
              <span class="folder-layer folder-back"></span>
              <span class="folder-layer folder-card folder-card-sage"></span>
              <span class="folder-layer folder-card folder-card-ivory"></span>
              <span class="folder-layer folder-card folder-card-rose"></span>
              <span class="folder-layer folder-body"></span>
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="tool-library site-shell" data-tool-directory aria-labelledby="library-title">
      <h2 id="library-title" class="visually-hidden">Browse the tools</h2>
      <div class="tool-topics" data-tool-filters role="group" aria-label="Choose a tool topic" hidden>
        {filters.map(filter => (
          <button type="button" data-tool-filter={filter.id} data-tool-tone={filter.tone} aria-pressed={filter.id === 'all' ? 'true' : 'false'} aria-controls="tool-gallery">
            <span>{filter.label}</span>
            <span class="topic-count" aria-hidden="true">{allEntries.filter(tool => filter.id === 'all' || tool.topics.some(topic => topic === filter.id)).length}</span>
          </button>
        ))}
      </div>
      <p class="library-status" data-tool-status role="status" aria-live="polite" aria-atomic="true">{directoryTools.length} tools to try · {upcomingTools.length} coming soon</p>
      <ul class="directory-grid" id="tool-gallery">
        {directoryTools.map(tool => (
          <li class="directory-item" data-tool-item data-tool-id={tool.slug} data-tool-topics={tool.topics.join(' ')}>
            <DirectoryToolCard tool={tool} />
          </li>
        ))}
        {upcomingTools.map(tool => (
          <li class="directory-item" data-tool-item data-tool-id={tool.slug} data-tool-topics={tool.topics.join(' ')} data-tool-upcoming>
            <article class="upcoming-card" data-tone={tool.tone} aria-labelledby={`${tool.slug}-title`}>
              <div class="upcoming-preview" aria-hidden="true"><p>{tool.preview[0]}<br /><em>{tool.preview[1]}</em></p><span class="upcoming-sparkle">✳</span></div>
              <div class="upcoming-copy"><p class="upcoming-label">Coming soon</p><h3 id={`${tool.slug}-title`}>{tool.name}</h3><p>{tool.description}</p></div>
            </article>
          </li>
        ))}
      </ul>
      <div class="source-section">
        <p>Curious how they’re built?</p>
        <a href="https://github.com/cloudandcapital" target="_blank" rel="noopener noreferrer" data-analytics-event="cta_click" data-analytics-destination="github_pipeline" data-analytics-source="work_pipeline"><ActionLabel label="Explore on GitHub" /></a>
      </div>
    </section>

    <section class="tools-contact" aria-labelledby="tools-contact-title">
      <div class="site-shell contact-layout">
        <div><p class="eyebrow">Work with Diana</p><h2 id="tools-contact-title">Want help with a business problem?</h2><p>Explore a cost review, a workflow review, or a small setup project.</p></div>
        <a href="/services" data-analytics-event="cta_click" data-analytics-destination="services" data-analytics-source="work_contact"><ActionLabel label="Ways to work together" /></a>
      </div>
    </section>
  </main>
</BaseLayout>
<script>
  import { initToolDirectory } from '../lib/tool-directory.js';
  const setup = () => initToolDirectory(document.querySelector('[data-tool-directory]'));
  setup();
  document.addEventListener('astro:page-load', setup);
</script>
<style>
  .tools-page { color: var(--brand-ink); font-family: 'Jost', system-ui, sans-serif; }
  .tools-page :is(h1,h2,p) { margin: 0; }
  .eyebrow { display: flex; align-items: center; gap: .75rem; color: #4f7165; font: 400 .65rem/1.5 'DM Mono', monospace; letter-spacing: .12em; text-transform: uppercase; }
  .eyebrow::after { content: ''; width: 2.7rem; height: 1px; background: currentColor; opacity: .45; }
  .tools-hero { padding: clamp(6.5rem, 9vw, 8.5rem) 0 1.5rem; background: var(--cream); }
  .hero-layout { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); }
  .hero-copy h1 { margin-top: 1.2rem; font: 400 clamp(3.5rem, 6.5vw, 5.7rem)/.98 'Cormorant Garamond', Georgia, serif; letter-spacing: -.035em; }
  .hero-copy h1 > span, .hero-copy h1 > em { display: block; max-width: 100%; }
  .hero-copy h1 em { color: var(--brand-green); font-weight: 400; }
  .hero-copy > p:last-child { max-width: 49ch; margin-top: 1.4rem; color: #4b4c45; font-size: 1.0625rem; line-height: 1.75; text-wrap: pretty; }
  .hero-art { position: relative; display: flex; justify-content: center; min-width: 0; padding: 0 1.25rem 1.75rem 0; }
  .library-folder { position: relative; display: block; isolation: isolate; width: clamp(17rem, 28vw, 24rem); aspect-ratio: 1; }
  .folder-layer { position: absolute; background-image: url('/images/tools-folder-layers.webp'); background-size: 200% 200%; background-repeat: no-repeat; }
  .folder-back, .folder-body { left: 5%; top: 17%; width: 90%; height: 90%; background-position: 0 0; }
  .folder-back { z-index: 0; }
  .folder-body { z-index: 4; clip-path: polygon(0% 0%, 14% 0%, 14% 28%, 16% 31%, 18% 35%, 20% 39%, 21% 44%, 22% 46.5%, 24% 44%, 27% 42.5%, 31% 41%, 42% 40.5%, 46% 40.5%, 49% 41.5%, 52% 44.5%, 55% 49%, 58% 53%, 60% 54.7%, 63% 55%, 69% 54.2%, 76% 53%, 79% 52.5%, 82% 51.3%, 84% 49%, 86% 46%, 88% 44%, 91% 43%, 96% 42%, 100% 42%, 100% 100%, 0% 100%); }
  .folder-card-sage { z-index: 1; left: 10%; top: 6%; width: 70%; height: 70%; background-position: 100% 0; clip-path: inset(0 0 0 7%); }
  .folder-card-ivory { z-index: 2; left: 12%; top: 5%; width: 80%; height: 80%; background-position: 0 100%; }
  .folder-card-rose { z-index: 3; left: 30%; top: 15%; width: 74%; height: 74%; background-position: 100% 100%; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .tool-library { padding-bottom: clamp(3rem, 5vw, 4.5rem); }
  .tool-topics { display: flex; justify-content: center; flex-wrap: wrap; gap: .7rem; padding: 1.5rem 0; border-top: 1px solid #3d605529; }
  .tool-topics[hidden], .directory-item[hidden] { display: none; }
  .tool-topics button { --topic-surface: #e4e9df; --topic-border: #c2cdbb; --topic-ink: #3d6055; display: inline-flex; align-items: center; justify-content: center; gap: 1rem; min-height: 58px; padding: .75rem 1.35rem; border: 1px solid var(--topic-border); border-radius: 14px; background: var(--topic-surface); color: var(--topic-ink); font: 500 1rem/1.4 'Jost', system-ui, sans-serif; cursor: pointer; box-shadow: 0 3px 0 -1px var(--topic-border); transition: background 160ms ease, border-color 160ms ease, box-shadow 160ms ease; }
  .tool-topics button[data-tool-filter="all"] { --topic-surface: #fcfbf8; --topic-border: #ccc5bb; --topic-ink: #24211e; }
  .tool-topics button[data-tool-filter="money-investing"] { --topic-surface: #eadfce; --topic-border: #cfc0aa; --topic-ink: #675844; }
  .tool-topics button[data-tool-filter="ai-automation"] { --topic-surface: #e8d0cc; --topic-border: #c5a09b; --topic-ink: #785752; }
  .tool-topics button[aria-pressed="true"] { border-color: var(--topic-ink); box-shadow: 0 0 0 1px var(--topic-ink), 0 3px 0 -1px var(--topic-ink); }
  .tool-topics button[data-tool-filter="all"][aria-pressed="true"] { background: var(--brand-ink); color: #fff; }
  .tool-topics button:hover { border-color: var(--topic-ink); box-shadow: 0 3px 0 -1px var(--topic-ink); }
  .topic-count { display: grid; place-items: center; flex: none; min-width: 1.55rem; height: 1.55rem; border-radius: 50%; background: #ffffff8a; color: #42473e; font: 400 .72rem/1 'DM Mono', monospace; }
  .tool-topics button[aria-pressed="true"] .topic-count { background: var(--topic-ink); color: #fff; }
  .tool-topics button[data-tool-filter="all"][aria-pressed="true"] .topic-count { background: #ffffff24; }
  .library-status { text-align: center; padding: .6rem 0 1.4rem; color: #585a51; font-size: .875rem; }
  .directory-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; padding: 0; list-style: none; }
  .directory-item { display: flex; min-width: 0; }
  .directory-item > :global(*) { width: 100%; }
  .upcoming-card { --upcoming-surface: #e8d0cc; --upcoming-ink: #5d453e; --upcoming-body: #fcfbf8; display: flex; flex-direction: column; width: 100%; min-width: 0; overflow: hidden; border: 1px solid #d6bcb5; border-radius: 16px; background: var(--upcoming-body); }
  .upcoming-card[data-tone="sage"] { --upcoming-surface: #e4e9df; --upcoming-ink: #3d6055; border-color: #c2cdbb; }
  .upcoming-card[data-tone="sand"] { --upcoming-surface: #eadfce; --upcoming-ink: #675844; border-color: #d3c6b1; }
  .upcoming-card[data-filter-tone="sage"] { --upcoming-surface: #e4e9df; --upcoming-ink: #3d6055; --upcoming-body: #f0f3ec; border-color: #c2cdbb; }
  .upcoming-card[data-filter-tone="sand"] { --upcoming-surface: #eadfce; --upcoming-ink: #675844; --upcoming-body: #f6f0e6; border-color: #d3c6b1; }
  .upcoming-card[data-filter-tone="rose"] { --upcoming-surface: #eddbd6; --upcoming-ink: #785752; --upcoming-body: #f6eae7; border-color: #d6b8b2; }
  .upcoming-preview { position: relative; display: flex; flex-direction: column; justify-content: center; aspect-ratio: 1.85; padding: 1.5rem; overflow: hidden; background: var(--upcoming-surface); }
  .upcoming-preview > p { color: var(--upcoming-ink); font: 400 clamp(2.25rem, 3.5vw, 3.25rem)/.95 'Cormorant Garamond', Georgia, serif; letter-spacing: -.025em; }
  .upcoming-sparkle { position: absolute; right: 1.5rem; bottom: 1.25rem; color: var(--upcoming-ink); opacity: .6; font-size: 3.25rem; line-height: 1; }
  .upcoming-copy { padding: 1.5rem; }
  .upcoming-label { color: var(--upcoming-ink); font: 500 .61rem/1.5 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
  .upcoming-copy h3 { margin: .65rem 0 .9rem; font: italic 400 clamp(2.15rem, 2.7vw, 2.75rem)/1.05 'Cormorant Garamond', Georgia, serif; letter-spacing: -.025em; text-wrap: balance; }
  .upcoming-copy > p:last-child { color: #4a4a42; font-size: .9375rem; line-height: 1.7; text-wrap: pretty; }
  .source-section { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .3rem 1rem; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid #3d605529; }
  .source-section p { color: #585a51; font-size: .875rem; }
  .source-section a { display: inline-flex; color: #3d6055; text-decoration: none; }
  .tools-contact { padding: clamp(2.5rem, 5vw, 4rem) 0; background: var(--dusty-rose); }
  .contact-layout { display: flex; justify-content: space-between; align-items: center; gap: 2rem; }
  .tools-contact .eyebrow { color: #60433e; }
  .tools-contact h2 { max-width: 24ch; margin-top: .75rem; font: 400 clamp(2.1rem, 3.3vw, 3rem)/1.1 'Cormorant Garamond', Georgia, serif; letter-spacing: -.025em; text-wrap: balance; }
  .tools-contact p:last-child { max-width: 52ch; margin-top: .8rem; color: #493f3b; font-size: .9375rem; line-height: 1.7; }
  .tools-contact a { display: inline-flex; justify-content: center; flex: none; min-height: 52px; padding: .2rem 1.3rem; border: 1px solid #b38d89; border-radius: 8px; background: var(--cream); color: var(--brand-ink); text-decoration: none; }
  .tools-contact a :global(.action-label > span:first-child) { text-decoration: none; }
  .tools-contact a:hover { background: #fcfbf8; }
  .tools-page :is(a,button):focus-visible { outline: 3px solid #89534f; outline-offset: 4px; }
  @media (max-width: 1020px) {
    .hero-layout { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 1rem; }
    .hero-copy h1 { font-size: clamp(3.1rem, 7vw, 4.5rem); }
    .directory-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .contact-layout { align-items: start; }
    .tools-contact a { flex-shrink: 1; }
  }
  @media (max-width: 760px) {
    .tools-hero { padding-top: 6.75rem; }
    .hero-layout { grid-template-columns: 1fr; gap: 1.25rem; }
    .hero-copy h1 { font-size: clamp(2.65rem, 11.5vw, 3.5rem); }
    .hero-copy > p:last-child { font-size: 1rem; }
    .hero-art { justify-content: center; padding: 0 1.5rem 1.25rem 0; }
    .library-folder { width: clamp(10.5rem, 47vw, 14rem); }
    .tool-topics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; padding: 1.25rem 0; }
    .tool-topics button { gap: .55rem; min-height: 58px; padding: .7rem .6rem; font-size: .875rem; }
    .topic-count { min-width: 1.4rem; height: 1.4rem; font-size: .68rem; }
    .directory-grid { grid-template-columns: 1fr; }
    .upcoming-preview > p { font-size: clamp(2.5rem, 12vw, 3.5rem); }
    .contact-layout { display: block; }
    .tools-contact a { margin-top: 1.25rem; }
  }
  @media (max-width: 360px) {
    .tool-topics button { gap: .4rem; padding-inline: .45rem; font-size: .8rem; }
    .topic-count { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tool-topics button { transition: none; }
  }
</style>
